@page
@using CodeCollabFrontend.Models
@using Microsoft.EntityFrameworkCore
@{
    var userId = HttpContext.Session.GetInt32("UserId");
    if (userId == null)
    {
        Response.Redirect("/Login");
        return;
    }

    string old = Request.Query["old"];
    string newPwd = Request.Query["new"];

    if (string.IsNullOrEmpty(old) || string.IsNullOrEmpty(newPwd))
    {
        Response.Redirect("/Settings?error=missing");
        return;
    }

    var optionsBuilder = new DbContextOptionsBuilder<AppDbContext>();
    optionsBuilder.UseSqlite("Data Source=codecollab.db");
    using var context = new AppDbContext(optionsBuilder.Options);
    
    var user = context.Users.Find(userId);
    if (user == null)
    {
        Response.Redirect("/Login");
        return;
    }

    if (!BCrypt.Net.BCrypt.Verify(old, user.PasswordHash))
    {
        Response.Redirect("/Settings?error=wrong");
        return;
    }

    user.PasswordHash = BCrypt.Net.BCrypt.HashPassword(newPwd);
    context.SaveChanges();
    HttpContext.Session.Clear();
    Response.Redirect("/Login");
}

<!DOCTYPE html>
<html>
<head>
    <title>Смена пароля</title>
    <style>
        body {
            background: radial-gradient(circle at 30% 20%, #030c1a, #01060d);
            font-family: 'Inter', sans-serif;
            color: #fff;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            text-align: center;
        }
        .message {
            background: rgba(18, 22, 40, 0.6);
            backdrop-filter: blur(12px);
            border-radius: 32px;
            border: 1px solid rgba(0, 170, 255, 0.3);
            padding: 40px;
            width: 400px;
            box-shadow: 0 0 30px rgba(0,170,255,0.2);
        }
        input:-webkit-autofill,
        input:-webkit-autofill:focus,
        input:-webkit-autofill:hover {
            transition: background-color 5000s ease-in-out 0s;
            -webkit-text-fill-color: white !important;
            background-color: #0a0e1c !important;
        }
    </style>
</head>
<body>
    <div class="message">
        <h2>Смена пароля</h2>
        <p>Пожалуйста, подождите...</p>
    </div>
</body>
</html>