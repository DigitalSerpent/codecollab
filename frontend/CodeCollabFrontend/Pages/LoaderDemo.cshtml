@page
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <title>Загрузка — Неоновые волны</title>
    <style>
        body {
            margin: 0;
            overflow: hidden;
            background: #01060d;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            font-family: 'Inter', monospace;
        }
        canvas {
            display: block;
            width: 100%;
            height: 100%;
        }
        .info {
            position: absolute;
            bottom: 30px;
            left: 0;
            right: 0;
            text-align: center;
            color: #60a5fa;
            font-size: 0.7rem;
            letter-spacing: 3px;
            text-transform: uppercase;
            z-index: 10;
            pointer-events: none;
            text-shadow: 0 0 8px #3b82f6;
            font-weight: 300;
        }
    </style>
</head>
<body>
    <canvas id="waveCanvas"></canvas>
    <div class="info">INITIALIZING SYSTEM</div>

    <script>
        const canvas = document.getElementById('waveCanvas');
        const ctx = canvas.getContext('2d');
        
        let width, height;
        let time = 0;
        
        function resize() {
            width = canvas.width = window.innerWidth;
            height = canvas.height = window.innerHeight;
        }
        
        function draw() {
            requestAnimationFrame(draw);
            time += 0.016;
            
            ctx.clearRect(0, 0, width, height);
            
            // Глубокий тёмный фон
            const grad = ctx.createLinearGradient(0, 0, width, height);
            grad.addColorStop(0, '#01060d');
            grad.addColorStop(1, '#030c1a');
            ctx.fillStyle = grad;
            ctx.fillRect(0, 0, width, height);
            
            const centerX = width / 2;
            const centerY = height / 2;
            
            // Неоновые кольца
            for (let i = 0; i < 4; i++) {
                ctx.beginPath();
                ctx.ellipse(centerX, centerY, 120 + i * 35, 80 + i * 25, time * 0.3 * (i + 1), 0, Math.PI * 2);
                ctx.strokeStyle = `rgba(59, 130, 246, ${0.15 - i * 0.02})`;
                ctx.lineWidth = 1.5;
                ctx.stroke();
            }
            
            // Пульсирующий центр
            ctx.beginPath();
            ctx.arc(centerX, centerY, 25 + Math.sin(time * 4) * 6, 0, Math.PI * 2);
            ctx.fillStyle = `rgba(59, 130, 246, 0.35)`;
            ctx.fill();
            ctx.beginPath();
            ctx.arc(centerX, centerY, 12 + Math.sin(time * 5) * 3, 0, Math.PI * 2);
            ctx.fillStyle = `rgba(96, 165, 250, 0.9)`;
            ctx.fill();
            
            // Летающие частицы (без форм, просто точки)
            for (let i = 0; i < 80; i++) {
                const angle = time * 1.2 + i * 0.4;
                const radius = 140 + Math.sin(time * 1.5 + i) * 25;
                const x = centerX + Math.cos(angle) * radius;
                const y = centerY + Math.sin(angle * 0.8) * radius * 0.7;
                
                ctx.beginPath();
                ctx.arc(x, y, 1.5, 0, Math.PI * 2);
                ctx.fillStyle = `rgba(59, 130, 246, 0.8)`;
                ctx.fill();
            }
            
            // Минималистичный текст
            ctx.font = '300 12px "Inter", monospace';
            ctx.fillStyle = '#60a5fa';
            ctx.shadowBlur = 8;
            ctx.shadowColor = '#3b82f6';
            ctx.textAlign = 'center';
            
            let dots = '.'.repeat(Math.floor(time * 2.5) % 4);
            ctx.fillText(`LOADING${dots}`, centerX, centerY + 95);
            
            ctx.font = '200 10px "Inter", monospace';
            ctx.fillStyle = '#3b82f6';
            ctx.fillText(`v1.0.0`, centerX, centerY + 125);
            
            ctx.shadowBlur = 0;
        }
        
        window.addEventListener('resize', resize);
        resize();
        draw();
    </script>
</body>
</html>