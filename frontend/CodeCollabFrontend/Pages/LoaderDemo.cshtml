@page
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <title>Демо — Киберпанк-загрузка</title>
    <style>
        body { margin: 0; overflow: hidden; background: #01060d; font-family: 'Inter', sans-serif; }
        .info {
            position: absolute;
            bottom: 20px;
            left: 0;
            right: 0;
            text-align: center;
            color: rgba(255,255,255,0.6);
            font-size: 0.8rem;
            z-index: 10;
            pointer-events: none;
        }
    </style>
</head>
<body>
    <div class="info">
        ⚡ Летающий шар по траектории «восьмёрка» вокруг тора | Бесконечная анимация загрузки
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>

    <script>
        window.addEventListener('load', function() {
            const scene = new THREE.Scene();
            scene.background = new THREE.Color(0x01060d);
            scene.fog = new THREE.FogExp2(0x01060d, 0.02);

            // Фронтальная камера (смотрим прямо на центр)
            const camera = new THREE.PerspectiveCamera(45, window.innerWidth / window.innerHeight, 0.1, 1000);
            camera.position.set(0, 0, 8);
            camera.lookAt(0, 0, 0);

            const renderer = new THREE.WebGLRenderer({ antialias: true });
            renderer.setSize(window.innerWidth, window.innerHeight);
            renderer.setPixelRatio(window.devicePixelRatio);
            document.body.appendChild(renderer.domElement);

            // Единый светлый голубой цвет
            const mainColor = 0x60a5fa;
            const emissiveColor = 0x3b82f6;

            // Освещение (мягкое, чтобы не было глянца)
            const ambientLight = new THREE.AmbientLight(0x222244);
            scene.add(ambientLight);
            const frontLight = new THREE.PointLight(mainColor, 1);
            frontLight.position.set(0, 0, 5);
            scene.add(frontLight);
            const fillLight = new THREE.PointLight(mainColor, 0.5);
            fillLight.position.set(1, 1, 2);
            scene.add(fillLight);

            // Кольцо (матовая текстура, без глянца)
            const torusGeo = new THREE.TorusGeometry(1.4, 0.28, 128, 200);
            const torusMat = new THREE.MeshStandardMaterial({ 
                color: mainColor, 
                emissive: emissiveColor, 
                emissiveIntensity: 0.3, 
                metalness: 0.1, 
                roughness: 0.8,
                flatShading: false
            });
            const torus = new THREE.Mesh(torusGeo, torusMat);
            scene.add(torus);

            // Шар (такой же матовый цвет)
            const sphereGeo = new THREE.SphereGeometry(0.32, 64, 64);
            const sphereMat = new THREE.MeshStandardMaterial({ 
                color: mainColor, 
                emissive: mainColor, 
                emissiveIntensity: 0.4,
                metalness: 0.1,
                roughness: 0.8
            });
            const sphere = new THREE.Mesh(sphereGeo, sphereMat);
            scene.add(sphere);

            // Лёгкое свечение вокруг шара (полупрозрачное)
            const glowGeo = new THREE.SphereGeometry(0.45, 16, 16);
            const glowMat = new THREE.MeshBasicMaterial({ color: mainColor, transparent: true, opacity: 0.15 });
            const glow = new THREE.Mesh(glowGeo, glowMat);
            sphere.add(glow);

            // Звёзды
            const starCount = 1000;
            const starGeo = new THREE.BufferGeometry();
            const starPositions = new Float32Array(starCount * 3);
            for (let i = 0; i < starCount; i++) {
                starPositions[i*3] = (Math.random() - 0.5) * 200;
                starPositions[i*3+1] = (Math.random() - 0.5) * 100;
                starPositions[i*3+2] = (Math.random() - 0.5) * 80 - 40;
            }
            starGeo.setAttribute('position', new THREE.BufferAttribute(starPositions, 3));
            const starMat = new THREE.PointsMaterial({ color: 0x88aaff, size: 0.06, transparent: true, opacity: 0.4 });
            const stars = new THREE.Points(starGeo, starMat);
            scene.add(stars);

            let time = 0;

            function animate() {
                requestAnimationFrame(animate);
                time += 0.014;

                // Траектория восьмёрка в плоскости XY (фронтально)
                const radiusX = 1.9;
                const radiusY = 1.2;
                const figure8X = Math.sin(time) * radiusX;
                const figure8Y = Math.sin(time * 2) * radiusY;
                const figure8Z = Math.sin(time * 1.8) * 0.3;

                sphere.position.set(figure8X, figure8Y, figure8Z);

                // Медленное вращение кольца
                torus.rotation.z = time * 0.3;
                torus.rotation.x = Math.sin(time * 0.2) * 0.1;

                stars.rotation.y += 0.0002;
                stars.rotation.x += 0.0001;

                renderer.render(scene, camera);
            }

            animate();

            window.addEventListener('resize', function() {
                camera.aspect = window.innerWidth / window.innerHeight;
                camera.updateProjectionMatrix();
                renderer.setSize(window.innerWidth, window.innerHeight);
            });
        });
    </script>
</body>
</html>