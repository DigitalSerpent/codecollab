@page
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <title>Code Collab — Будущее совместной разработки</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; cursor: default; }
        
        body {
            background: radial-gradient(circle at 30% 20%, #030c1a, #01060d);
            font-family: 'Inter', sans-serif;
            color: #fff;
            overflow-x: hidden;
            position: relative;
        }
        
        .bubble {
            position: fixed;
            bottom: -50px;
            background: rgba(59, 130, 246, 0.15);
            border-radius: 50%;
            pointer-events: none;
            z-index: 0;
            animation: rise linear infinite;
            box-shadow: inset 0 0 10px rgba(59,130,246,0.2);
        }
        
        @@keyframes rise {
            0% { transform: translateY(0) scale(1); opacity: 0; }
            20% { opacity: 0.4; }
            80% { opacity: 0.3; }
            100% { transform: translateY(-100vh) scale(1.2); opacity: 0; }
        }
        
        #spline-container {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 1;
            pointer-events: none;
            filter: drop-shadow(0 0 15px #3b82f6);
        }
        
        .content {
            position: relative;
            z-index: 10;
            min-height: 200vh;
            background: transparent;
        }
        
        .hero {
            height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            backdrop-filter: blur(4px);
        }
        
        h1 {
            font-size: clamp(3rem,8vw,6rem);
            font-weight: 900;
            background: linear-gradient(135deg,#fff 0%,#3b82f6 50%,#a855f7 100%);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            margin-bottom: 1rem;
            text-shadow: 0 0 30px rgba(59,130,246,0.3);
        }
        
        .subtitle {
            font-size: 1.2rem;
            color: rgba(255,255,255,0.8);
            margin-bottom: 2rem;
        }
        
        .btn {
            display: inline-block;
            padding: 1rem 2.5rem;
            background: linear-gradient(90deg,#3b82f6,#2563eb);
            color: white;
            font-weight: bold;
            border-radius: 50px;
            text-decoration: none;
            transition: 0.3s;
            box-shadow: 0 0 20px rgba(59,130,246,0.5);
        }
        
        .btn:hover {
            transform: scale(1.05);
            box-shadow: 0 0 30px rgba(59,130,246,0.8);
        }
        
        .blocks {
            max-width: 1200px;
            margin: 0 auto;
            padding: 4rem 2rem;
        }
        
        .block {
            margin: 4rem auto;
            opacity: 0;
            transition: opacity 0.6s ease, transform 0.6s ease;
            max-width: 700px;
        }
        
        .block.visible {
            opacity: 1;
            transform: translateX(0);
        }
        
        .glass-card {
            background: rgba(10, 20, 35, 0.7);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(59, 130, 246, 0.4);
            border-radius: 32px;
            padding: 2.5rem;
            transition: 0.3s;
            width: 100%;
            box-shadow: 0 8px 20px rgba(0,0,0,0.3);
        }
        
        .glass-card:hover {
            border-color: #3b82f6;
            transform: translateY(-8px);
            box-shadow: 0 20px 40px rgba(0,0,0,0.4);
        }
        
        .glass-card h3 {
            font-size: 2rem;
            margin-bottom: 1rem;
            background: linear-gradient(135deg,#fff,#3b82f6);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
        }
        
        .block:nth-child(odd) { transform: translateX(-60px); }
        .block:nth-child(even) { transform: translateX(60px); }
        
        .plus-card {
            text-align: center;
            max-width: 800px;
            margin: 6rem auto;
            background: linear-gradient(135deg,rgba(59,130,246,0.2),rgba(168,85,247,0.2));
            border: 1px solid #fbbf24;
        }
        
        footer {
            text-align: center;
            padding: 2rem;
            color: rgba(255,255,255,0.4);
        }
        
        @@keyframes premiumGlow {
            0% { box-shadow: 0 0 30px rgba(255,255,255,0.1), 0 0 10px rgba(0,170,255,0.2); }
            100% { box-shadow: 0 0 60px rgba(255,255,255,0.3), 0 0 30px rgba(0,170,255,0.5); }
        }
    </style>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;900&display=swap" rel="stylesheet">
</head>
<body>

<div id="bubblesContainer"></div>

<iframe src="/spline-robot.html" id="spline-container" style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; border: none; z-index: 1; pointer-events: none;"></iframe>

<div class="content">
    <section class="hero">
        <h1>Code Collab</h1>
        <p class="subtitle">Совместная разработка кода в реальном времени</p>
        <a href="/Login" class="btn">Начать работу →</a>
    </section>

    <div class="blocks">
        <div class="block"><div class="glass-card"><h3>⚡ Real-time</h3><p>Мгновенная синхронизация кода между всеми участниками</p></div></div>
        <div class="block"><div class="glass-card"><h3>🐙 AI-помощник</h3><p>Умные подсказки и анализ кода на лету</p></div></div>
        <div class="block"><div class="glass-card"><h3>🔧 Терминал</h3><p>Запуск кода на 10+ языках прямо в браузере</p></div></div>
        <div class="block"><div class="glass-card"><h3>💬 Чат и стикеры</h3><p>Общение без переключения контекста</p></div></div>
    </div>

    <div class="plus-card glass-card" style="border: 1px solid rgba(255,255,255,0.8); background: rgba(255,255,255,0.05); backdrop-filter: blur(15px); box-shadow: 0 0 50px rgba(255,255,255,0.2), 0 0 20px rgba(0,170,255,0.3); animation: premiumGlow 3s infinite alternate;">
        <h3 style="color: #ffffff; font-size: 2.5rem; margin-bottom: 0.5rem; font-weight: 600; text-shadow: 0 0 20px rgba(255,255,255,0.5);">Coco Plus</h3>
        <p style="font-size: 1.2rem; color: #e0e0e0;">Эксклюзивные курсоры, стикеры и бейджи</p>
        <div style="margin-top: 1rem;">
            <span style="display: inline-block; background: rgba(255,255,255,0.15); padding: 5px 20px; border-radius: 50px; font-size: 0.9rem; border: 1px solid rgba(255,255,255,0.4); color: #fff;">Ранний доступ</span>
        </div>
    </div>

    <footer style="text-align: center; padding: 2rem; color: rgba(255,255,255,0.4); font-size: 0.8rem; border-top: 1px solid rgba(255,255,255,0.05); margin-top: 4rem;">
        <p>© 2026 Code Collab — Технологии будущего уже сегодня</p>
        
        <div style="display: flex; justify-content: center; align-items: center; gap: 2rem; margin: 1.5rem 0;">
            <a href="https://github.com" target="_blank" style="display: inline-block; opacity: 0.6; transition: 0.3s;">
                <img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/github/github-original.svg" alt="GitHub" style="width: 32px; height: 32px; filter: invert(1);">
            </a>
            <a href="https://www.docker.com" target="_blank" style="display: inline-block; opacity: 0.6; transition: 0.3s;">
                <img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/docker/docker-original.svg" alt="Docker" style="width: 32px; height: 32px;">
            </a>
            <a href="https://dotnet.microsoft.com" target="_blank" style="display: inline-block; opacity: 0.6; transition: 0.3s;">
                <img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/dotnetcore/dotnetcore-original.svg" alt=".NET" style="width: 32px; height: 32px;">
            </a>
        </div>

        <p style="margin-top: 0.5rem;">
            <a href="#" style="color: rgba(255,255,255,0.4); text-decoration: none; margin: 0 10px;">Telegram</a>
            <a href="#" style="color: rgba(255,255,255,0.4); text-decoration: none; margin: 0 10px;">GitHub</a>
            <a href="#" style="color: rgba(255,255,255,0.4); text-decoration: none; margin: 0 10px;">Поддержка</a>
        </p>
    </footer>
</div>

<script>
    // Анимация карточек
    const blocks = document.querySelectorAll('.block');
    const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                entry.target.classList.add('visible');
            }
        });
    }, { threshold: 0.2 });
    blocks.forEach(block => observer.observe(block));
    
    // Передача координат мыши в iframe
    const iframe = document.getElementById('spline-container');
    iframe.addEventListener('load', () => {
        const mouseListener = (e) => {
            iframe.contentWindow.postMessage({
                type: 'mousemove',
                x: e.clientX,
                y: e.clientY
            }, '*');
        };
        window.addEventListener('mousemove', mouseListener);
    });
    
    // Генерация пузырей
    function createBubble() {
        const bubble = document.createElement('div');
        bubble.classList.add('bubble');
        const size = Math.random() * 40 + 10;
        bubble.style.width = size + 'px';
        bubble.style.height = size + 'px';
        bubble.style.left = Math.random() * 100 + '%';
        bubble.style.animationDuration = Math.random() * 8 + 6 + 's';
        bubble.style.animationDelay = Math.random() * 5 + 's';
        document.getElementById('bubblesContainer').appendChild(bubble);
        setTimeout(() => bubble.remove(), 14000);
    }
    
    setInterval(createBubble, 800);
</script>

</body>
</html>