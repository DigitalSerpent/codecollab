@page
@{
    Layout = null;
}
@using CodeCollabFrontend.Models
@inject AppDbContext _context
@using Microsoft.AspNetCore.Http
@{
    ViewData["Title"] = "Профиль";

    var userId = HttpContext.Session.GetInt32("UserId");
    if (userId == null)
    {
        HttpContext.Response.Redirect("/Login");
        return;
    }

    var user = _context.Users.Find(userId);
    if (user == null)
    {
        HttpContext.Response.Redirect("/Login");
        return;
    }
}

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <title>Профиль | Code Collab</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { background: linear-gradient(135deg, #0a0e1c 0%, #121628 100%); font-family: 'Segoe UI', 'Inter', Tahoma, Geneva, Verdana, sans-serif; min-height: 100vh; position: relative; }
        .sphere { position: fixed; width: 80px; height: 80px; background: radial-gradient(circle, rgba(0,170,255,0.1), transparent); border-radius: 50%; pointer-events: none; animation: floatSphere 20s infinite ease-in-out; z-index: 0; }
        @@keyframes floatSphere { 0% { transform: translateY(100vh) translateX(0); opacity: 0; } 20% { opacity: 0.5; } 80% { opacity: 0.5; } 100% { transform: translateY(-20vh) translateX(50px); opacity: 0; } }
        .profile-container { position: relative; z-index: 1; max-width: 1400px; margin: 0 auto; padding: 40px; }
        .profile-card { background: rgba(10, 14, 28, 0.6); backdrop-filter: blur(12px); border-radius: 32px; border: 1px solid rgba(0, 170, 255, 0.4); box-shadow: 0 0 50px rgba(0, 170, 255, 0.2); overflow: hidden; }
        .cover { height: 200px; background: linear-gradient(45deg, #00aaff20, #00aaff05); position: relative; cursor: pointer; }
        .cover-hint { position: absolute; bottom: 10px; right: 20px; color: white; font-size: 12px; background: rgba(0,0,0,0.5); padding: 4px 8px; border-radius: 20px; }
        .avatar-wrapper { position: relative; margin-top: -70px; text-align: center; }
        .avatar { width: 140px; height: 140px; background: #121628; border-radius: 50%; border: 3px solid #00aaff; box-shadow: 0 0 20px #00aaff; display: inline-flex; align-items: center; justify-content: center; font-size: 4.5rem; cursor: pointer; transition: 0.2s; }
        .info { text-align: center; padding: 20px 30px 10px; }
        .name { font-size: 32px; font-weight: bold; color: white; margin-bottom: 8px; }
        .name input { background: none; border: none; color: white; font-size: 32px; text-align: center; width: 100%; }
        .email { color: #a0a0a0; font-size: 14px; margin-bottom: 10px; }
        .section { padding: 20px 30px; border-top: 1px solid rgba(0, 170, 255, 0.2); }
        .section-title { color: #00aaff; font-size: 18px; margin-bottom: 15px; display: flex; align-items: center; gap: 10px; }
        .social-list { display: flex; flex-direction: column; gap: 10px; }
        .social-row { display: flex; align-items: center; gap: 10px; }
        .social-row input { flex: 1; padding: 10px; background: rgba(10, 14, 28, 0.8); border: 1px solid #2a2a4a; border-radius: 12px; color: white; }
        .social-row button { background: none; border: none; color: #ff4444; cursor: pointer; font-size: 14px; }
        .add-social { background: rgba(0, 170, 255, 0.2); border: 1px dashed #00aaff; border-radius: 12px; padding: 10px; text-align: center; cursor: pointer; color: #00aaff; margin-top: 10px; }
        .actions { display: flex; gap: 15px; padding: 20px 30px; }
        .btn { flex: 1; padding: 12px; border-radius: 12px; border: none; font-weight: bold; cursor: pointer; transition: 0.3s; text-align: center; }
        .btn-primary { background: #00aaff; color: #0a0e1c; }
        .btn-primary:hover { background: white; box-shadow: 0 0 20px #00aaff; }
        .btn-secondary { background: #1e1e3a; color: white; }
        .modal { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.8); z-index: 1000; align-items: center; justify-content: center; }
        .modal-content { background: #121628; border-radius: 24px; padding: 30px; width: 90%; max-width: 900px; border: 1px solid #00aaff; box-shadow: 0 0 30px #00aaff; }
        .footer { text-align: center; padding: 20px; color: #a0a0a0; font-size: 12px; border-top: 1px solid rgba(0,170,255,0.2); }
        .cursor-workspace { display: flex; gap: 40px; flex-wrap: wrap; justify-content: center; }
        .preview-area { flex: 1; min-width: 260px; text-align: center; }
        .preview-box { background: #0a0e1c; border-radius: 24px; width: 260px; height: 260px; display: flex; align-items: center; justify-content: center; border: 1px solid #00aaff; margin: 0 auto; box-shadow: 0 0 20px rgba(0,170,255,0.2); }
        .controls-area { margin-top: 20px; display: flex; flex-direction: column; gap: 15px; }
        .size-control, .color-control { display: flex; align-items: center; gap: 15px; }
        .size-control input, .color-control input { flex: 1; }
        .color-control input { width: 50px; height: 40px; border: 1px solid #00aaff; border-radius: 8px; background: #0a0e1c; }
        .lock-icon { color: #ffaa00; cursor: pointer; font-size: 20px; }
        .premium-message { color: #ffaa00; font-size: 12px; margin-top: 5px; display: none; }
        .cursors-grid { flex: 2; display: grid; grid-template-columns: repeat(4, 1fr); gap: 15px; max-width: 400px; margin: 0 auto; }
        .cursor-option { background: #1a1e30; border: 1px solid #2a2a4a; border-radius: 16px; padding: 10px; text-align: center; cursor: pointer; transition: 0.2s; aspect-ratio: 1 / 1; display: flex; align-items: center; justify-content: center; }
        .cursor-option:hover, .cursor-option.selected { border-color: #00aaff; box-shadow: 0 0 15px #00aaff; transform: scale(1.05); }
        .cursor-option img { width: 48px; height: 48px; object-fit: contain; }
    </style>
</head>
<body>

<div id="spheresContainer"></div>

<div class="profile-container">
    <div class="profile-card">
        <div class="cover" onclick="changeCover()">
            <div class="cover-hint">Нажми, чтобы изменить фон</div>
        </div>

        <div class="avatar-wrapper">
            <div class="avatar" onclick="changeAvatar()">@user.Avatar</div>
        </div>

        <div class="info">
            <div class="name">
                <input type="text" id="userName" value="@user.Name">
            </div>
            <div class="email">@user.Email</div>
        </div>

        <div class="section">
            <div class="section-title">
                <span>🌐</span> Социальные сети
            </div>
            <div id="socialList" class="social-list"></div>
            <div class="add-social" onclick="addSocialField()">
                + Добавить соцсеть
            </div>
        </div>

        <div class="section">
            <button class="btn btn-primary" onclick="openCursorModal()">Конструктор курсора</button>
        </div>

        <div class="actions">
            <button class="btn btn-secondary" onclick="window.location.href='/Dashboard'">Назад</button>
        </div>

        <div class="footer">
            📅 Дата регистрации: 01.03.2026
        </div>
    </div>
</div>

<div id="cursorModal" class="modal">
    <div class="modal-content">
        <h3 style="color: white; margin-bottom: 20px; text-align: center;">Конструктор курсора</h3>
        
        <div class="cursor-workspace">
            <div class="preview-area">
                <div class="preview-box">
                    <div id="cursorPreview"></div>
                </div>
                <div class="controls-area">
                    <div class="size-control">
                        <span style="color: white;">Размер</span>
                        <input type="range" id="cursorSize" min="16" max="48" value="32" step="2">
                        <i class="fas fa-lock lock-icon" id="lockIcon" onclick="togglePremium()"></i>
                    </div>
                    <div class="color-control">
                        <span style="color: white;">Цвет</span>
                        <input type="color" id="cursorColor" value="#00aaff">
                    </div>
                    <div id="premiumMessage" class="premium-message">Гигантский курсор — доступен в Coco Plus</div>
                </div>
            </div>

            <div class="cursors-grid" id="cursorGrid"></div>
        </div>

        <div style="display: flex; justify-content: space-between; gap: 15px; margin-top: 30px;">
            <button class="btn btn-primary" onclick="applyCursor()">Применить</button>
            <button class="btn btn-secondary" onclick="closeCursorModal()">Отмена</button>
        </div>
    </div>
</div>

<script>
    let socialFields = [];

    function renderSocials() {
        const container = document.getElementById('socialList');
        container.innerHTML = '';
        socialFields.forEach((field, index) => {
            const row = document.createElement('div');
            row.className = 'social-row';
            row.innerHTML = `
                <input type="text" placeholder="Название" value="${field.name || ''}" data-index="${index}" data-type="name">
                <input type="text" placeholder="Ссылка" value="${field.url || ''}" data-index="${index}" data-type="url">
                <button onclick="removeSocialField(${index})"><i class="fas fa-times"></i></button>
            `;
            container.appendChild(row);
        });
        document.querySelectorAll('.social-row input').forEach(inp => {
            inp.addEventListener('change', (e) => {
                const idx = e.target.getAttribute('data-index');
                const type = e.target.getAttribute('data-type');
                if (type === 'name') socialFields[idx].name = e.target.value;
                else socialFields[idx].url = e.target.value;
            });
        });
    }

    function addSocialField() {
        socialFields.push({ name: '', url: '' });
        renderSocials();
    }

    function removeSocialField(index) {
        socialFields.splice(index, 1);
        renderSocials();
    }

    function loadSocials() {
        fetch('/Profile/GetSocials')
            .then(res => res.json())
            .then(data => {
                if (data.socials) socialFields = data.socials;
                renderSocials();
            })
            .catch(() => {});
    }

    const cursorFiles = [
        "default",
        "handopen",
        "handpointing",
        "resizenorth",
        "resizenorthwest",
        "textcursor"
    ];

    let allCursors = cursorFiles.map(f => ({ type: 'svg', name: f }));

    let selectedCursor = allCursors[0];
    let premiumCursor = false;

    function updateColorControlVisibility() {
        const colorControl = document.querySelector('.color-control');
        if (!colorControl) return;
        if (selectedCursor.type === 'svg') {
            colorControl.style.opacity = '0.5';
            colorControl.style.pointerEvents = 'none';
            let hint = document.getElementById('colorHint');
            if (!hint) {
                hint = document.createElement('div');
                hint.id = 'colorHint';
                hint.style.color = '#00aaff';
                hint.style.fontSize = '12px';
                hint.style.marginTop = '5px';
                hint.innerText = '⚠️ Для этого курсора цвет не меняется';
                colorControl.parentNode.appendChild(hint);
            }
        } else {
            colorControl.style.opacity = '1';
            colorControl.style.pointerEvents = 'auto';
            const hint = document.getElementById('colorHint');
            if (hint) hint.remove();
        }
    }

    function updateCursorPreview() {
        const previewContainer = document.getElementById('cursorPreview');
        const size = document.getElementById('cursorSize').value;
        const color = document.getElementById('cursorColor').value;
        
        if (!previewContainer) return;
        previewContainer.innerHTML = '';
        
        if (selectedCursor.type === 'svg') {
            const img = document.createElement('img');
            img.src = `/cursors/${selectedCursor.name}.svg`;
            img.style.width = size + 'px';
            img.style.height = size + 'px';
            img.style.objectFit = 'contain';
            img.onerror = () => { img.src = '/cursors/default.svg'; };
            previewContainer.appendChild(img);
        }
        updateColorControlVisibility();
    }

    function renderCursors() {
        const grid = document.getElementById('cursorGrid');
        if (!grid) return;
        grid.innerHTML = '';
        allCursors.forEach(cursor => {
            const option = document.createElement('div');
            option.className = 'cursor-option';
            
            const isSelected = (cursor.type === selectedCursor.type && cursor.name === selectedCursor.name);
            if (isSelected) option.classList.add('selected');
            
            if (cursor.type === 'svg') {
                const imgSrc = `/cursors/${cursor.name}.svg`;
                option.innerHTML = `<img src="${imgSrc}" alt="${cursor.name}" style="width: 40px; height: 40px;" onerror="this.parentElement.innerText='${cursor.name}'">`;
            }
            
            option.onclick = () => {
                document.querySelectorAll('.cursor-option').forEach(c => c.classList.remove('selected'));
                option.classList.add('selected');
                selectedCursor = cursor;
                updateCursorPreview();
            };
            grid.appendChild(option);
        });
        updateCursorPreview();
    }

    function togglePremium() {
        premiumCursor = !premiumCursor;
        const lockIcon = document.getElementById('lockIcon');
        const sizeSlider = document.getElementById('cursorSize');
        const message = document.getElementById('premiumMessage');
        if (premiumCursor) {
            lockIcon.className = 'fas fa-unlock-alt lock-icon';
            sizeSlider.max = 200;
            message.style.display = 'block';
        } else {
            lockIcon.className = 'fas fa-lock lock-icon';
            sizeSlider.max = 48;
            message.style.display = 'none';
            if (sizeSlider.value > 48) sizeSlider.value = 48;
        }
        updateCursorPreview();
    }

    function openCursorModal() {
        renderCursors();
        updateColorControlVisibility();
        document.getElementById('cursorModal').style.display = 'flex';
    }

    function closeCursorModal() {
        document.getElementById('cursorModal').style.display = 'none';
    }

    function applyCursor() {
        const size = document.getElementById('cursorSize').value;
        const cursorData = `svg:${selectedCursor.name} ${size} ${premiumCursor ? 'premium' : 'normal'}`;
        
        // Сохраняем в localStorage
        localStorage.setItem('globalCursor', cursorData);
        
        // Применяем курсор на текущей странице
        const hotspot = { x: 16, y: 4 };
        let style = document.getElementById('tempCursorStyle');
        if (style) style.remove();
        const newStyle = document.createElement('style');
        newStyle.id = 'tempCursorStyle';
        newStyle.textContent = `* { cursor: url('/cursors/${selectedCursor.name}.svg') ${hotspot.x} ${hotspot.y}, auto !important; }`;
        document.head.appendChild(newStyle);
        
        alert('Курсор применён!');
        closeCursorModal();
    }

    function changeAvatar() {
        const newAvatar = prompt('Введите новый аватар (эмодзи):', document.querySelector('.avatar').innerText);
        if (newAvatar && newAvatar.length <= 2) {
            document.querySelector('.avatar').innerText = newAvatar;
        }
    }

    function changeCover() {
        alert('Здесь будет выбор фона шапки (скоро)');
    }

    function createSpheres() {
        const container = document.getElementById('spheresContainer');
        for (let i = 0; i < 15; i++) {
            const sphere = document.createElement('div');
            sphere.className = 'sphere';
            sphere.style.left = Math.random() * 100 + '%';
            sphere.style.width = sphere.style.height = (40 + Math.random() * 60) + 'px';
            sphere.style.animationDelay = Math.random() * 20 + 's';
            sphere.style.animationDuration = 15 + Math.random() * 15 + 's';
            container.appendChild(sphere);
        }
    }

    document.getElementById('cursorSize').addEventListener('input', () => updateCursorPreview());
    document.getElementById('cursorColor').addEventListener('input', () => updateCursorPreview());

    loadSocials();
    createSpheres();
    document.getElementById('cursorSize').value = 32;
    document.getElementById('cursorColor').value = '#00aaff';
</script>

</body>
</html>