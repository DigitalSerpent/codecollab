@page
@model SetPasswordModel
@{
    Layout = null;
}
<style>
    body {
        margin: 0;
        padding: 0;
        background: linear-gradient(135deg, #0a0e1c 0%, #121628 100%);
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .card {
        background: rgba(30, 35, 55, 0.8);
        backdrop-filter: blur(12px);
        border-radius: 32px;
        padding: 40px;
        width: 100%;
        max-width: 420px;
        text-align: center;
        border: 1px solid rgba(0, 170, 255, 0.3);
        box-shadow: 0 0 40px rgba(0, 170, 255, 0.2);
    }
    input {
        width: 100%;
        padding: 14px;
        background: rgba(10, 14, 28, 0.8);
        border: 1px solid #2a2a4a;
        border-radius: 16px;
        color: white;
        font-size: 16px;
        margin-bottom: 20px;
        box-sizing: border-box;
    }
    input:focus {
        outline: none;
        border-color: #00aaff;
        box-shadow: 0 0 12px #00aaff;
    }
    button {
        width: 100%;
        padding: 14px;
        background: #00aaff;
        border: none;
        border-radius: 16px;
        font-size: 16px;
        font-weight: bold;
        color: #0a0e1c;
        cursor: pointer;
    }
    .error {
        background: rgba(255, 68, 68, 0.9);
        padding: 12px;
        border-radius: 12px;
        margin-bottom: 20px;
        color: white;
    }
</style>
<div class="card">
    <h2>Придумайте пароль</h2>
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="error">@Model.ErrorMessage</div>
    }
    <form method="post">
        <input type="password" name="password" placeholder="Пароль" required>
        <input type="password" name="confirmPassword" placeholder="Подтвердите пароль" required>
        <button type="submit">Сохранить</button>
    </form>
</div>