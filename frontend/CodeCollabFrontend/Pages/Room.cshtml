@page "/room/{id}"
@using Microsoft.EntityFrameworkCore
@using CodeCollabFrontend.Models
@inject AppDbContext _context
@using Microsoft.AspNetCore.Http

@{
    #nullable disable
    if (!int.TryParse((string)RouteData.Values["id"], out int roomId))
    {
        <h2 style="color: white;">Неверный ID комнаты</h2>
        return;
    }

    var room = _context.Rooms
        .Include(r => r.RoomParticipants)
            .ThenInclude(rp => rp.User)
        .FirstOrDefault(r => r.Id == roomId);
    
    var userId = HttpContext.Session.GetInt32("UserId");
    var currentUser = userId != null ? _context.Users.Find(userId) : null;
}

@if (room == null)
{
    <h2 style="color: white;">Комната не найдена</h2>
}
else
{
    Layout = null;
    
    <!DOCTYPE html>
    <html>
    <head>
        <meta charset="utf-8">
        <title>@room.Name — Code Collab</title>
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
        <style>
            * { margin: 0; padding: 0; box-sizing: border-box; }
            body { background: #0a0e1c; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; height: 100vh; display: flex; flex-direction: column; overflow: hidden; }
            
            /* Хедер (один) */
            .header { background: #05070f; padding: 10px 30px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid #00aaff; flex-shrink: 0; }
            .logo { font-size: 1.8rem; font-weight: bold; color: white; }
            .user { display: flex; align-items: center; gap: 15px; color: white; }
            .avatar { width: 40px; height: 40px; border-radius: 50%; background: #00aaff; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; }
            
            /* Основной контейнер */
            .workspace { flex: 1; display: flex; padding: 12px; gap: 12px; overflow: hidden; min-height: 0; }
            
            /* Левая панель — файлы */
            .files { width: 200px; background: #0d0d1a; border: 1px solid #00aaff; border-radius: 12px; display: flex; flex-direction: column; overflow: hidden; flex-shrink: 0; }
            .panel-title { padding: 10px 12px; background: #121628; border-bottom: 1px solid #00aaff; font-weight: bold; color: white; }
            .file-list { flex: 1; overflow-y: auto; padding: 8px; }
            .file-item { padding: 6px 10px; cursor: pointer; border-radius: 6px; margin-bottom: 4px; color: #ccc; display: flex; align-items: center; gap: 8px; font-size: 13px; }
            .file-item:hover { background: #1e1e3a; color: white; }
            .file-item.active { background: #0d3d5c; color: white; }
            .new-file-btn { margin: 8px; padding: 8px; background: #00aaff; border: none; border-radius: 6px; cursor: pointer; font-weight: bold; }
            
            /* Центр */
            .center { flex: 1; display: flex; flex-direction: column; background: #0d0d1a; border: 1px solid #00aaff; border-radius: 12px; overflow: hidden; min-width: 0; }
            .invite-bar { background: #0a0e1c; padding: 6px 12px; margin: 8px 12px 0 12px; border-radius: 8px; display: flex; gap: 8px; }
            .invite-input { flex: 1; background: #121628; border: 1px solid #1e1e3a; color: white; border-radius: 6px; padding: 6px; font-size: 11px; }
            .copy-btn { background: #00aaff; border: none; border-radius: 6px; padding: 6px 12px; cursor: pointer; }
            .tabs { display: flex; background: #121628; border-bottom: 1px solid #00aaff; overflow-x: auto; padding: 0 8px; gap: 4px; }
            .tab { padding: 8px 14px; background: #0d0d1a; color: #ccc; cursor: pointer; font-size: 12px; display: flex; align-items: center; gap: 8px; white-space: nowrap; }
            .tab.active { background: #1e1e3a; color: white; border-bottom: 2px solid #00aaff; }
            .tab-close { margin-left: 8px; opacity: 0.6; cursor: pointer; }
            .toolbar { display: flex; justify-content: space-between; padding: 6px 12px; background: #121628; border-bottom: 1px solid #00aaff; }
            .lang-select { background: #0d0d1a; color: white; border: 1px solid #00aaff; border-radius: 6px; padding: 4px 10px; font-size: 12px; }
            .run-btn { background: #00aaff; border: none; border-radius: 6px; padding: 4px 16px; cursor: pointer; font-weight: bold; }
            .editor { flex: 1; min-height: 0; }
            .terminal { height: 130px; background: #1e1e1e; border-top: 1px solid #00aaff; display: flex; flex-direction: column; flex-shrink: 0; }
            .terminal-header { padding: 4px 12px; background: #2d2d2d; color: white; font-size: 11px; display: flex; justify-content: space-between; }
            .terminal-output { flex: 1; overflow-y: auto; padding: 6px; color: #ccc; font-family: monospace; font-size: 11px; white-space: pre-wrap; }
            .terminal-line { display: flex; padding: 4px 10px; background: #1e1e1e; border-top: 1px solid #3c3c3c; }
            .terminal-prompt { color: #00aaff; margin-right: 8px; }
            .terminal-input { flex: 1; background: none; border: none; color: #ccc; outline: none; font-family: monospace; }
            
            /* Правая панель — чат */
            .chat { width: 260px; background: #0d0d1a; border: 1px solid #00aaff; border-radius: 12px; display: flex; flex-direction: column; overflow: hidden; flex-shrink: 0; }
            .chat-messages { flex: 1; overflow-y: auto; padding: 10px; display: flex; flex-direction: column; gap: 8px; }
            .message { max-width: 85%; padding: 6px 12px; border-radius: 12px; font-size: 12px; }
            .message-mine { background: #b198b3; color: #0a0e1c; align-self: flex-end; }
            .message-other { background: #86a1b5; color: white; align-self: flex-start; }
            .chat-input-area { display: flex; padding: 10px; gap: 8px; border-top: 1px solid #00aaff; }
            .chat-input { flex: 1; padding: 8px; background: #0a0e1c; border: 1px solid #1e1e3a; color: white; border-radius: 8px; }
            .chat-send { padding: 8px 14px; background: #00aaff; border: none; border-radius: 8px; cursor: pointer; }
            
            /* Нижние иконки */
            .bottom { position: fixed; bottom: 20px; left: 50%; transform: translateX(-50%); display: flex; gap: 15px; z-index: 100; }
            .bottom-btn { width: 48px; height: 48px; background: #121628; border: 1px solid #00aaff; border-radius: 12px; display: flex; align-items: center; justify-content: center; cursor: pointer; color: #a0a0a0; font-size: 20px; }
            .bottom-btn:hover { background: #1e1e3a; color: #00aaff; }
            
            .floating { display: none; position: fixed; bottom: 80px; left: 20px; width: 260px; background: #121628; border: 1px solid #00aaff; border-radius: 12px; padding: 12px; z-index: 200; max-height: 350px; overflow-y: auto; }
            .floating-title { color: white; margin-bottom: 12px; display: flex; justify-content: space-between; font-weight: bold; }
            .participant { display: flex; align-items: center; gap: 10px; padding: 8px; cursor: pointer; border-radius: 8px; margin-bottom: 5px; }
            .participant:hover { background: #1e1e3a; }
            .participant-avatar { width: 32px; height: 32px; border-radius: 50%; background: #1e1e3a; display: flex; align-items: center; justify-content: center; font-size: 18px; }
            .participant-name { flex: 1; color: white; font-size: 13px; }
            .participant-status { width: 8px; height: 8px; border-radius: 50%; }
            
            .modal { display: none; position: fixed; top:0; left:0; right:0; bottom:0; background: rgba(0,0,0,0.9); z-index: 1000; align-items: center; justify-content: center; }
            .modal-card { background: #121628; border-radius: 16px; padding: 24px; width: 320px; border: 1px solid #00aaff; text-align: center; }
            .modal-buttons { display: flex; gap: 12px; margin-top: 20px; }
            .modal-btn { flex:1; padding: 10px; border: none; border-radius: 8px; cursor: pointer; }
            .modal-cancel { background: #1e1e3a; color: white; }
            .modal-confirm { background: #00aaff; color: #0a0e1c; }
            
            .toast { position: fixed; top: 20px; right: 20px; padding: 10px 18px; border-radius: 8px; z-index: 10000; }
        </style>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/monaco-editor/0.34.1/min/vs/loader.js"></script>
    </head>
    <body>
        <!-- Хедер (один) -->
        <div class="header">
            <div class="logo">Code Collab</div>
            <div class="user">
                <span>@(currentUser?.Name ?? "Гость")</span>
                <div class="avatar">@(currentUser?.Avatar ?? "👤")</div>
            </div>
        </div>
        
        <div class="workspace">
            <!-- ФАЙЛЫ -->
            <div class="files">
                <div class="panel-title"><i class="fas fa-folder"></i> Файлы</div>
                <div id="fileTree" class="file-list"></div>
                <button class="new-file-btn" onclick="createNewFile()">+ Новый файл</button>
            </div>
            
            <!-- ЦЕНТР -->
            <div class="center">
                @if (userId == room.OwnerId)
                {
                    <div class="invite-bar">
                        <input id="inviteLink" type="text" readonly value="@($"{Request.Scheme}://{Request.Host}/room/join/{room.InviteToken}")" class="invite-input">
                        <button class="copy-btn" onclick="copyInvite()">Копировать</button>
                    </div>
                }
                <div id="tabsBar" class="tabs"></div>
                <div class="toolbar">
                    <select id="langSelect" class="lang-select">
                        <option value="python">Python</option>
                        <option value="javascript">JavaScript</option>
                        <option value="bash">Bash</option>
                    </select>
                    <button class="run-btn" onclick="runCode()">Запустить</button>
                </div>
                <div id="editor" class="editor"></div>
                <div class="terminal">
                    <div class="terminal-header">
                        <span><i class="fas fa-terminal"></i> Терминал</span>
                        <button onclick="toggleTerminal()" style="background:none; border:none; color:#ccc; cursor:pointer;">▼</button>
                    </div>
                    <div id="terminalOut" class="terminal-output">$ Готов к работе\n</div>
                    <div class="terminal-line">
                        <span class="terminal-prompt">$</span>
                        <input type="text" id="terminalInput" class="terminal-input" placeholder="команда...">
                    </div>
                </div>
            </div>
            
            <!-- ЧАТ -->
            <div class="chat">
                <div class="panel-title"><i class="fas fa-comments"></i> Чат</div>
                <div id="chatMessages" class="chat-messages"></div>
                <div class="chat-input-area">
                    <input type="text" id="chatInput" class="chat-input" placeholder="Сообщение...">
                    <button class="chat-send" onclick="sendChatMessage()"><i class="fas fa-paper-plane"></i></button>
                </div>
            </div>
        </div>
        
        <!-- НИЖНИЕ ИКОНКИ -->
        <div class="bottom">
            <div class="bottom-btn" onclick="toggleUsers()"><i class="fas fa-users"></i></div>
            <div class="bottom-btn" onclick="openExitModal()"><i class="fas fa-sign-out-alt"></i></div>
        </div>
        
        <!-- ПАНЕЛЬ УЧАСТНИКОВ -->
        <div id="usersPanel" class="floating">
            <div class="floating-title">Участники <span onclick="closeUsers()" style="cursor:pointer;">✖</span></div>
            <div id="usersList"></div>
        </div>
        
        <div id="exitModal" class="modal">
            <div class="modal-card">
                <h3 style="color:white;">Выйти из комнаты?</h3>
                <div class="modal-buttons">
                    <button class="modal-btn modal-cancel" onclick="closeExitModal()">Отмена</button>
                    <button class="modal-btn modal-confirm" onclick="exitRoom()">Выйти</button>
                </div>
            </div>
        </div>

        <script>
            const roomId = @roomId;
            const userId = @(userId ?? 0);
            const userName = "@(currentUser?.Name ?? "Гость")";
            const userAvatar = "@(currentUser?.Avatar ?? "👤")";
            const userCursor = "@(currentUser?.Cursor ?? "⬤")";
            
            let editor = null;
            let currentFileId = null;
            let openTabs = [];
            let saveTimer = null;
            let ws = null;
            
            function showToast(msg, isErr = false) {
                const toast = document.createElement('div');
                toast.className = 'toast';
                toast.style.background = isErr ? '#c62828' : '#2e7d32';
                toast.style.color = 'white';
                toast.innerText = msg;
                document.body.appendChild(toast);
                setTimeout(() => toast.remove(), 3000);
            }
            
            function copyInvite() {
                const inp = document.getElementById('inviteLink');
                if (inp) { inp.select(); document.execCommand('copy'); showToast('Ссылка скопирована'); }
            }
            
            function getIcon(name) {
                const e = name.split('.').pop();
                const icons = { py:'<i class="fab fa-python"></i>', js:'<i class="fab fa-js"></i>', html:'<i class="fab fa-html5"></i>', css:'<i class="fab fa-css3-alt"></i>', md:'<i class="fas fa-markdown"></i>' };
                return icons[e] || '<i class="fas fa-file-code"></i>';
            }
            
            function getLang(name) {
                const e = name.split('.').pop();
                const map = { py:'python', js:'javascript', html:'html', css:'css', md:'markdown', txt:'text', sh:'bash' };
                return map[e] || 'text';
            }
            
            async function loadFiles() {
                try {
                    const res = await fetch(`/api/room/${roomId}/file`);
                    const files = await res.json();
                    const container = document.getElementById('fileTree');
                    container.innerHTML = '';
                    for (const f of files) {
                        const div = document.createElement('div');
                        div.className = 'file-item' + (currentFileId === f.id ? ' active' : '');
                        div.innerHTML = `${getIcon(f.name)} <span style="flex:1;">${escapeHtml(f.name)}</span>`;
                        div.onclick = () => openFile(f.id, f.name);
                        container.appendChild(div);
                    }
                } catch(e) {}
            }
            
            async function openFile(id, name) {
                try {
                    const res = await fetch(`/api/room/${roomId}/file/${id}`);
                    const file = await res.json();
                    if (!openTabs.some(t => t.id === id)) openTabs.push({ id, name });
                    currentFileId = id;
                    renderTabs();
                    loadFiles();
                    if (editor) {
                        editor.setValue(file.content || '');
                        monaco.editor.setModelLanguage(editor.getModel(), getLang(name));
                    }
                } catch(e) { showToast('Ошибка открытия', true); }
            }
            
            function renderTabs() {
                const container = document.getElementById('tabsBar');
                container.innerHTML = '';
                for (const t of openTabs) {
                    const tab = document.createElement('div');
                    tab.className = `tab ${currentFileId === t.id ? 'active' : ''}`;
                    tab.innerHTML = `${getIcon(t.name)} ${escapeHtml(t.name)} <span class="tab-close" onclick="event.stopPropagation(); closeTab(${t.id})">✖</span>`;
                    tab.onclick = () => openFile(t.id, t.name);
                    container.appendChild(tab);
                }
            }
            
            async function closeTab(id) {
                const idx = openTabs.findIndex(t => t.id === id);
                if (idx === -1) return;
                openTabs.splice(idx, 1);
                if (currentFileId === id) {
                    if (openTabs.length) await openFile(openTabs[0].id, openTabs[0].name);
                    else { currentFileId = null; if(editor) editor.setValue(''); loadFiles(); }
                }
                renderTabs();
            }
            
            async function saveFile() {
                if (!currentFileId || !editor) return;
                try {
                    await fetch(`/api/room/${roomId}/file/${currentFileId}`, {
                        method: 'PUT',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ Content: editor.getValue() })
                    });
                } catch(e) {}
            }
            
            async function createNewFile() {
                let name = prompt('Имя файла:', 'newfile.txt');
                if (!name) return;
                if (!name.includes('.')) name += '.txt';
                try {
                    const res = await fetch(`/api/room/${roomId}/file`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ name })
                    });
                    if (res.ok) {
                        const file = await res.json();
                        await loadFiles();
                        await openFile(file.id, file.name);
                    }
                } catch(e) { showToast('Ошибка создания', true); }
            }
            
            async function loadChat() {
                try {
                    const res = await fetch(`/api/chat/${roomId}`);
                    const msgs = await res.json();
                    const container = document.getElementById('chatMessages');
                    container.innerHTML = '';
                    for (const m of msgs) {
                        const div = document.createElement('div');
                        div.className = `message ${m.userId === userId ? 'message-mine' : 'message-other'}`;
                        div.innerHTML = m.userId === userId ? escapeHtml(m.text) : `<b>${escapeHtml(m.userName)}:</b> ${escapeHtml(m.text)}`;
                        container.appendChild(div);
                    }
                    container.scrollTop = container.scrollHeight;
                } catch(e) {}
            }
            
            function sendChatMessage() {
                const input = document.getElementById('chatInput');
                const text = input.value.trim();
                if (!text) return;
                fetch('/api/chat/send', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ roomId, userId, userName, text })
                }).then(() => { input.value = ''; loadChat(); });
            }
            
            function runCode() {
                if (!editor) return;
                const code = editor.getValue();
                const lang = document.getElementById('langSelect').value;
                const out = document.getElementById('terminalOut');
                out.innerHTML += `\n$ Запуск ${lang}...\n`;
                fetch('/api/terminal/run', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ command: JSON.stringify({ language: lang, code }) })
                }).then(r => r.json()).then(data => {
                    out.innerHTML += (data.output || data.error || 'Выполнено\n');
                    out.scrollTop = out.scrollHeight;
                });
            }
            
            function toggleTerminal() {
                const term = document.querySelector('.terminal');
                const btn = term.querySelector('.terminal-header button');
                if (term.style.height === '35px') { term.style.height = '130px'; btn.innerHTML = '▼'; }
                else { term.style.height = '35px'; btn.innerHTML = '▲'; }
            }
            
            function connectWebSocket() {
                const url = `ws://${window.location.hostname}:8000/ws/${roomId}/${userId}`;
                ws = new WebSocket(url);
                ws.onopen = () => ws.send(JSON.stringify({ name: userName, avatar: userAvatar, cursor: userCursor }));
                ws.onmessage = (e) => {
                    try {
                        const data = JSON.parse(e.data);
                        if (data.type === 'participant_list') updateUsers(data.users);
                    } catch(e) {}
                };
                ws.onclose = () => setTimeout(connectWebSocket, 3000);
            }
            
            function updateUsers(users) {
                const container = document.getElementById('usersList');
                container.innerHTML = '';
                for (const u of users) {
                    const div = document.createElement('div');
                    div.className = 'participant';
                    div.onclick = () => window.location.href = `/Profile?id=${u.user_id}`;
                    div.innerHTML = `<div class="participant-avatar">${u.avatar || '👤'}</div>
                                    <div class="participant-name">${escapeHtml(u.name)} ${u.user_id === userId ? '(Вы)' : ''}</div>
                                    <div class="participant-status" style="background:${u.online ? '#4caf50' : '#888'}"></div>`;
                    container.appendChild(div);
                }
            }
            
            async function loadUsersRest() {
                try {
                    const res = await fetch(`/api/room/${roomId}/users`);
                    const users = await res.json();
                    updateUsers(users);
                } catch(e) {}
            }
            
            function toggleUsers() {
                const panel = document.getElementById('usersPanel');
                if (panel.style.display === 'none' || !panel.style.display) {
                    panel.style.display = 'block';
                    if (!ws || ws.readyState !== WebSocket.OPEN) loadUsersRest();
                } else panel.style.display = 'none';
            }
            
            function closeUsers() { document.getElementById('usersPanel').style.display = 'none'; }
            function openExitModal() { document.getElementById('exitModal').style.display = 'flex'; }
            function closeExitModal() { document.getElementById('exitModal').style.display = 'none'; }
            async function exitRoom() { if (currentFileId && editor) await saveFile(); window.location.href = '/dashboard'; }
            
            function initEditor() {
                const container = document.getElementById('editor');
                require.config({ paths: { vs: 'https://cdnjs.cloudflare.com/ajax/libs/monaco-editor/0.34.1/min/vs' } });
                require(['vs/editor/editor.main'], function() {
                    editor = monaco.editor.create(container, {
                        value: '// Создайте или откройте файл',
                        language: 'javascript',
                        theme: 'vs-dark',
                        automaticLayout: true,
                        fontSize: 13,
                        minimap: { enabled: false }
                    });
                    editor.onDidChangeModelContent(() => {
                        if (saveTimer) clearTimeout(saveTimer);
                        saveTimer = setTimeout(saveFile, 1000);
                    });
                    loadFiles();
                });
            }
            
            function escapeHtml(s) { return s.replace(/[&<>]/g, function(m){ if(m==='&') return '&amp;'; if(m==='<') return '&lt;'; if(m==='>') return '&gt;'; return m;}); }
            
            initEditor();
            loadChat();
            connectWebSocket();
            setInterval(loadChat, 5000);
            setInterval(() => { if(!ws || ws.readyState !== WebSocket.OPEN) loadUsersRest(); }, 10000);
            
            document.getElementById('chatInput')?.addEventListener('keypress', e => { if(e.key === 'Enter') sendChatMessage(); });
            document.getElementById('terminalInput')?.addEventListener('keypress', e => {
                if(e.key === 'Enter') {
                    const cmd = e.target.value;
                    e.target.value = '';
                    const out = document.getElementById('terminalOut');
                    out.innerHTML += `\n$ ${cmd}\n`;
                    fetch('/api/terminal/run', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ command: JSON.stringify({ language: 'bash', code: cmd }) })
                    }).then(r => r.json()).then(data => {
                        out.innerHTML += (data.output || data.error || '');
                        out.scrollTop = out.scrollHeight;
                    });
                }
            });
        </script>
    </body>
    </html>
}