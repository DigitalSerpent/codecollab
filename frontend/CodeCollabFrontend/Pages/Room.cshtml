            }
            
            .floating-users {
                display: none;
                position: fixed;
                bottom: 75px;
                left: 20px;
                width: 280px;
                background: #121628;
                border: 1px solid #00aaff;
                border-radius: 10px;
                padding: 15px;
                z-index: 100000;
                max-height: 400px;
                overflow-y: auto;
            }
            
            .users-title {
                color: white;
                margin-bottom: 12px;
                display: flex;
                justify-content: space-between;
                font-size: 14px;
                font-weight: bold;
            }
            
            .user-item {
                display: flex;
                align-items: center;
                gap: 10px;
                padding: 8px;
                cursor: pointer;
                border-radius: 6px;
                margin-bottom: 5px;
            }
            
            .user-item:hover {
                background: #1e1e3a;
            }
            
            .user-avatar {
                width: 32px;
                height: 32px;
                border-radius: 50%;
                background: #1e1e3a;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 18px;
            }
            
            .user-name {
                flex: 1;
                color: white;
                font-size: 13px;
            }
            
            .user-status {
                width: 8px;
                height: 8px;
                border-radius: 50%;
            }
            
            .toast-notification {
                position: fixed;
                top: 20px;
                right: 20px;
                padding: 12px 20px;
                border-radius: 8px;
                z-index: 1000000;
                font-size: 13px;
                animation: slideIn 0.3s ease;
            }
            
            @@keyframes slideIn {
                from { transform: translateX(100%); opacity: 0; }
                to { transform: translateX(0); opacity: 1; }
            }
        </style>
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    </head>
    <body>
        <div class="room-container">
            @if (userId == room.OwnerId)
            {
                <div class="invite-bar">
                    <div style="display: flex; gap: 8px;">
                        <input id="inviteLink" type="text" readonly value="@($"{Request.Scheme}://{Request.Host}/room/join/{room.InviteToken}")" class="invite-input">
                        <button class="invite-btn" onclick="copyInvite()">Копировать</button>
                    </div>
                </div>
            }
            
            <div class="workspace">
                <!-- Левая панель -->
                <div class="sidebar">
                    <div class="sidebar-header">
                        <i class="fas fa-folder"></i> Файлы
                    </div>
                    <div id="fileTree" class="file-list"></div>
                    <button class="new-file-btn" onclick="createFile()">
                        <i class="fas fa-plus"></i> Новый файл
                    </button>
                </div>
                
                <!-- Центр -->
                <div class="main-workspace">
                    <div class="tabs-bar" id="tabsBar"></div>
                    <div class="editor-toolbar">
                        <select id="languageSelect" class="lang-select">
                            <option value="python">Python</option>
                            <option value="javascript">JavaScript</option>
                            <option value="html">HTML</option>
                            <option value="css">CSS</option>
                        </select>
                        <button class="run-btn" onclick="runCode()">
                            <i class="fas fa-play"></i> Запустить
                        </button>
                    </div>
                    <div id="editor" class="editor-container"></div>
                    <div class="terminal-panel">
                        <div class="terminal-header">
                            <span><i class="fas fa-terminal"></i> Терминал</span>
                            <button onclick="toggleTerminal()" style="background: none; border: none; color: #ccc; cursor: pointer;">▲</button>
                        </div>
                        <div id="terminalOutput" class="terminal-output">$ Готов к работе\n</div>
                        <div class="terminal-input-line">
                            <span class="terminal-prompt">$</span>
                            <input type="text" id="terminalInput" class="terminal-input" placeholder="Введите команду...">
                        </div>
                    </div>
                </div>
                
                <!-- Правая панель -->
                <div class="chat-sidebar">
                    <div class="chat-header">
                        <i class="fas fa-comments"></i> Чат
                    </div>
                    <div id="chatMessages" class="chat-messages"></div>
                    <div class="chat-input-area">
                        <input type="text" id="chatInput" class="chat-input" placeholder="Сообщение...">
                        <button class="send-btn" onclick="sendChatMessage()">
                            <i class="fas fa-paper-plane"></i>
                        </button>
                    </div>
                </div>
            </div>
            
            <div class="bottom-bar">
                <div class="bottom-btn" onclick="toggleUsersPanel()">
                    <i class="fas fa-users"></i>
                </div>
                <div class="bottom-btn" onclick="showExitModal()">
                    <i class="fas fa-sign-out-alt"></i>
                </div>
            </div>
        </div>
        
        <!-- Модалки -->
        <div id="usersModal" class="floating-users">
            <div class="users-title">
                <span>Участники</span>
                <span onclick="closeUsersPanel()" style="cursor:pointer;">✖</span>
            </div>
            <div id="usersList"></div>
        </div>
        
        <div id="exitModal" class="modal-overlay">
            <div class="modal-window">
                <h3>Выйти из комнаты?</h3>
                <p style="color: #ccc; margin-bottom: 15px;">Изменения сохранятся</p>
                <div class="modal-buttons">
                    <button class="modal-btn modal-cancel" onclick="closeExitModal()">Отмена</button>
                    <button class="modal-btn modal-confirm" onclick="exitRoom()">Выйти</button>
                </div>
            </div>
        </div>

        <script src="https://cdnjs.cloudflare.com/ajax/libs/monaco-editor/0.34.1/min/vs/loader.js"></script>
        <script>
            // Данные
            const roomId = @roomId;
            const userId = @(userId ?? 0);
            const userName = "@(currentUser?.Name ?? "Гость")";
            const avatar = "@(currentUser?.Avatar ?? "👤")";
            const cursor = "@(currentUser?.Cursor ?? "⬤")";
            
            // Состояние
            let editor = null;
            let currentFileId = null;
            let openTabs = [];
            let saveTimer = null;
            let ws = null;
            
            // Утилиты
            function showToast(msg, isError = false) {
                const toast = document.createElement('div');
                toast.className = 'toast-notification';
                toast.style.background = isError ? '#c62828' : '#2e7d32';
                toast.textContent = msg;
                document.body.appendChild(toast);
                setTimeout(() => toast.remove(), 3000);
            }
            
            function copyInvite() {
                const input = document.getElementById('inviteLink');
                input.select();
                document.execCommand('copy');
                showToast('Ссылка скопирована');
            }
            
            function getFileIcon(name) {
                const ext = name.split('.').pop().toLowerCase();
                const icons = {
                    'py': '<i class="fab fa-python"></i>',
                    'js': '<i class="fab fa-js"></i>',
                    'html': '<i class="fab fa-html5"></i>',
                    'css': '<i class="fab fa-css3-alt"></i>',
                    'json': '<i class="fas fa-brackets-curly"></i>',
                    'md': '<i class="fas fa-markdown"></i>'
                };
                return icons[ext] || '<i class="fas fa-file-code"></i>';
            }
            
            function getLanguage(name) {
                const ext = name.split('.').pop().toLowerCase();
                const map = {
                    'py': 'python',
                    'js': 'javascript',
                    'html': 'html',
                    'css': 'css',
                    'json': 'json',
                    'md': 'markdown'
                };
                return map[ext] || 'text';
            }
            
            // WebSocket подключение
            function connectWebSocket() {
                const wsUrl = `ws://code-collab.ru:8000/ws/${roomId}/${userId}`;
                console.log('🔌 Подключение к WebSocket:', wsUrl);
                
                ws = new WebSocket(wsUrl);
                
                ws.onopen = () => {
                    console.log("✅ WebSocket подключен!");
                    ws.send(JSON.stringify({ 
                        name: userName, 
                        avatar: avatar, 
                        cursor: cursor 
                    }));
                };
                
                ws.onmessage = (event) => {
                    console.log("📨 Получено:", event.data);
                    try {
                        const msg = JSON.parse(event.data);
                        if (msg.type === "participant_list") {
                            updateUsersList(msg.users);
                        }
                    } catch(e) {
                        console.error("Ошибка парсинга:", e);
                    }
                };
                
                ws.onclose = () => {
                    console.log("❌ WebSocket отключен, переподключение через 3 секунды...");
                    setTimeout(connectWebSocket, 3000);
                };
                
                ws.onerror = (error) => {
                    console.error("⚠️ Ошибка WebSocket:", error);
                };
            }
            
            // Обновление списка участников
            function updateUsersList(users) {
                const container = document.getElementById('usersList');
                if (!container) return;
                
                container.innerHTML = '';
                if (!users || users.length === 0) {
                    container.innerHTML = '<div style="color: #888; padding: 10px; text-align: center;">Нет участников</div>';
                    return;
                }
                
                for (const user of users) {
                    const div = document.createElement('div');
                    div.className = 'user-item';
                    div.onclick = () => window.location.href = `/Profile?id=${user.user_id}`;
                    div.innerHTML = `
                        <div class="user-avatar">${user.avatar || '👤'}</div>
                        <div class="user-name">${escapeHtml(user.name)} ${user.user_id === userId ? '(Вы)' : ''}</div>
                        <div class="user-status" style="background: ${user.online ? '#4CAF50' : '#888'}"></div>
                    `;
                    container.appendChild(div);
                }
            }
            
            // Файлы
            async function loadFiles() {
                try {
                    const res = await fetch(`/api/room/${roomId}/file`);
                    const files = await res.json();
                    const container = document.getElementById('fileTree');
                    container.innerHTML = '';
                    
                    for (const file of files) {
                        const div = document.createElement('div');
                        div.className = `file-item ${currentFileId === file.id ? 'active' : ''}`;
                        div.innerHTML = `${getFileIcon(file.name)} <span style="flex:1;">${escapeHtml(file.name)}</span>`;
                        div.onclick = () => openFile(file.id, file.name);
                        container.appendChild(div);
                    }
                } catch(e) {
                    console.error(e);
                }
            }
            
            async function openFile(id, name) {
                try {
                    const res = await fetch(`/api/room/${roomId}/file/${id}`);
                    const file = await res.json();
                    
                    if (!openTabs.some(t => t.id === id)) {
                        openTabs.push({ id, name });
                    }
                    
                    currentFileId = id;
                    renderTabs();
                    loadFiles();
                    
                    if (editor) {
                        editor.setValue(file.content || '');
                        monaco.editor.setModelLanguage(editor.getModel(), getLanguage(name));
                    }
                    
                    localStorage.setItem(`lastFile_${roomId}`, id);
                } catch(e) {
                    showToast('Ошибка открытия файла', true);
                }
            }
            
            async function saveFile() {
                if (!currentFileId || !editor) return;
                
                try {
                    const content = editor.getValue();
                    await fetch(`/api/room/${roomId}/file/${currentFileId}`, {
                        method: 'PUT',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ content })
                    });
                    console.log('Файл сохранен');
                } catch(e) {
                    console.error('Ошибка сохранения:', e);
                }
            }
            
            async function createFile() {
                let name = prompt('Имя файла (например, script.py):');
                if (!name) return;
                if (!name.includes('.')) name += '.txt';
                
                try {
                    const res = await fetch(`/api/room/${roomId}/file`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ name })
                    });
                    
                    if (res.ok) {
                        const file = await res.json();
                        await loadFiles();
                        await openFile(file.id, file.name);
                        showToast(`Файл ${name} создан`);
                    }
                } catch(e) {
                    showToast('Ошибка создания', true);
                }
            }
            
            function renderTabs() {
                const container = document.getElementById('tabsBar');
                if (!container) return;
                
                container.innerHTML = '';
                
                for (const tab of openTabs) {
                    const div = document.createElement('div');
                    div.className = `tab ${currentFileId === tab.id ? 'active' : ''}`;
                    div.innerHTML = `
                        ${getFileIcon(tab.name)}
                        <span>${escapeHtml(tab.name)}</span>
                        <span class="tab-close" onclick="event.stopPropagation(); closeTab(${tab.id})">✖</span>
                    `;
                    div.onclick = () => openFile(tab.id, tab.name);
                    container.appendChild(div);
                }
            }
            
            async function closeTab(id) {
                const index = openTabs.findIndex(t => t.id === id);
                if (index === -1) return;
                
                openTabs.splice(index, 1);
                
                if (currentFileId === id) {
                    if (openTabs.length > 0) {
                        await openFile(openTabs[0].id, openTabs[0].name);
                    } else {
                        currentFileId = null;
                        if (editor) editor.setValue('');
                        loadFiles();
                    }
                }
                renderTabs();
            }
            
            // Чат
            async function loadChat() {
                try {
                    const res = await fetch(`/api/chat/${roomId}`);
                    const messages = await res.json();
                    const container = document.getElementById('chatMessages');
                    container.innerHTML = '';
                    
                    for (const msg of messages) {
                        const div = document.createElement('div');
                        div.className = `message ${msg.userId === userId ? 'message-mine' : 'message-other'}`;
                        div.innerHTML = msg.userId === userId ? escapeHtml(msg.text) : `<b>${escapeHtml(msg.userName)}:</b> ${escapeHtml(msg.text)}`;
                        container.appendChild(div);
                    }
                    container.scrollTop = container.scrollHeight;
                } catch(e) {}
            }
            
            function sendChatMessage() {
                const input = document.getElementById('chatInput');
                const text = input.value.trim();
                if (!text) return;
                
                fetch('/api/chat/send', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ roomId, userId, userName, text })
                }).then(() => {
                    input.value = '';
                    loadChat();
                });
            }
            
            // Участники (REST API резервный)
            async function loadUsersRest() {
                try {
                    const res = await fetch(`/api/room/${roomId}/users`);
                    const users = await res.json();
                    updateUsersList(users);
                } catch(e) {}
            }
            
            function toggleUsersPanel() {
                const panel = document.getElementById('usersModal');
                if (panel.style.display === 'none' || !panel.style.display) {
                    panel.style.display = 'block';
                    if (!ws || ws.readyState !== WebSocket.OPEN) {
                        loadUsersRest();
                    }
                } else {
                    panel.style.display = 'none';
                }
            }
            
            function closeUsersPanel() {
                document.getElementById('usersModal').style.display = 'none';
            }
            
            // Терминал и запуск
            function runCode() {
                if (!editor) return;
                const code = editor.getValue();
                const lang = document.getElementById('languageSelect').value;
                const output = document.getElementById('terminalOutput');
                
                output.innerHTML += `\n$ Запуск ${lang}...\n`;
                
                fetch('/api/terminal/run', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ command: JSON.stringify({ language: lang, code }) })
                })
                .then(r => r.json())
                .then(data => {
                    output.innerHTML += (data.output || data.error || 'Выполнено\n');
                    output.scrollTop = output.scrollHeight;
                });
            }
            
            function toggleTerminal() {
                const terminal = document.querySelector('.terminal-panel');
                const btn = terminal.querySelector('.terminal-header button');
                if (terminal.style.height === '30px') {
                    terminal.style.height = '160px';
                    btn.innerHTML = '▲';
                } else {
                    terminal.style.height = '30px';
                    btn.innerHTML = '▼';
                }
            }
            
            // Выход
            function showExitModal() {
                document.getElementById('exitModal').style.display = 'flex';
            }
            
            function closeExitModal() {
                document.getElementById('exitModal').style.display = 'none';
            }
            
            async function exitRoom() {
                if (currentFileId && editor) {
                    await saveFile();
                }
                window.location.href = '/dashboard';
            }
            
            // Инициализация редактора
            function initEditor() {
                const container = document.getElementById('editor');
                if (!container) return;
                
                require.config({ paths: { vs: 'https://cdnjs.cloudflare.com/ajax/libs/monaco-editor/0.34.1/min/vs' } });
                require(['vs/editor/editor.main'], function() {
                    editor = monaco.editor.create(container, {
                        value: '// Откройте файл для редактирования\n',
                        language: 'javascript',
                        theme: 'vs-dark',
                        automaticLayout: true,
                        fontSize: 13,
                        minimap: { enabled: false },
                        scrollBeyondLastLine: false
                    });
                    
                    editor.onDidChangeModelContent(() => {
                        if (saveTimer) clearTimeout(saveTimer);
                        saveTimer = setTimeout(saveFile, 1000);
                    });
                    
                    loadFiles();
                    
                    const lastFile = localStorage.getItem(`lastFile_${roomId}`);
                    if (lastFile) {
                        fetch(`/api/room/${roomId}/file/${lastFile}`)
                            .then(res => res.json())
                            .then(file => {
                                if (file && file.name) openFile(lastFile, file.name);
                            });
                    }
                });
            }
            
            function escapeHtml(text) {
                const div = document.createElement('div');
                div.textContent = text;
                return div.innerHTML;
            }
            
            // Обработчики событий
            document.getElementById('chatInput')?.addEventListener('keypress', e => {
                if (e.key === 'Enter') sendChatMessage();
            });
            
            document.getElementById('terminalInput')?.addEventListener('keypress', e => {
                if (e.key === 'Enter') {
                    const input = e.target;
                    const cmd = input.value;
                    input.value = '';
                    const output = document.getElementById('terminalOutput');
                    output.innerHTML += `\n$ ${cmd}\n`;
                    
                    fetch('/api/terminal/run', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ command: JSON.stringify({ language: 'bash', code: cmd }) })
                    })
                    .then(r => r.json())
                    .then(data => {
                        output.innerHTML += (data.output || data.error || '');
                        output.scrollTop = output.scrollHeight;
                    });
                }
            });
            
            // Запуск всего
            initEditor();
            loadChat();
            connectWebSocket(); // Подключаем WebSocket
            
            setInterval(loadChat, 5000);
            setInterval(() => {
                if (!ws || ws.readyState !== WebSocket.OPEN) {
                    loadUsersRest();
                }
            }, 10000);
        </script>
    </body>
    </html>
}