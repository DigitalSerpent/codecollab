@page "/room/{id}"
@using Microsoft.EntityFrameworkCore
@using CodeCollabFrontend.Models
@inject AppDbContext _context

@{
    if (!int.TryParse((string?)RouteData.Values["id"], out int roomId))
    {
        <h2 style="color: white;">Неверный ID комнаты</h2>
        return;
    }

    var room = _context.Rooms
        .Include(r => r.RoomParticipants)
            .ThenInclude(rp => rp.User)
        .FirstOrDefault(r => r.Id == roomId);
}

@if (room == null)
{
    <h2 style="color: white;">Комната не найдена</h2>
}
else
{
    ViewData["Title"] = room.Name;

    <!-- Основной контейнер -->
    <div style="display: flex; flex-direction: column; height: calc(100vh - 80px); padding: 10px; padding-right: 60px;">

        <!-- Главный прямоугольник -->
        <div style="display: flex; flex: 1; background-color: #121628; border-radius: 20px; border: 1px solid #00aaff; overflow: hidden;">

            <!-- Левая часть: структура + код + терминал -->
            <div style="display: flex; flex: 1; flex-direction: column;">

<select id="languageSelect" style="background-color: #0d0d1a; color: white; border: 1px solid #00aaff; border-radius: 5px; padding: 5px; margin-right: 10px;">
    <option value="python">Python</option>
    <option value="javascript">JavaScript</option>
    <option value="bash">Bash</option>
</select>
                <!-- Вкладки + кнопка Run -->
                <div style="height: 40px; background-color: #0d0d1a; border-bottom: 1px solid #00aaff; display: flex; align-items: center; justify-content: space-between; padding-left: 15px; padding-right: 15px;">
                    <div style="display: flex; gap: 5px;">
                        <div style="background-color: #1e1e3a; color: white; padding: 8px 20px; border-radius: 8px 8px 0 0; border: 1px solid #00aaff; border-bottom: none;">main.py</div>
                        <div style="color: #a0a0a0; padding: 8px 20px;">utils.py</div>
                        <div style="color: #a0a0a0; padding: 8px 20px;">README.md</div>
                    </div>
                    <button onclick="runCode()" style="background-color: #00aaff; color: #0a0e1c; border: none; border-radius: 8px; padding: 5px 20px; cursor: pointer; font-weight: bold;">▶ Run</button>
                </div>

                <!-- Структура + код (верхняя часть) -->
                <div style="display: flex; flex: 1; min-height: 0; overflow: hidden;">
                    <div style="width: 200px; background-color: #0d0d1a; border-right: 1px solid #00aaff; padding: 15px; overflow-y: auto;">
                        <div style="color: #a0a0a0; padding: 5px;">📁 main.py</div>
                        <div style="color: #a0a0a0; padding: 5px;">📁 utils.py</div>
                        <div style="color: #a0a0a0; padding: 5px;">📄 README.md</div>
                    </div>
                    <div style="flex: 1; background-color: #0d0d1a;">
                        <div id="editor" style="height: 100%; width: 100%;"></div>
                    </div>
                </div>

                <!-- Разделитель (можно двигать) -->
                <div id="resizer" style="height: 5px; background-color: #00aaff; cursor: ns-resize;"></div>

                <!-- Терминал -->
                <div id="terminalContainer" style="height: 150px; background-color: #1e1e1e; border-top: 1px solid #00aaff; display: flex; flex-direction: column;">
                    <div style="height: 30px; background-color: #2d2d2d; display: flex; align-items: center; padding: 0 10px; color: white; justify-content: space-between;">
                        <span>Терминал</span>
                    </div>
                    <div id="terminalOutput" style="flex: 1; padding: 10px; color: #cccccc; font-family: 'Courier New', monospace; overflow-y: auto; white-space: pre-wrap;"></div>
                    <div style="padding: 8px; border-top: 1px solid #3c3c3c; display: flex;">
                        <span style="color: #cccccc; margin-right: 5px;">$</span>
                        <input type="text" id="terminalInput" style="flex: 1; background: none; border: none; color: #cccccc; outline: none;" placeholder="Введите команду...">
                    </div>
                </div>
            </div>

            <!-- Чат -->
            <div style="width: 280px; background-color: #0d0d1a; border-left: 1px solid #00aaff; display: flex; flex-direction: column;">
                <div style="height: 40px; background-color: #121628; border-bottom: 1px solid #00aaff; display: flex; align-items: center; padding-left: 15px; color: white; font-weight: bold;">Чат</div>
                <div id="chatMessages" style="flex: 1; padding: 10px; overflow-y: auto; display: flex; flex-direction: column; gap: 8px;"></div>
                <div style="padding: 10px; border-top: 1px solid #00aaff; display: flex; gap: 8px;">
                    <input type="text" id="chatInput" placeholder="Введите сообщение..." style="flex: 1; padding: 8px; background-color: #0a0e1c; border: 1px solid #00aaff; color: white; border-radius: 8px;" onkeypress="if(event.key === 'Enter') sendMessage()">
                    <button onclick="sendMessage()" style="background-color: #00aaff; color: #0a0e1c; border: none; border-radius: 8px; padding: 8px 15px; cursor: pointer;">➤</button>
                </div>
            </div>
        </div>

        <!-- Нижние иконки -->
        <div style="margin-top: 10px; display: flex; justify-content: space-between;">
            <div style="display: flex; gap: 15px;">
                <div style="width: 45px; height: 45px; background-color: #121628; border: 1px solid #00aaff; border-radius: 10px; display: flex; align-items: center; justify-content: center; color: #a0a0a0; font-size: 1.5rem; cursor: pointer;" title="Участники" onclick="toggleUsersPanel()">📋</div>
            </div>
            <div style="width: 45px; height: 45px; background-color: #121628; border: 1px solid #00aaff; border-radius: 10px; display: flex; align-items: center; justify-content: center; color: #a0a0a0; font-size: 1.5rem; cursor: pointer;" title="Настройки комнаты" onclick="toggleSettingsPanel()">⚙️</div>
        </div>
    </div>

    <!-- Панель участников -->
    <div id="usersPanel" style="display: none; position: fixed; bottom: 70px; left: 20px; width: 280px; background-color: #121628; border: 1px solid #00aaff; border-radius: 15px; padding: 15px; z-index: 200; box-shadow: 0 0 20px rgba(0,170,255,0.5);">
        <div style="display: flex; justify-content: space-between; margin-bottom: 15px;">
            <h4 style="color: white; margin: 0;">Участники</h4>
            <span style="color: #a0a0a0; font-size: 1.2rem; cursor: pointer;" onclick="closeUsersPanel()">✖</span>
        </div>
        <div id="usersList" style="max-height: 300px; overflow-y: auto;"></div>
    </div>

    <!-- Панель настроек -->
    <div id="settingsPanel" style="display: none; position: fixed; bottom: 70px; right: 70px; width: 280px; background-color: #121628; border: 1px solid #00aaff; border-radius: 15px; padding: 15px; z-index: 200; box-shadow: 0 0 20px rgba(0,170,255,0.5);">
        <div style="display: flex; justify-content: space-between; margin-bottom: 15px;">
            <h4 style="color: white; margin: 0;">Настройки</h4>
            <span style="color: #a0a0a0; font-size: 1.2rem; cursor: pointer;" onclick="toggleSettingsPanel()">✖</span>
        </div>
        <div style="color: white;">
            <p>⚙️ Здесь будут настройки комнаты</p>
            <p>👥 Макс. участников: 5</p>
            <p>📅 Создана: @room.CreatedAt.ToString("dd.MM.yyyy")</p>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/monaco-editor/0.34.1/min/vs/loader.min.js"></script>
    <script>
        let editor;
        const roomId = @roomId;

        require.config({ paths: { vs: 'https://cdnjs.cloudflare.com/ajax/libs/monaco-editor/0.34.1/min/vs' } });

        require(['vs/editor/editor.main'], function () {
            var initialCode = '@(Html.Raw(room.PreviewCode?.Replace("\n", "\\n").Replace("\r", "") ?? ""))';
            editor = monaco.editor.create(document.getElementById('editor'), {
                value: initialCode,
                language: 'python',
                theme: 'vs-dark',
                automaticLayout: true,
                fontSize: 14,
                minimap: { enabled: false }
            });
        });

        // ==================== Чат ====================
        function loadChatHistory() {
            fetch(`/api/chat/${roomId}`)
                .then(response => response.json())
                .then(messages => {
                    const container = document.getElementById('chatMessages');
                    container.innerHTML = '';
                    messages.forEach(msg => {
                        const msgDiv = document.createElement('div');
                        msgDiv.style.marginBottom = '12px';
                        msgDiv.style.display = 'flex';
                        msgDiv.style.flexDirection = 'column';
                        msgDiv.style.alignItems = msg.userName === 'Вы' ? 'flex-end' : 'flex-start';
                        
                        const bubble = document.createElement('div');
                        bubble.style.maxWidth = '80%';
                        bubble.style.padding = '8px 12px';
                        bubble.style.borderRadius = '15px';
                        bubble.style.backgroundColor = msg.userName === 'Вы' ? '#00aaff' : '#2a2a4a';
                        bubble.style.color = msg.userName === 'Вы' ? '#0a0e1c' : 'white';
                        bubble.style.wordWrap = 'break-word';
                        
                        if (msg.text.startsWith('📦')) {
                            bubble.style.backgroundColor = 'transparent';
                            bubble.style.padding = '0';
                            bubble.style.fontSize = '3rem';
                        }
                        
                        bubble.innerHTML = msg.userName === 'Вы' ? msg.text : `<span style="color: #00aaff; font-weight: bold;">${msg.userName}:</span> ${msg.text}`;
                        msgDiv.appendChild(bubble);
                        container.appendChild(msgDiv);
                    });
                    container.scrollTop = container.scrollHeight;
                });
        }

        function sendMessage() {
            const input = document.getElementById('chatInput');
            const text = input.value.trim();
            if (!text) return;

            fetch('/api/chat/send', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    roomId: roomId,
                    userId: 1,
                    userName: 'Вы',
                    text: text
                })
            })
            .then(response => response.json())
            .then(() => {
                input.value = '';
                loadChatHistory();
            });
        }

        // ==================== Участники ====================
        function toggleUsersPanel() {
            const panel = document.getElementById('usersPanel');
            if (panel.style.display === 'none' || panel.style.display === '') {
                loadUsersList();
                panel.style.display = 'block';
            } else {
                panel.style.display = 'none';
            }
        }

        function closeUsersPanel() {
            document.getElementById('usersPanel').style.display = 'none';
        }

        function loadUsersList() {
            fetch(`/api/room/${roomId}/users`)
                .then(response => response.json())
                .then(users => {
                    const container = document.getElementById('usersList');
                    container.innerHTML = '';
                    users.forEach(user => {
                        const userDiv = document.createElement('div');
                        userDiv.style.display = 'flex';
                        userDiv.style.alignItems = 'center';
                        userDiv.style.marginBottom = '10px';
                        userDiv.style.gap = '8px';
                        userDiv.style.cursor = 'pointer';
                        userDiv.onclick = () => goToProfile(user.name);
                        userDiv.innerHTML = `
                            <span style="font-size: 1.2rem;">${user.avatar}</span>
                            <span style="color: white; font-size: 0.9rem; flex: 1;">${user.name}</span>
                            <span style="font-size: 1rem;">${user.cursor}</span>
                            <span style="width: 8px; height: 8px; border-radius: 50%; background-color: ${user.online ? '#00ff00' : '#888'};"></span>
                        `;
                        container.appendChild(userDiv);
                    });
                });
        }

        function goToProfile(name) {
            alert('Переход к профилю пользователя ' + name);
            closeUsersPanel();
        }

        // ==================== Терминал ====================
        function runCode() {
    const output = document.getElementById('terminalOutput');
    const code = editor.getValue();
    const language = document.getElementById('languageSelect').value;
    
    output.innerHTML += `$ Запуск кода (${language})...\n`;

    fetch('/api/terminal/run', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
            command: JSON.stringify({
                language: language,
                code: code
            })
        })
    })
    .then(response => response.json())
    .then(data => {
        if (data.output) {
            output.innerHTML += data.output + '\n';
        } else if (data.error) {
            output.innerHTML += `Ошибка: ${data.error}\n`;
        }
        output.scrollTop = output.scrollHeight;
    });
}

        function runCommand(command) {
            const output = document.getElementById('terminalOutput');
            output.innerHTML += `$ ${command}\n`;

            fetch('/api/terminal/run', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    command: JSON.stringify({
                        language: 'bash',
                        code: command
                    })
                })
            })
            .then(response => response.json())
            .then(data => {
                if (data.output) {
                    output.innerHTML += data.output + '\n';
                } else if (data.error) {
                    output.innerHTML += `Ошибка: ${data.error}\n`;
                }
                output.scrollTop = output.scrollHeight;
            });
        }

        document.getElementById('terminalInput').addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                runCommand(this.value);
                this.value = '';
            }
        });

       // ==================== Разделитель ====================
const resizer = document.getElementById('resizer');
const terminal = document.getElementById('terminalContainer');
const leftPart = document.querySelector('[style*="flex: 1; flex-direction: column;"]'); // левая часть
let isResizing = false;

resizer.addEventListener('mousedown', function(e) {
    isResizing = true;
    document.addEventListener('mousemove', resize);
    document.addEventListener('mouseup', stopResize);
});

function resize(e) {
    if (!isResizing) return;
    
    // Получаем высоту левой части
    const leftRect = leftPart.getBoundingClientRect();
    const mouseY = e.clientY;
    const leftTop = leftRect.top;
    const leftBottom = leftRect.bottom;
    
    // Новая высота терминала = расстояние от низа левой части до курсора
    let newHeight = leftBottom - mouseY;
    
    // Ограничиваем высоту
    newHeight = Math.max(100, Math.min(400, newHeight));
    terminal.style.height = newHeight + 'px';
}

function stopResize() {
    isResizing = false;
    document.removeEventListener('mousemove', resize);
    document.removeEventListener('mouseup', stopResize);
}

        // ==================== Настройки ====================
        function toggleSettingsPanel() {
            const panel = document.getElementById('settingsPanel');
            panel.style.display = panel.style.display === 'none' ? 'block' : 'none';
        }

        loadChatHistory();
        setInterval(loadChatHistory, 3000);
    </script>
}