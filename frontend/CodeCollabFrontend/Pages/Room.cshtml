@page "/room/{id}"
@using Microsoft.EntityFrameworkCore
@using CodeCollabFrontend.Models
@inject AppDbContext _context
@using Microsoft.AspNetCore.Http

@{
    #nullable disable
    if (!int.TryParse((string)RouteData.Values["id"], out int roomId))
    {
        <h2 style="color: white;">Неверный ID комнаты</h2>
        return;
    }

    var room = _context.Rooms
        .Include(r => r.RoomParticipants)
            .ThenInclude(rp => rp.User)
        .FirstOrDefault(r => r.Id == roomId);
    
    var userId = HttpContext.Session.GetInt32("UserId");
    var currentUser = userId != null ? _context.Users.Find(userId) : null;
    string userCursor = currentUser?.Cursor ?? "default";
}

@if (room == null)
{
    <h2 style="color: white;">Комната не найдена</h2>
}
else
{
    ViewData["Title"] = room.Name;

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style id="globalCursorStyle"></style>

    <style>
        * {
            box-sizing: border-box;
        }
        
        body { 
            margin: 0; 
            padding: 0; 
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; 
            background: #0a0e1c; 
            overflow: hidden;
            height: 100vh;
        }
        
        /* Основной контейнер */
        .main-container {
            display: flex;
            flex-direction: column;
            height: 100vh;
            padding: 8px;
            overflow: hidden;
        }
        
        /* Контентная область с панелями */
        .content-area {
            display: flex;
            flex: 1;
            min-height: 0;
            background-color: #121628;
            border-radius: 12px;
            border: 1px solid #00aaff;
            overflow: hidden;
        }
        
        /* Левая панель с файлами */
        .file-panel {
            width: 200px;
            background-color: #0d0d1a;
            border-right: 1px solid #00aaff;
            display: flex;
            flex-direction: column;
            flex-shrink: 0;
        }
        
        /* Центральная область */
        .center-area {
            display: flex;
            flex: 1;
            flex-direction: column;
            min-width: 0;
            overflow: hidden;
        }
        
        /* Панель чата */
        .chat-panel {
            width: 260px;
            background-color: #0d0d1a;
            border-left: 1px solid #00aaff;
            display: flex;
            flex-direction: column;
            flex-shrink: 0;
        }
        
        /* Нижняя панель с иконками */
        .bottom-bar {
            margin-top: 8px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-shrink: 0;
        }
        
        .icon-group {
            display: flex;
            gap: 10px;
        }
        
        .file-tree { 
            user-select: none; 
            flex: 1;
            overflow-y: auto;
        }
        
        .file-item { 
            padding: 4px 6px; 
            cursor: pointer; 
            border-radius: 4px; 
            margin-bottom: 2px; 
            display: flex; 
            align-items: center; 
            gap: 6px; 
            font-size: 13px; 
        }
        
        .file-item:hover { 
            background-color: #2a2a4a; 
        }
        
        .file-item.active { 
            background-color: #0d3d5c; 
        }
        
        .file-icon { 
            width: 20px; 
            text-align: center; 
            font-size: 13px; 
        }
        
        .new-file-btn { 
            background: none; 
            border: none; 
            color: #00aaff; 
            cursor: pointer; 
            margin-top: 8px; 
            padding: 5px; 
            width: 100%; 
            text-align: left; 
            font-size: 12px; 
        }
        
        .new-file-btn:hover { 
            background-color: #2a2a4a; 
            border-radius: 4px; 
        }
        
        .tabs-container { 
            display: flex; 
            background-color: #0d0d1a; 
            border-bottom: 1px solid #00aaff; 
            overflow-x: auto; 
            white-space: nowrap; 
            min-height: 32px;
            flex: 1;
        }
        
        .tab { 
            display: inline-flex; 
            align-items: center; 
            gap: 6px; 
            padding: 5px 10px; 
            background-color: #0d0d1a; 
            color: #a0a0a0; 
            cursor: pointer; 
            border-right: 1px solid #1e1e3a; 
            min-width: 100px; 
            font-size: 12px; 
        }
        
        .tab.active { 
            background-color: #1e1e3a; 
            color: white; 
            border-bottom: 2px solid #00aaff; 
        }
        
        .tab:hover { 
            background-color: #2a2a4a; 
        }
        
        .tab-close { 
            margin-left: auto; 
            opacity: 0.6; 
            font-size: 11px; 
        }
        
        .tab-close:hover { 
            opacity: 1; 
            color: #ff8888; 
        }
        
        .editor-toolbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            background-color: #0d0d1a;
            border-bottom: 1px solid #00aaff;
            padding: 4px 8px;
            flex-shrink: 0;
        }
        
        .resizer { 
            height: 3px; 
            background-color: #00aaff; 
            cursor: ns-resize;
            flex-shrink: 0;
        }
        
        .terminal { 
            background-color: #1e1e1e; 
            border-top: 1px solid #00aaff; 
            display: flex; 
            flex-direction: column;
            flex-shrink: 0;
        }
        
        .terminal-header { 
            height: 24px; 
            background-color: #2d2d2d; 
            display: flex; 
            align-items: center; 
            padding: 0 8px; 
            color: white; 
            font-size: 11px; 
        }
        
        .terminal-output { 
            flex: 1; 
            padding: 6px; 
            color: #ccc; 
            font-family: monospace; 
            overflow-y: auto; 
            white-space: pre-wrap; 
            font-size: 11px; 
        }
        
        .terminal-input-line { 
            display: flex; 
            align-items: center; 
            padding: 4px 8px; 
            border-top: 1px solid #3c3c3c; 
            background-color: #1e1e1e; 
        }
        
        .terminal-prompt { 
            color: #00aaff; 
            font-weight: bold; 
            margin-right: 6px; 
            font-size: 12px; 
        }
        
        .terminal-input { 
            flex: 1; 
            background: none; 
            border: none; 
            color: #ccc; 
            outline: none; 
            font-family: monospace; 
            font-size: 11px; 
        }
        
        .chat-header { 
            height: 32px; 
            background-color: #121628; 
            border-bottom: 1px solid #00aaff; 
            display: flex; 
            align-items: center; 
            padding-left: 10px; 
            color: white; 
            font-weight: bold; 
            font-size: 12px; 
        }
        
        .chat-messages { 
            flex: 1; 
            padding: 8px; 
            overflow-y: auto; 
            display: flex; 
            flex-direction: column; 
            gap: 5px; 
        }
        
        .chat-message { 
            max-width: 85%; 
            padding: 5px 8px; 
            border-radius: 10px; 
            font-size: 12px; 
            word-wrap: break-word; 
        }
        
        .chat-message.me { 
            background-color: #b198b3; 
            color: #0a0e1c; 
            align-self: flex-end; 
        }
        
        .chat-message.other { 
            background-color: #86a1b5; 
            color: white; 
            align-self: flex-start; 
        }
        
        .chat-input-area { 
            padding: 8px; 
            border-top: 1px solid #00aaff; 
            display: flex; 
            gap: 6px; 
        }
        
        .chat-input { 
            flex: 1; 
            padding: 6px; 
            background-color: #0a0e1c; 
            border: 1px solid #1e1e3a; 
            color: white; 
            border-radius: 6px; 
            resize: none; 
            font-size: 12px; 
        }
        
        .chat-button { 
            background-color: #0a0e1c; 
            border: 1px solid #00aaff; 
            border-radius: 6px; 
            padding: 6px; 
            cursor: pointer; 
            color: white; 
            font-size: 12px; 
        }
        
        .send-button { 
            background-color: #00aaff; 
            border: none; 
            border-radius: 6px; 
            padding: 6px 10px; 
            cursor: pointer; 
            color: #0a0e1c; 
        }
        
        .icon-button { 
            width: 36px; 
            height: 36px; 
            background-color: #121628; 
            border: 1px solid #00aaff; 
            border-radius: 8px; 
            display: flex; 
            align-items: center; 
            justify-content: center; 
            cursor: pointer; 
            color: #a0a0a0; 
            font-size: 16px; 
        }
        
        .icon-button:hover { 
            background-color: #1e1e3a; 
            color: #00aaff; 
        }
        
        .modal { 
            display: none; 
            position: fixed; 
            top: 0; 
            left: 0; 
            width: 100%; 
            height: 100%; 
            background-color: rgba(0,0,0,0.8); 
            z-index: 1000; 
            align-items: center; 
            justify-content: center; 
        }
        
        .modal-content { 
            background-color: #121628; 
            border-radius: 16px; 
            padding: 20px; 
            width: 320px; 
            border: 1px solid #00aaff; 
            text-align: center; 
        }
        
        .modal-content h3 { 
            color: white; 
            margin-bottom: 15px; 
            font-size: 18px; 
        }
        
        .modal-buttons { 
            display: flex; 
            gap: 8px; 
            margin-top: 15px; 
        }
        
        .modal-button { 
            background-color: #1e1e3a; 
            color: white; 
            border: none; 
            border-radius: 6px; 
            padding: 8px; 
            flex: 1; 
            cursor: pointer; 
        }
        
        .modal-button.primary { 
            background-color: #00aaff; 
            color: #0a0e1c; 
        }
        
        .floating-panel { 
            display: none; 
            position: fixed; 
            bottom: 70px; 
            left: 15px; 
            width: 260px; 
            background-color: #121628; 
            border: 1px solid #00aaff; 
            border-radius: 10px; 
            padding: 10px; 
            z-index: 200; 
        }
        
        .floating-panel.right { 
            left: auto; 
            right: 80px; 
        }
        
        .floating-panel h4 { 
            color: white; 
            margin: 0 0 8px 0; 
            font-size: 14px; 
            display: flex; 
            justify-content: space-between; 
        }
        
        .participant-item { 
            display: flex; 
            align-items: center; 
            gap: 8px; 
            margin-bottom: 8px; 
            cursor: pointer; 
            padding: 6px; 
            border-radius: 5px; 
            font-size: 12px; 
        }
        
        .participant-item:hover { 
            background-color: #1e1e3a; 
        }
        
        .participant-avatar { 
            width: 28px;
            height: 28px;
            border-radius: 50%;
            overflow: hidden;
            background-color: #1e1e3a;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }
        
        .participant-name { 
            flex: 1; 
            color: white; 
        }
        
        .participant-cursor { 
            font-size: 0.9rem; 
        }
        
        .participant-status { 
            width: 8px; 
            height: 8px; 
            border-radius: 50%; 
        }
        
        .language-select { 
            background-color: #0d0d1a; 
            color: white; 
            border: 1px solid #00aaff; 
            border-radius: 4px; 
            padding: 4px 6px; 
            font-size: 12px; 
        }
        
        #editorContainer {
            flex: 1;
            min-height: 0;
            background-color: #0d0d1a;
        }
        
        /* Стикеры */
        #stickersPanel {
            padding: 6px;
            background-color: #0a0e1c;
            gap: 5px;
            flex-wrap: wrap;
            border-top: 1px solid #1e1e3a;
        }
        
        #stickersPanel span {
            font-size: 1.2rem;
            cursor: pointer;
            padding: 3px;
        }
        
        #stickersPanel span:hover {
            transform: scale(1.2);
        }
        
        @@keyframes slideIn {
            from { transform: translateX(100%); opacity: 0; }
            to { transform: translateX(0); opacity: 1; }
        }
        
        @@keyframes slideOut {
            from { transform: translateX(0); opacity: 1; }
            to { transform: translateX(100%); opacity: 0; }
        }
    </style>

    @if (userId == room.OwnerId)
    {
        <div style="margin: 6px 12px 0 12px; background-color: #0a0e1c; padding: 5px 10px; border-radius: 6px; flex-shrink: 0;">
            <div style="display: flex; gap: 6px; align-items: center;">
                <input id="inviteLink" type="text" readonly value="@($"{Request.Scheme}://{Request.Host}/room/join/{room.InviteToken}")" 
                       style="flex: 1; background-color: #121628; border: 1px solid #1e1e3a; color: white; border-radius: 4px; padding: 4px 6px; font-size: 11px;">
                <button onclick="copyInviteLink()" style="background-color: #00aaff; color: #0a0e1c; border: none; border-radius: 4px; padding: 4px 10px; font-size: 11px; cursor: pointer;">Копировать</button>
            </div>
        </div>
    }

    <div class="main-container">
        <div class="content-area">
            <!-- ЛЕВАЯ ПАНЕЛЬ -->
            <div class="file-panel">
                <div style="padding: 8px; border-bottom: 1px solid #00aaff; font-weight: bold; color: white; font-size: 12px;">Файлы</div>
                <div id="fileTree" class="file-tree"></div>
                <button class="new-file-btn" onclick="promptNewFile()">
                    <i class="fas fa-plus"></i> Новый файл
                </button>
            </div>

            <!-- ЦЕНТР -->
            <div class="center-area">
                <div class="editor-toolbar">
                    <div id="tabsContainer" class="tabs-container"></div>
                    <div style="display: flex; align-items: center; gap: 8px; margin-left: 8px;">
                        <select id="languageSelect" class="language-select">
                            <option value="python">Python</option>
                            <option value="javascript">JavaScript</option>
                            <option value="bash">Bash</option>
                        </select>
                        <button onclick="runCode()" style="background-color: #00aaff; color: #0a0e1c; border: none; border-radius: 6px; padding: 4px 12px; cursor: pointer; font-size: 12px;">▶ Run</button>
                    </div>
                </div>

                <div id="editorContainer"></div>

                <div id="resizer" class="resizer"></div>

                <div id="terminal" class="terminal" style="height: 150px;">
                    <div class="terminal-header">
                        <span>Терминал</span>
                        <button onclick="toggleTerminal()" style="background: none; border: none; color: #ccc; margin-left: auto; cursor: pointer;">▲ Свернуть</button>
                    </div>
                    <div id="terminalOutput" class="terminal-output"></div>
                    <div class="terminal-input-line">
                        <span class="terminal-prompt">$</span>
                        <input type="text" id="terminalInput" class="terminal-input" placeholder="Введите команду...">
                    </div>
                </div>
            </div>

            <!-- ЧАТ -->
            <div class="chat-panel">
                <div class="chat-header">
                    <i class="fas fa-comments" style="margin-right: 6px;"></i> Чат
                </div>
                <div id="chatMessages" class="chat-messages"></div>
                <div id="stickersPanel" style="display: none;"></div>
                <div class="chat-input-area">
                    <button class="chat-button" onclick="toggleStickersPanel()">
                        <i class="fa-solid fa-icons"></i>
                    </button>
                    <textarea id="chatInput" class="chat-input" rows="1" placeholder="Сообщение..."></textarea>
                    <button class="send-button" onclick="sendMessage()">
                        <i class="fas fa-paper-plane"></i>
                    </button>
                </div>
            </div>
        </div>

        <div class="bottom-bar">
            <div class="icon-button" onclick="toggleUsersPanel()">
                <i class="fas fa-users"></i>
            </div>
            <div class="icon-group">
                <div class="icon-button" onclick="toggleSettingsPanel()">
                    <i class="fas fa-gears"></i>
                </div>
                <div class="icon-button" onclick="openExitModal()">
                    <i class="fas fa-arrow-right-from-bracket"></i>
                </div>
            </div>
        </div>
    </div>

    <div id="usersPanel" class="floating-panel">
        <h4>Участники <span onclick="closeUsersPanel()" style="cursor:pointer;">✖</span></h4>
        <div id="usersList" style="max-height: 300px; overflow-y: auto;"></div>
    </div>

    <div id="settingsPanel" class="floating-panel right">
        <h4>Настройки</h4>
        <p style="color:#a0a0a0; margin:4px 0; font-size:12px;">Макс. участников: 5</p>
        <p style="color:#a0a0a0; margin:4px 0; font-size:12px;">Создана: @room.CreatedAt.ToString("dd.MM.yyyy")</p>
    </div>

    <div id="exitModal" class="modal">
        <div class="modal-content">
            <h3>Выйти из комнаты?</h3>
            <div class="modal-buttons">
                <button class="modal-button" onclick="closeExitModal()">Нет</button>
                <button class="modal-button primary" onclick="exitRoom()">Да</button>
            </div>
        </div>
    </div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/monaco-editor/0.34.1/min/vs/loader.js"></script>
<script>
    let roomId = @roomId;
    let userId = @(userId ?? 0);
    let userName = "@(currentUser?.Name ?? "Гость")";
    let avatar = "@(currentUser?.Avatar ?? "👤")";
    let cursor = "@(currentUser?.Cursor ?? "⬤")";
    let ws = null;
    let participantsList = [];

    // Функция для получения списка участников через WebSocket
    function requestParticipantsList() {
        if (ws && ws.readyState === WebSocket.OPEN) {
            ws.send(JSON.stringify({ type: "get_participants" }));
        }
    }

    // Подключение WebSocket
    function connectWebSocket() {
        const protocol = window.location.protocol === "https:" ? "wss:" : "ws:";
        const wsUrl = `${protocol}//${window.location.host}/ws/${roomId}/${userId}`;
        
        ws = new WebSocket(wsUrl);
        
        ws.onopen = () => {
            console.log("WebSocket connected");
            ws.send(JSON.stringify({ 
                type: "join", 
                user_id: userId, 
                name: userName, 
                avatar: avatar, 
                cursor: cursor 
            }));
            // Запрашиваем список участников после подключения
            setTimeout(requestParticipantsList, 500);
        };
        
        ws.onmessage = (event) => {
            try {
                const msg = JSON.parse(event.data);
                
                if (msg.type === "participant_list" || msg.type === "participants") {
                    participantsList = msg.users || msg.participants || [];
                    updateUsersList(participantsList);
                }
                else if (msg.type === "user_joined") {
                    showNotification(`👤 ${msg.user?.name || 'Пользователь'} присоединился`, false);
                    requestParticipantsList();
                }
                else if (msg.type === "user_left") {
                    showNotification(`👋 ${msg.user?.name || 'Пользователь'} покинул комнату`, false);
                    requestParticipantsList();
                }
                else if (msg.type === "cursor_update") {
                    updateRemoteCursor(msg);
                }
            } catch(e) {
                console.error("Error parsing WebSocket message:", e);
            }
        };
        
        ws.onclose = () => {
            console.log("WebSocket disconnected, reconnecting in 3 seconds...");
            setTimeout(connectWebSocket, 3000);
        };
        
        ws.onerror = (error) => {
            console.error("WebSocket error:", error);
        };
    }

    // Обновление списка участников в UI
    function updateUsersList(users) {
        const container = document.getElementById('usersList');
        if (!container) return;
        
        container.innerHTML = '';
        
        if (!users || users.length === 0) {
            container.innerHTML = '<div style="color: #888; padding: 8px; text-align: center;">Нет участников</div>';
            return;
        }
        
        users.forEach(user => {
            const div = document.createElement('div');
            div.className = 'participant-item';
            div.onclick = () => {
                if (user.user_id) {
                    window.location.href = `/Profile?id=${user.user_id}`;
                }
            };
            
            // Проверяем, является ли пользователь текущим
            const isCurrentUser = user.user_id === userId;
            
            div.innerHTML = `
                <div class="participant-avatar">
                    ${(!user.avatar || user.avatar.startsWith('👤') || !user.avatar.includes('/uploads/')) ? 
                        `<span style="font-size: 1rem;">${user.avatar || '👤'}</span>` : 
                        `<img src="${user.avatar}" style="width:100%;height:100%;object-fit:cover;">`}
                </div>
                <span class="participant-name">${user.name}${isCurrentUser ? ' (Вы)' : ''}</span>
                <span class="participant-cursor">${user.cursor || '⬤'}</span>
                <div class="participant-status" style="background-color: ${user.online ? '#00ff00' : '#888'};"></div>
            `;
            container.appendChild(div);
        });
    }

    // Обновление курсора удаленного пользователя
    function updateRemoteCursor(data) {
        // Здесь можно реализовать отображение курсоров других пользователей в редакторе
        console.log("Cursor update:", data);
    }

    function showNotification(msg, isError) {
        const notif = document.createElement('div');
        notif.style.cssText = `
            position: fixed;
            top: 20px;
            right: 20px;
            background: ${isError ? '#c62828' : '#2e7d32'};
            color: white;
            padding: 8px 16px;
            border-radius: 6px;
            z-index: 10000;
            font-size: 13px;
            animation: slideIn 0.3s ease;
            box-shadow: 0 2px 8px rgba(0,0,0,0.2);
        `;
        notif.innerHTML = msg;
        document.body.appendChild(notif);
        
        setTimeout(() => {
            notif.style.animation = 'slideOut 0.3s ease';
            setTimeout(() => notif.remove(), 300);
        }, 2500);
    }

    function copyInviteLink() {
        const inp = document.getElementById('inviteLink');
        if (inp) {
            inp.select();
            document.execCommand('copy');
            showNotification('✅ Ссылка скопирована', false);
        }
    }

    function getLanguageFromFileName(name) {
        const ext = name.includes('.') ? name.split('.').pop().toLowerCase() : '';
        const map = { 
            'py': 'python', 
            'js': 'javascript', 
            'ts': 'typescript', 
            'html': 'html', 
            'css': 'css', 
            'json': 'json', 
            'md': 'markdown', 
            'txt': 'text', 
            'sh': 'bash', 
            'bash': 'bash' 
        };
        return map[ext] || 'text';
    }

    function getFileIcon(name) {
        if (name.toLowerCase() === 'readme.md') return '<i class="fas fa-book"></i>';
        const ext = name.includes('.') ? name.split('.').pop().toLowerCase() : '';
        const icons = { 
            'py': '<i class="fab fa-python"></i>', 
            'js': '<i class="fab fa-js"></i>', 
            'html': '<i class="fab fa-html5"></i>', 
            'css': '<i class="fab fa-css3-alt"></i>', 
            'json': '<i class="fas fa-brackets-curly"></i>', 
            'md': '<i class="fas fa-markdown"></i>', 
            'txt': '<i class="fas fa-file-alt"></i>', 
            'sh': '<i class="fas fa-terminal"></i>' 
        };
        return icons[ext] || '<i class="fas fa-file-code"></i>';
    }

    let editor = null;
    let currentFileId = null;
    let openTabs = [];
    let isEditorReady = false;
    let saveTimeout = null;

    // Загрузка файлов
    async function loadFiles() {
        try {
            const res = await fetch(`/api/room/${roomId}/file`);
            if (!res.ok) throw new Error('Failed to load files');
            const files = await res.json();
            const container = document.getElementById('fileTree');
            if (!container) return;
            
            container.innerHTML = '';
            for (const f of files) {
                const div = document.createElement('div');
                div.className = 'file-item' + (currentFileId === f.id ? ' active' : '');
                div.innerHTML = `<div class="file-icon">${getFileIcon(f.name)}</div><span style="flex:1; overflow:hidden; text-overflow:ellipsis;">${f.name}</span>`;
                div.onclick = () => openFile(f.id, f.name);
                container.appendChild(div);
            }
        } catch(e) { 
            console.error('Error loading files:', e);
            showNotification('Ошибка загрузки файлов', true);
        }
    }

    // Открытие файла
    async function openFile(id, name) {
        try {
            const res = await fetch(`/api/room/${roomId}/file/${id}`);
            if (!res.ok) throw new Error('Failed to open file');
            const file = await res.json();
            
            if (!openTabs.some(t => t.id === id)) {
                openTabs.push({ id, name, language: getLanguageFromFileName(name) });
            }
            
            currentFileId = id;
            renderTabs();
            loadFiles();
            
            if (editor && isEditorReady) {
                editor.setValue(file.content || '');
                monaco.editor.setModelLanguage(editor.getModel(), getLanguageFromFileName(name));
            }
        } catch(e) { 
            console.error('Error opening file:', e);
            showNotification('Ошибка открытия файла', true);
        }
    }

    // Создание файла
    async function createFile(name) {
        if (!name) return;
        
        try {
            const res = await fetch(`/api/room/${roomId}/file`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ name })
            });
            
            if (res.ok) {
                const newFile = await res.json();
                await loadFiles();
                await openFile(newFile.id, newFile.name);
                showNotification(`✅ Файл "${name}" создан`, false);
            } else {
                throw new Error('Failed to create file');
            }
        } catch(e) {
            console.error('Error creating file:', e);
            showNotification('Ошибка создания файла', true);
        }
    }

    function promptNewFile() {
        let name = prompt('Имя файла (например, script.py, readme.md, file.txt):');
        if (!name) return;
        if (!name.includes('.')) name = name + '.txt';
        createFile(name);
    }

    // Сохранение файла
    async function saveCurrentFile() {
        if (!currentFileId || !editor || !isEditorReady) return;
        
        try {
            const content = editor.getValue();
            const res = await fetch(`/api/room/${roomId}/file/${currentFileId}`, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ content: content })
            });
            
            if (res.ok) {
                console.log('File saved successfully');
            } else {
                throw new Error('Failed to save file');
            }
        } catch(e) {
            console.error('Error saving file:', e);
        }
    }

    // Закрытие вкладки
    async function closeTab(fileId) {
        const index = openTabs.findIndex(t => t.id === fileId);
        if (index === -1) return;
        
        openTabs.splice(index, 1);
        
        if (currentFileId === fileId) {
            if (openTabs.length > 0) {
                await openFile(openTabs[0].id, openTabs[0].name);
            } else {
                currentFileId = null;
                if (editor && isEditorReady) editor.setValue('');
                loadFiles();
            }
        }
        renderTabs();
    }

    function renderTabs() {
        const container = document.getElementById('tabsContainer');
        if (!container) return;
        
        container.innerHTML = '';
        for (const tab of openTabs) {
            const tabDiv = document.createElement('div');
            tabDiv.className = 'tab' + (currentFileId === tab.id ? ' active' : '');
            tabDiv.innerHTML = `
                ${getFileIcon(tab.name)}
                <span style="flex:1; overflow:hidden; text-overflow:ellipsis;">${tab.name}</span>
                <span class="tab-close" onclick="event.stopPropagation(); closeTab(${tab.id})">✖</span>
            `;
            tabDiv.onclick = () => openFile(tab.id, tab.name);
            container.appendChild(tabDiv);
        }
    }

    function runCode() {
        if (!editor || !isEditorReady) {
            showNotification('Редактор не готов', true);
            return;
        }
        
        const code = editor.getValue();
        const lang = document.getElementById('languageSelect').value;
        const out = document.getElementById('terminalOutput');
        
        if (!code.trim()) {
            out.innerHTML += `$ Ошибка: Нет кода для выполнения\n`;
            out.scrollTop = out.scrollHeight;
            return;
        }
        
        out.innerHTML += `$ Запуск (${lang})...\n`;
        
        fetch('/api/terminal/run', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ command: JSON.stringify({ language: lang, code }) })
        })
        .then(r => r.json())
        .then(data => {
            out.innerHTML += (data.output || data.error || 'Выполнение завершено\n');
            out.scrollTop = out.scrollHeight;
        })
        .catch(err => {
            out.innerHTML += `$ Ошибка: ${err.message}\n`;
            out.scrollTop = out.scrollHeight;
        });
    }

    async function loadChatHistory() {
        try {
            const res = await fetch(`/api/chat/${roomId}`);
            if (!res.ok) return;
            const msgs = await res.json();
            const container = document.getElementById('chatMessages');
            if (!container) return;
            
            container.innerHTML = '';
            for (const m of msgs) {
                const div = document.createElement('div');
                div.className = `chat-message ${m.userId === userId ? 'me' : 'other'}`;
                div.innerHTML = m.userId === userId ? m.text : `<b>${m.userName}:</b> ${m.text}`;
                container.appendChild(div);
            }
            container.scrollTop = container.scrollHeight;
        } catch(e) {
            console.error('Error loading chat:', e);
        }
    }

    function sendMessage() {
        const input = document.getElementById('chatInput');
        const text = input.value.trim();
        if (!text) return;
        
        fetch('/api/chat/send', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ roomId, userId, userName, text })
        })
        .then(() => { 
            input.value = ''; 
            loadChatHistory();
        })
        .catch(err => console.error('Error sending message:', err));
    }

    function sendSticker(sticker) {
        fetch('/api/chat/send', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ roomId, userId, userName, text: sticker })
        })
        .then(() => loadChatHistory());
    }

    function toggleStickersPanel() {
        const panel = document.getElementById('stickersPanel');
        if (panel.style.display === 'none' || !panel.style.display) {
            const stickers = ['😊', '😂', '❤️', '🔥', '🎉', '🚀', '👍', '🎨', '💻', '🐍', '📁', '✨'];
            panel.innerHTML = stickers.map(s => `<span onclick="sendSticker('${s}')">${s}</span>`).join('');
            panel.style.display = 'flex';
        } else {
            panel.style.display = 'none';
        }
    }

    function toggleUsersPanel() {
        const panel = document.getElementById('usersPanel');
        if (panel.style.display === 'none' || !panel.style.display) {
            panel.style.display = 'block';
            requestParticipantsList(); // Обновляем список при открытии
        } else {
            panel.style.display = 'none';
        }
    }

    function closeUsersPanel() { 
        document.getElementById('usersPanel').style.display = 'none'; 
    }
    
    function toggleSettingsPanel() { 
        const p = document.getElementById('settingsPanel'); 
        p.style.display = p.style.display === 'none' ? 'block' : 'none'; 
    }
    
    function openExitModal() { 
        document.getElementById('exitModal').style.display = 'flex'; 
    }
    
    function closeExitModal() { 
        document.getElementById('exitModal').style.display = 'none'; 
    }
    
    async function exitRoom() {
        // Сохраняем текущий файл перед выходом
        if (currentFileId && editor && isEditorReady) {
            await saveCurrentFile();
        }
        
        // Отправляем сообщение о выходе через WebSocket
        if (ws && ws.readyState === WebSocket.OPEN) {
            ws.send(JSON.stringify({ type: "leave", user_id: userId }));
        }
        
        // Закрываем WebSocket соединение
        if (ws) {
            ws.close();
        }
        
        // Переходим на главную
        window.location.href = '/dashboard';
    }

    function initEditor() {
        const container = document.getElementById('editorContainer');
        if (!container) return;
        
        require.config({ paths: { vs: 'https://cdnjs.cloudflare.com/ajax/libs/monaco-editor/0.34.1/min/vs' } });
        require(['vs/editor/editor.main'], function () {
            editor = monaco.editor.create(container, {
                value: '',
                language: 'python',
                theme: 'vs-dark',
                automaticLayout: true,
                fontSize: 12,
                minimap: { enabled: false },
                scrollBeyondLastLine: false
            });
            
            isEditorReady = true;
            
            editor.onDidChangeModelContent(() => {
                if (saveTimeout) clearTimeout(saveTimeout);
                saveTimeout = setTimeout(saveCurrentFile, 1000);
            });
            
            loadFiles();
            
            // Загружаем последний открытый файл, если есть
            const lastFile = localStorage.getItem(`lastFile_${roomId}`);
            if (lastFile) {
                try {
                    const file = JSON.parse(lastFile);
                    openFile(file.id, file.name);
                } catch(e) {}
            }
        });
    }

    function toggleTerminal() {
        const term = document.getElementById('terminal');
        const btn = term.querySelector('.terminal-header button');
        if (term.style.height === '30px') {
            term.style.height = '150px';
            btn.innerHTML = '▲ Свернуть';
        } else {
            term.style.height = '30px';
            btn.innerHTML = '▼ Развернуть';
        }
    }

    // Инициализация
    initEditor();
    loadChatHistory();
    setInterval(loadChatHistory, 3000);
    connectWebSocket();
    
    // Периодически обновляем список участников
    setInterval(() => {
        if (ws && ws.readyState === WebSocket.OPEN) {
            requestParticipantsList();
        }
    }, 10000);

    // Сохраняем последний открытый файл
    setInterval(() => {
        if (currentFileId) {
            localStorage.setItem(`lastFile_${roomId}`, JSON.stringify({ id: currentFileId, name: '' }));
        }
    }, 5000);

    // Обработка ввода в терминале
    document.getElementById('terminalInput')?.addEventListener('keypress', e => {
        if (e.key === 'Enter') {
            const cmd = e.target.value;
            e.target.value = '';
            const out = document.getElementById('terminalOutput');
            out.innerHTML += `$ ${cmd}\n`;
            
            fetch('/api/terminal/run', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ command: JSON.stringify({ language: 'bash', code: cmd }) })
            })
            .then(r => r.json())
            .then(data => {
                out.innerHTML += (data.output || data.error || '') + '\n';
                out.scrollTop = out.scrollHeight;
            })
            .catch(err => {
                out.innerHTML += `Ошибка: ${err.message}\n`;
                out.scrollTop = out.scrollHeight;
            });
        }
    });

    // Resizer для терминала
    const resizer = document.getElementById('resizer');
    const terminal = document.getElementById('terminal');
    let isResizing = false;
    
    if (resizer) {
        resizer.addEventListener('mousedown', (e) => {
            isResizing = true;
            document.addEventListener('mousemove', resize);
            document.addEventListener('mouseup', stopResize);
            e.preventDefault();
        });
    }
    
    function resize(e) {
        if (!isResizing) return;
        const centerArea = document.querySelector('.center-area');
        if (!centerArea) return;
        
        const rect = centerArea.getBoundingClientRect();
        let h = rect.bottom - e.clientY;
        h = Math.max(50, Math.min(400, h));
        terminal.style.height = h + 'px';
    }
    
    function stopResize() {
        isResizing = false;
        document.removeEventListener('mousemove', resize);
        document.removeEventListener('mouseup', stopResize);
    }
</script>
}