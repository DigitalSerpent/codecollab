@page "/room/{id}"
@using Microsoft.EntityFrameworkCore
@using CodeCollabFrontend.Models
@inject AppDbContext _context
@using Microsoft.AspNetCore.Http

@{
    #nullable disable
    if (!int.TryParse((string)RouteData.Values["id"], out int roomId))
    {
        <h2 style="color: white;">Неверный ID комнаты</h2>
        return;
    }

    var room = _context.Rooms
        .Include(r => r.RoomParticipants)
            .ThenInclude(rp => rp.User)
        .FirstOrDefault(r => r.Id == roomId);
    
    var userId = HttpContext.Session.GetInt32("UserId");
    var currentUser = userId != null ? _context.Users.Find(userId) : null;
}

@if (room == null)
{
    <h2 style="color: white;">Комната не найдена</h2>
}
else
{
    Layout = null;
    
    <!DOCTYPE html>
    <html>
    <head>
        <meta charset="utf-8">
        <title>@room.Name - CodeCollab</title>
        <style>
            * { margin: 0; padding: 0; box-sizing: border-box; }
            body, html { 
                width: 100%; 
                height: 100%; 
                overflow: hidden;
                background: #0a0e1c;
                font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            }
            
            /* Минимальный контейнер */
            .app {
                height: 100vh;
                display: flex;
                flex-direction: column;
                padding: 6px;
                gap: 6px;
                background: #0a0e1c;
            }
            
            /* Главная рабочая область */
            .main-row {
                flex: 1;
                display: flex;
                gap: 6px;
                min-height: 0;
            }
            
            /* Левая панель (файлы) */
            .sidebar {
                width: 180px;
                background: #0d0d1a;
                border: 1px solid #00aaff;
                border-radius: 8px;
                display: flex;
                flex-direction: column;
                overflow: hidden;
            }
            
            .sidebar-header {
                padding: 6px 10px;
                background: #121628;
                border-bottom: 1px solid #00aaff;
                color: white;
                font-size: 12px;
                font-weight: bold;
            }
            
            .file-list {
                flex: 1;
                overflow-y: auto;
                padding: 6px;
            }
            
            .file-item {
                padding: 5px 8px;
                cursor: pointer;
                border-radius: 4px;
                margin-bottom: 2px;
                color: #ccc;
                font-size: 12px;
                display: flex;
                align-items: center;
                gap: 6px;
            }
            
            .file-item:hover { background: #1e1e3a; color: white; }
            .file-item.active { background: #0d3d5c; color: white; }
            
            .new-file-btn {
                margin: 8px;
                padding: 6px;
                background: #00aaff;
                border: none;
                border-radius: 6px;
                color: #0a0e1c;
                cursor: pointer;
                font-size: 11px;
                font-weight: bold;
            }
            
            /* Центральная область */
            .center {
                flex: 1;
                display: flex;
                flex-direction: column;
                min-width: 0;
                background: #0d0d1a;
                border: 1px solid #00aaff;
                border-radius: 8px;
                overflow: hidden;
            }
            
            .tabs-bar {
                display: flex;
                background: #121628;
                border-bottom: 1px solid #00aaff;
                overflow-x: auto;
                padding: 0 6px;
                gap: 2px;
            }
            
            .tab {
                padding: 6px 12px;
                background: #0d0d1a;
                color: #ccc;
                cursor: pointer;
                font-size: 11px;
                display: flex;
                align-items: center;
                gap: 5px;
                white-space: nowrap;
            }
            
            .tab.active {
                background: #1e1e3a;
                color: white;
                border-bottom: 2px solid #00aaff;
            }
            
            .tab-close {
                margin-left: 5px;
                cursor: pointer;
                opacity: 0.6;
            }
            
            .toolbar {
                display: flex;
                justify-content: space-between;
                align-items: center;
                padding: 4px 10px;
                background: #121628;
                border-bottom: 1px solid #00aaff;
                gap: 8px;
            }
            
            .lang-select {
                background: #0d0d1a;
                color: white;
                border: 1px solid #00aaff;
                border-radius: 4px;
                padding: 3px 8px;
                font-size: 11px;
            }
            
            .run-btn {
                background: #00aaff;
                color: #0a0e1c;
                border: none;
                border-radius: 4px;
                padding: 3px 12px;
                cursor: pointer;
                font-size: 11px;
                font-weight: bold;
            }
            
            .editor {
                flex: 1;
                min-height: 0;
            }
            
            .terminal {
                height: 110px;
                background: #1e1e1e;
                border-top: 1px solid #00aaff;
                display: flex;
                flex-direction: column;
            }
            
            .terminal-header {
                padding: 4px 10px;
                background: #2d2d2d;
                color: white;
                font-size: 11px;
                display: flex;
                justify-content: space-between;
            }
            
            .terminal-output {
                flex: 1;
                overflow-y: auto;
                padding: 5px;
                color: #ccc;
                font-family: monospace;
                font-size: 11px;
                white-space: pre-wrap;
            }
            
            .terminal-input-line {
                display: flex;
                padding: 4px 8px;
                background: #1e1e1e;
                border-top: 1px solid #3c3c3c;
            }
            
            .terminal-prompt {
                color: #00aaff;
                margin-right: 6px;
                font-weight: bold;
                font-size: 11px;
            }
            
            .terminal-input {
                flex: 1;
                background: none;
                border: none;
                color: #ccc;
                outline: none;
                font-family: monospace;
                font-size: 11px;
            }
            
            /* Правая панель (чат) */
            .chat-panel {
                width: 220px;
                background: #0d0d1a;
                border: 1px solid #00aaff;
                border-radius: 8px;
                display: flex;
                flex-direction: column;
                overflow: hidden;
            }
            
            .chat-header {
                padding: 8px 10px;
                background: #121628;
                border-bottom: 1px solid #00aaff;
                color: white;
                font-size: 12px;
                font-weight: bold;
            }
            
            .chat-messages {
                flex: 1;
                overflow-y: auto;
                padding: 8px;
                display: flex;
                flex-direction: column;
                gap: 5px;
            }
            
            .message {
                max-width: 90%;
                padding: 4px 8px;
                border-radius: 8px;
                font-size: 11px;
            }
            
            .message-mine {
                background: #b198b3;
                color: #0a0e1c;
                align-self: flex-end;
            }
            
            .message-other {
                background: #86a1b5;
                color: white;
                align-self: flex-start;
            }
            
            .chat-input-area {
                display: flex;
                padding: 8px;
                gap: 6px;
                border-top: 1px solid #00aaff;
            }
            
            .chat-input {
                flex: 1;
                padding: 6px;
                background: #0a0e1c;
                border: 1px solid #1e1e3a;
                color: white;
                border-radius: 6px;
                font-size: 11px;
            }
            
            .send-btn {
                padding: 6px 10px;
                background: #00aaff;
                border: none;
                border-radius: 6px;
                cursor: pointer;
                color: #0a0e1c;
            }
            
            /* Нижние иконки */
            .bottom-bar {
                display: flex;
                justify-content: space-between;
                gap: 10px;
            }
            
            .bottom-btn {
                width: 40px;
                height: 40px;
                background: #121628;
                border: 1px solid #00aaff;
                border-radius: 8px;
                display: flex;
                align-items: center;
                justify-content: center;
                cursor: pointer;
                color: #a0a0a0;
                font-size: 18px;
            }
            
            .bottom-btn:hover {
                background: #1e1e3a;
                color: #00aaff;
            }
            
            /* Модалки */
            .modal-overlay { display: none; position: fixed; top:0; left:0; right:0; bottom:0; background: rgba(0,0,0,0.9); z-index: 100000; align-items: center; justify-content: center; }
            .modal-window { background: #121628; border-radius: 12px; padding: 20px; width: 300px; border: 1px solid #00aaff; text-align: center; }
            .modal-buttons { display: flex; gap: 10px; margin-top: 15px; }
            .modal-btn { flex:1; padding: 8px; border: none; border-radius: 6px; cursor: pointer; }
            .modal-cancel { background: #1e1e3a; color: white; }
            .modal-confirm { background: #00aaff; color: #0a0e1c; }
            
            .floating-users {
                display: none;
                position: fixed;
                bottom: 60px;
                left: 15px;
                width: 260px;
                background: #121628;
                border: 1px solid #00aaff;
                border-radius: 10px;
                padding: 12px;
                z-index: 100000;
                max-height: 350px;
                overflow-y: auto;
            }
            
            .users-title {
                color: white;
                margin-bottom: 10px;
                display: flex;
                justify-content: space-between;
                font-size: 13px;
                font-weight: bold;
            }
            
            .user-item {
                display: flex;
                align-items: center;
                gap: 8px;
                padding: 6px;
                cursor: pointer;
                border-radius: 6px;
                margin-bottom: 4px;
            }
            
            .user-item:hover { background: #1e1e3a; }
            .user-avatar { width: 28px; height: 28px; border-radius: 50%; background: #1e1e3a; display: flex; align-items: center; justify-content: center; font-size: 16px; }
            .user-name { flex: 1; color: white; font-size: 12px; }
            .user-status { width: 7px; height: 7px; border-radius: 50%; }
            
            .toast {
                position: fixed;
                top: 20px;
                right: 20px;
                padding: 10px 18px;
                border-radius: 8px;
                z-index: 1000000;
                font-size: 12px;
            }
        </style>
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
        <script src="https://cdnjs.cloudflare.com/ajax/libs/monaco-editor/0.34.1/min/vs/loader.js"></script>
    </head>
    <body>
        <div class="app">
            <div class="main-row">
                <!-- ЛЕВАЯ ПАНЕЛЬ -->
                <div class="sidebar">
                    <div class="sidebar-header"><i class="fas fa-folder"></i> Файлы</div>
                    <div id="fileList" class="file-list"></div>
                    <button class="new-file-btn" onclick="promptCreateFile()">+ Новый файл</button>
                </div>
                
                <!-- ЦЕНТР -->
                <div class="center">
                    <div id="tabsBar" class="tabs-bar"></div>
                    <div class="toolbar">
                        <select id="langSelect" class="lang-select">
                            <option value="python">Python</option>
                            <option value="javascript">JavaScript</option>
                            <option value="html">HTML</option>
                        </select>
                        <button class="run-btn" onclick="runCode()"><i class="fas fa-play"></i> Run</button>
                    </div>
                    <div id="editor" class="editor"></div>
                    <div id="terminal" class="terminal">
                        <div class="terminal-header">
                            <span><i class="fas fa-terminal"></i> Терминал</span>
                            <button onclick="toggleTerminalSize()" style="background:none;border:none;color:#ccc;cursor:pointer;">▼</button>
                        </div>
                        <div id="terminalOut" class="terminal-output">$ готов к работе\n</div>
                        <div class="terminal-input-line">
                            <span class="terminal-prompt">$</span>
                            <input type="text" id="terminalInput" class="terminal-input" placeholder="команда...">
                        </div>
                    </div>
                </div>
                
                <!-- ПРАВАЯ ПАНЕЛЬ (ЧАТ) -->
                <div class="chat-panel">
                    <div class="chat-header"><i class="fas fa-comments"></i> Чат</div>
                    <div id="chatMessages" class="chat-messages"></div>
                    <div class="chat-input-area">
                        <input type="text" id="chatInput" class="chat-input" placeholder="Сообщение...">
                        <button class="send-btn" onclick="sendChat()"><i class="fas fa-paper-plane"></i></button>
                    </div>
                </div>
            </div>
            
            <!-- НИЖНИЕ ИКОНКИ -->
            <div class="bottom-bar">
                <div class="bottom-btn" onclick="toggleUsers()"><i class="fas fa-users"></i></div>
                <div class="bottom-btn" onclick="openExitModal()"><i class="fas fa-sign-out-alt"></i></div>
            </div>
        </div>
        
        <!-- МОДАЛКИ -->
        <div id="usersModal" class="floating-users">
            <div class="users-title"><span>Участники</span><span onclick="closeUsers()" style="cursor:pointer;">✖</span></div>
            <div id="usersList"></div>
        </div>
        
        <div id="exitModal" class="modal-overlay">
            <div class="modal-window">
                <h3>Выйти из комнаты?</h3>
                <div class="modal-buttons">
                    <button class="modal-btn modal-cancel" onclick="closeExitModal()">Отмена</button>
                    <button class="modal-btn modal-confirm" onclick="exitRoom()">Выйти</button>
                </div>
            </div>
        </div>

        <script>
            const roomId = @roomId;
            const userId = @(userId ?? 0);
            const userName = "@(currentUser?.Name ?? "Гость")";
            const avatar = "@(currentUser?.Avatar ?? "👤")";
            const cursor = "@(currentUser?.Cursor ?? "⬤")";
            
            let editor = null;
            let currentFileId = null;
            let openTabs = [];
            let saveTimer = null;
            let ws = null;
            
            function showToast(msg, isErr = false) {
                const toast = document.createElement('div');
                toast.className = 'toast';
                toast.style.background = isErr ? '#c62828' : '#2e7d32';
                toast.style.color = 'white';
                toast.innerText = msg;
                document.body.appendChild(toast);
                setTimeout(() => toast.remove(), 3000);
            }
            
            // WebSocket
            function connectWs() {
                const url = `ws://${window.location.hostname}:8000/ws/${roomId}/${userId}`;
                ws = new WebSocket(url);
                ws.onopen = () => { ws.send(JSON.stringify({ name: userName, avatar, cursor })); };
                ws.onmessage = (e) => {
                    try {
                        const data = JSON.parse(e.data);
                        if (data.type === 'participant_list') updateUsers(data.users);
                    } catch(e) {}
                };
                ws.onclose = () => setTimeout(connectWs, 3000);
            }
            
            function updateUsers(users) {
                const container = document.getElementById('usersList');
                if (!container) return;
                container.innerHTML = '';
                for (const u of users) {
                    const div = document.createElement('div');
                    div.className = 'user-item';
                    div.onclick = () => window.location.href = `/Profile?id=${u.user_id}`;
                    div.innerHTML = `<div class="user-avatar">${u.avatar || '👤'}</div>
                                    <div class="user-name">${escapeHtml(u.name)} ${u.user_id === userId ? '(Вы)' : ''}</div>
                                    <div class="user-status" style="background:${u.online ? '#4caf50' : '#888'}"></div>`;
                    container.appendChild(div);
                }
            }
            
            // Файлы
            async function loadFiles() {
                try {
                    const res = await fetch(`/api/room/${roomId}/file`);
                    const files = await res.json();
                    const container = document.getElementById('fileList');
                    container.innerHTML = '';
                    for (const f of files) {
                        const div = document.createElement('div');
                        div.className = `file-item ${currentFileId === f.id ? 'active' : ''}`;
                        div.innerHTML = `<i class="fas fa-file-code"></i> ${escapeHtml(f.name)}`;
                        div.onclick = () => openFile(f.id, f.name);
                        container.appendChild(div);
                    }
                } catch(e) {}
            }
            
            async function openFile(id, name) {
                try {
                    const res = await fetch(`/api/room/${roomId}/file/${id}`);
                    const file = await res.json();
                    if (!openTabs.some(t => t.id === id)) openTabs.push({ id, name });
                    currentFileId = id;
                    renderTabs();
                    loadFiles();
                    if (editor) {
                        editor.setValue(file.content || '');
                        const lang = name.split('.').pop();
                        const langMap = { py:'python', js:'javascript', html:'html', css:'css' };
                        monaco.editor.setModelLanguage(editor.getModel(), langMap[lang] || 'text');
                    }
                } catch(e) { showToast('Ошибка открытия', true); }
            }
            
            function renderTabs() {
                const container = document.getElementById('tabsBar');
                if (!container) return;
                container.innerHTML = '';
                for (const t of openTabs) {
                    const tab = document.createElement('div');
                    tab.className = `tab ${currentFileId === t.id ? 'active' : ''}`;
                    tab.innerHTML = `<i class="fas fa-file"></i> ${escapeHtml(t.name)} <span class="tab-close" onclick="event.stopPropagation(); closeTab(${t.id})">✖</span>`;
                    tab.onclick = () => openFile(t.id, t.name);
                    container.appendChild(tab);
                }
            }
            
            async function closeTab(id) {
                const idx = openTabs.findIndex(t => t.id === id);
                if (idx === -1) return;
                openTabs.splice(idx, 1);
                if (currentFileId === id) {
                    if (openTabs.length) await openFile(openTabs[0].id, openTabs[0].name);
                    else { currentFileId = null; if(editor) editor.setValue(''); loadFiles(); }
                }
                renderTabs();
            }
            
            async function saveFile() {
                if (!currentFileId || !editor) return;
                try {
                    await fetch(`/api/room/${roomId}/file/${currentFileId}`, {
                        method: 'PUT',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ content: editor.getValue() })
                    });
                } catch(e) {}
            }
            
            async function promptCreateFile() {
                let name = prompt('Имя файла:', 'newfile.txt');
                if (!name) return;
                if (!name.includes('.')) name += '.txt';
                try {
                    const res = await fetch(`/api/room/${roomId}/file`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ name })
                    });
                    if (res.ok) {
                        const file = await res.json();
                        await loadFiles();
                        await openFile(file.id, file.name);
                    }
                } catch(e) { showToast('Ошибка создания', true); }
            }
            
            // Чат
            async function loadChat() {
                try {
                    const res = await fetch(`/api/chat/${roomId}`);
                    const msgs = await res.json();
                    const container = document.getElementById('chatMessages');
                    if (!container) return;
                    container.innerHTML = '';
                    for (const m of msgs) {
                        const div = document.createElement('div');
                        div.className = `message ${m.userId === userId ? 'message-mine' : 'message-other'}`;
                        div.innerHTML = m.userId === userId ? escapeHtml(m.text) : `<b>${escapeHtml(m.userName)}:</b> ${escapeHtml(m.text)}`;
                        container.appendChild(div);
                    }
                    container.scrollTop = container.scrollHeight;
                } catch(e) {}
            }
            
            function sendChat() {
                const input = document.getElementById('chatInput');
                const text = input.value.trim();
                if (!text) return;
                fetch('/api/chat/send', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ roomId, userId, userName, text })
                }).then(() => { input.value = ''; loadChat(); });
            }
            
            // Терминал
            function runCode() {
                if (!editor) return;
                const code = editor.getValue();
                const lang = document.getElementById('langSelect').value;
                const output = document.getElementById('terminalOut');
                output.innerHTML += `\n$ Запуск ${lang}...\n`;
                fetch('/api/terminal/run', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ command: JSON.stringify({ language: lang, code }) })
                }).then(r => r.json()).then(data => {
                    output.innerHTML += (data.output || data.error || 'Выполнено\n');
                    output.scrollTop = output.scrollHeight;
                });
            }
            
            function toggleTerminalSize() {
                const term = document.getElementById('terminal');
                if (term.style.height === '30px') { term.style.height = '110px'; }
                else { term.style.height = '30px'; }
            }
            
            // Участники (ручное открытие)
            async function loadUsersRest() {
                try {
                    const res = await fetch(`/api/room/${roomId}/users`);
                    const users = await res.json();
                    updateUsers(users);
                } catch(e) {}
            }
            
            function toggleUsers() {
                const panel = document.getElementById('usersModal');
                if (panel.style.display === 'none' || !panel.style.display) {
                    panel.style.display = 'block';
                    if (!ws || ws.readyState !== WebSocket.OPEN) loadUsersRest();
                } else panel.style.display = 'none';
            }
            
            function closeUsers() { document.getElementById('usersModal').style.display = 'none'; }
            function openExitModal() { document.getElementById('exitModal').style.display = 'flex'; }
            function closeExitModal() { document.getElementById('exitModal').style.display = 'none'; }
            
            async function exitRoom() {
                if (currentFileId && editor) await saveFile();
                window.location.href = '/dashboard';
            }
            
            // Редактор
            function initEditor() {
                const container = document.getElementById('editor');
                if (!container) return;
                require.config({ paths: { vs: 'https://cdnjs.cloudflare.com/ajax/libs/monaco-editor/0.34.1/min/vs' } });
                require(['vs/editor/editor.main'], function() {
                    editor = monaco.editor.create(container, {
                        value: '// Откройте файл для редактирования\n',
                        language: 'javascript',
                        theme: 'vs-dark',
                        automaticLayout: true,
                        fontSize: 12,
                        minimap: { enabled: false }
                    });
                    editor.onDidChangeModelContent(() => {
                        if (saveTimer) clearTimeout(saveTimer);
                        saveTimer = setTimeout(saveFile, 1000);
                    });
                    loadFiles();
                });
            }
            
            function escapeHtml(s) { return s.replace(/[&<>]/g, function(m){ if(m === '&') return '&amp;'; if(m === '<') return '&lt;'; if(m === '>') return '&gt;'; return m;}); }
            
            // Обработчики
            document.getElementById('chatInput')?.addEventListener('keypress', e => { if(e.key === 'Enter') sendChat(); });
            document.getElementById('terminalInput')?.addEventListener('keypress', e => {
                if(e.key === 'Enter') {
                    const cmd = e.target.value;
                    e.target.value = '';
                    const out = document.getElementById('terminalOut');
                    out.innerHTML += `\n$ ${cmd}\n`;
                    fetch('/api/terminal/run', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ command: JSON.stringify({ language: 'bash', code: cmd }) })
                    }).then(r => r.json()).then(data => {
                        out.innerHTML += (data.output || data.error || '');
                        out.scrollTop = out.scrollHeight;
                    });
                }
            });
            
            // Запуск
            initEditor();
            loadChat();
            connectWs();
            setInterval(loadChat, 5000);
            setInterval(() => { if(!ws || ws.readyState !== WebSocket.OPEN) loadUsersRest(); }, 10000);
        </script>
    </body>
    </html>
}