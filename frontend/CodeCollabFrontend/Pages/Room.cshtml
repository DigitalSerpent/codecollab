@page "/room/{id}"
@using Microsoft.EntityFrameworkCore
@using CodeCollabFrontend.Models
@inject AppDbContext _context
@using Microsoft.AspNetCore.Http

@{
    #nullable disable
    if (!int.TryParse((string)RouteData.Values["id"], out int roomId))
    {
        <h2 style="color: white;">Неверный ID комнаты</h2>
        return;
    }

    var room = _context.Rooms
        .Include(r => r.RoomParticipants)
            .ThenInclude(rp => rp.User)
        .FirstOrDefault(r => r.Id == roomId);
    
    var userId = HttpContext.Session.GetInt32("UserId");
    var currentUser = userId != null ? _context.Users.Find(userId) : null;
}

@if (room == null)
{
    <h2 style="color: white;">Комната не найдена</h2>
}
else
{
    Layout = null;
    
    <!DOCTYPE html>
    <html>
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
        <title>@room.Name - CodeCollab</title>
        <style>
            /* Сброс всех стилей */
            html, body {
                margin: 0 !important;
                padding: 0 !important;
                width: 100% !important;
                height: 100% !important;
                overflow: hidden !important;
                background: #0a0e1c !important;
                font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif !important;
                position: fixed !important;
                top: 0 !important;
                left: 0 !important;
                right: 0 !important;
                bottom: 0 !important;
            }
            
            /* Контейнер */
            .room-container {
                position: fixed !important;
                top: 0 !important;
                left: 0 !important;
                right: 0 !important;
                bottom: 0 !important;
                display: flex !important;
                flex-direction: column !important;
                padding: 12px !important;
                gap: 12px !important;
                background: #0a0e1c !important;
