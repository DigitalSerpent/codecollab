@page "/room/{id}"
@using Microsoft.EntityFrameworkCore
@using CodeCollabFrontend.Models
@inject AppDbContext _context
@using Microsoft.AspNetCore.Http

@{
    #nullable disable
    if (!int.TryParse((string)RouteData.Values["id"], out int roomId))
    {
        <h2 style="color: white;">Неверный ID комнаты</h2>
        return;
    }

    var room = _context.Rooms
        .Include(r => r.RoomParticipants)
            .ThenInclude(rp => rp.User)
        .FirstOrDefault(r => r.Id == roomId);
    
    var userId = HttpContext.Session.GetInt32("UserId");
    var currentUser = userId != null ? _context.Users.Find(userId) : null;
}

@if (room == null)
{
    <h2 style="color: white;">Комната не найдена</h2>
}
else
{
    ViewData["Title"] = room.Name;

    <!DOCTYPE html>
    <html>
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
        <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }
            
            body {
                background: #0a0e1c;
                font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
                height: 100vh;
                overflow: hidden;
                position: fixed;
                top: 0;
                left: 0;
                right: 0;
                bottom: 0;
            }
            
            /* Главный контейнер - занимает весь экран */
            .app {
                height: 100vh;
                display: flex;
                flex-direction: column;
                padding: 10px;
                gap: 10px;
            }
            
            /* Контентная область - растягивается */
            .main-content {
                flex: 1;
                display: flex;
                gap: 10px;
                min-height: 0;
                overflow: hidden;
            }
            
            /* Левая панель файлов */
            .files-panel {
                width: 200px;
                background: #0d0d1a;
                border: 1px solid #00aaff;
                border-radius: 8px;
                display: flex;
                flex-direction: column;
                overflow: hidden;
                flex-shrink: 0;
            }
            
            .files-header {
                padding: 10px;
                background: #121628;
                border-bottom: 1px solid #00aaff;
                color: white;
                font-weight: bold;
                font-size: 13px;
            }
            
            .file-list {
                flex: 1;
                overflow-y: auto;
                padding: 5px;
            }
            
            .file-item {
                padding: 8px;
                cursor: pointer;
                border-radius: 4px;
                margin-bottom: 2px;
                color: #ccc;
                font-size: 12px;
                display: flex;
                align-items: center;
                gap: 8px;
            }
            
            .file-item:hover {
                background: #1e1e3a;
            }
            
            .file-item.active {
                background: #0d3d5c;
                color: white;
            }
            
            .new-file-btn {
                margin: 8px;
                padding: 8px;
                background: #00aaff;
                border: none;
                border-radius: 4px;
                color: #0a0e1c;
                cursor: pointer;
                font-size: 12px;
            }
            
            /* Центральная область с редактором */
            .editor-area {
                flex: 1;
                display: flex;
                flex-direction: column;
                min-width: 0;
                background: #0d0d1a;
                border: 1px solid #00aaff;
                border-radius: 8px;
                overflow: hidden;
            }
            
            .tabs-bar {
                display: flex;
                background: #121628;
                border-bottom: 1px solid #00aaff;
                overflow-x: auto;
                padding: 0 5px;
                gap: 2px;
                flex-shrink: 0;
            }
            
            .tab {
                padding: 8px 12px;
                background: #0d0d1a;
                color: #ccc;
                cursor: pointer;
                font-size: 12px;
                display: flex;
                align-items: center;
                gap: 6px;
                border-right: 1px solid #1e1e3a;
                white-space: nowrap;
            }
            
            .tab.active {
                background: #1e1e3a;
                color: white;
                border-bottom: 2px solid #00aaff;
            }
            
            .tab-close {
                margin-left: 6px;
                cursor: pointer;
                opacity: 0.6;
            }
            
            .tab-close:hover {
                opacity: 1;
            }
            
            .editor-toolbar {
                display: flex;
                justify-content: space-between;
                align-items: center;
                padding: 8px;
                background: #121628;
                border-bottom: 1px solid #00aaff;
                flex-shrink: 0;
                gap: 10px;
            }
            
            .language-select {
                background: #0d0d1a;
                color: white;
                border: 1px solid #00aaff;
                border-radius: 4px;
                padding: 5px 8px;
                font-size: 12px;
            }
            
            .run-btn {
                background: #00aaff;
                color: #0a0e1c;
                border: none;
                border-radius: 4px;
                padding: 5px 12px;
                cursor: pointer;
                font-size: 12px;
            }
            
            #editorContainer {
                flex: 1;
                min-height: 0;
            }
            
            .terminal {
                height: 150px;
                background: #1e1e1e;
                border-top: 1px solid #00aaff;
                display: flex;
                flex-direction: column;
                flex-shrink: 0;
            }
            
            .terminal-header {
                padding: 6px 10px;
                background: #2d2d2d;
                color: white;
                font-size: 11px;
                display: flex;
                justify-content: space-between;
                align-items: center;
            }
            
            .terminal-output {
                flex: 1;
                overflow-y: auto;
                padding: 8px;
                color: #ccc;
                font-family: monospace;
                font-size: 11px;
                white-space: pre-wrap;
            }
            
            .terminal-input-line {
                display: flex;
                padding: 6px 8px;
                background: #1e1e1e;
                border-top: 1px solid #3c3c3c;
            }
            
            .terminal-prompt {
                color: #00aaff;
                margin-right: 6px;
            }
            
            .terminal-input {
                flex: 1;
                background: none;
                border: none;
                color: #ccc;
                outline: none;
                font-family: monospace;
                font-size: 11px;
            }
            
            /* Правая панель чата */
            .chat-panel {
                width: 260px;
                background: #0d0d1a;
                border: 1px solid #00aaff;
                border-radius: 8px;
                display: flex;
                flex-direction: column;
                overflow: hidden;
                flex-shrink: 0;
            }
            
            .chat-header {
                padding: 10px;
                background: #121628;
                border-bottom: 1px solid #00aaff;
                color: white;
                font-weight: bold;
                font-size: 13px;
            }
            
            .chat-messages {
                flex: 1;
                overflow-y: auto;
                padding: 10px;
                display: flex;
                flex-direction: column;
                gap: 8px;
            }
            
            .message {
                max-width: 85%;
                padding: 6px 10px;
                border-radius: 10px;
                font-size: 12px;
                word-wrap: break-word;
            }
            
            .message.me {
                background: #b198b3;
                color: #0a0e1c;
                align-self: flex-end;
            }
            
            .message.other {
                background: #86a1b5;
                color: white;
                align-self: flex-start;
            }
            
            .chat-input-area {
                padding: 10px;
                border-top: 1px solid #00aaff;
                display: flex;
                gap: 8px;
            }
            
            .chat-input {
                flex: 1;
                padding: 8px;
                background: #0a0e1c;
                border: 1px solid #1e1e3a;
                color: white;
                border-radius: 6px;
                resize: none;
                font-size: 12px;
                font-family: inherit;
            }
            
            .send-btn {
                padding: 8px 12px;
                background: #00aaff;
                border: none;
                border-radius: 6px;
                cursor: pointer;
                color: #0a0e1c;
            }
            
            /* Нижняя панель с иконками */
            .bottom-panel {
                display: flex;
                justify-content: space-between;
                align-items: center;
                flex-shrink: 0;
                gap: 10px;
            }
            
            .icon-btn {
                width: 44px;
                height: 44px;
                background: #121628;
                border: 1px solid #00aaff;
                border-radius: 8px;
                display: flex;
                align-items: center;
                justify-content: center;
                cursor: pointer;
                color: #a0a0a0;
                font-size: 18px;
                transition: all 0.2s;
            }
            
            .icon-btn:hover {
                background: #1e1e3a;
                color: #00aaff;
                transform: scale(1.05);
            }
            
            /* Модальные окна */
            .modal {
                display: none;
                position: fixed;
                top: 0;
                left: 0;
                right: 0;
                bottom: 0;
                background: rgba(0,0,0,0.8);
                z-index: 1000;
                align-items: center;
                justify-content: center;
            }
            
            .modal-content {
                background: #121628;
                border-radius: 12px;
                padding: 24px;
                width: 320px;
                border: 1px solid #00aaff;
                text-align: center;
            }
            
            .modal-content h3 {
                color: white;
                margin-bottom: 20px;
            }
            
            .modal-buttons {
                display: flex;
                gap: 10px;
                margin-top: 20px;
            }
            
            .modal-btn {
                flex: 1;
                padding: 10px;
                border: none;
                border-radius: 6px;
                cursor: pointer;
                font-size: 14px;
            }
            
            .modal-btn.cancel {
                background: #1e1e3a;
                color: white;
            }
            
            .modal-btn.confirm {
                background: #00aaff;
                color: #0a0e1c;
            }
            
            .floating-panel {
                display: none;
                position: fixed;
                bottom: 70px;
                left: 20px;
                width: 280px;
                background: #121628;
                border: 1px solid #00aaff;
                border-radius: 10px;
                padding: 15px;
                z-index: 200;
                max-height: 400px;
                overflow-y: auto;
            }
            
            .floating-panel.right {
                left: auto;
                right: 20px;
            }
            
            .floating-panel h4 {
                color: white;
                margin-bottom: 12px;
                display: flex;
                justify-content: space-between;
            }
            
            .participant {
                display: flex;
                align-items: center;
                gap: 10px;
                padding: 8px;
                cursor: pointer;
                border-radius: 6px;
                margin-bottom: 5px;
            }
            
            .participant:hover {
                background: #1e1e3a;
            }
            
            .participant-avatar {
                width: 32px;
                height: 32px;
                border-radius: 50%;
                background: #1e1e3a;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 18px;
            }
            
            .participant-name {
                flex: 1;
                color: white;
                font-size: 13px;
            }
            
            .participant-status {
                width: 8px;
                height: 8px;
                border-radius: 50%;
            }
            
            .notification {
                position: fixed;
                top: 20px;
                right: 20px;
                padding: 10px 16px;
                border-radius: 6px;
                z-index: 10000;
                font-size: 13px;
                animation: slideIn 0.3s ease;
            }
            
            @@keyframes slideIn {
                from { transform: translateX(100%); opacity: 0; }
                to { transform: translateX(0); opacity: 1; }
            }
        </style>
    </head>
    <body>
        <div class="app">
            @if (userId == room.OwnerId)
            {
                <div style="background: #0a0e1c; padding: 10px; border-radius: 6px; flex-shrink: 0;">
                    <div style="display: flex; gap: 8px;">
                        <input id="inviteLink" type="text" readonly value="@($"{Request.Scheme}://{Request.Host}/room/join/{room.InviteToken}")" 
                               style="flex: 1; background: #121628; border: 1px solid #1e1e3a; color: white; border-radius: 4px; padding: 6px; font-size: 11px;">
                        <button onclick="copyInviteLink()" style="background: #00aaff; border: none; border-radius: 4px; padding: 6px 12px; cursor: pointer;">Копировать</button>
                    </div>
                </div>
            }
            
            <div class="main-content">
                <!-- Левая панель файлов -->
                <div class="files-panel">
                    <div class="files-header">
                        <i class="fas fa-folder"></i> Файлы
                    </div>
                    <div id="fileList" class="file-list"></div>
                    <button class="new-file-btn" onclick="createNewFile()">
                        <i class="fas fa-plus"></i> Новый файл
                    </button>
                </div>
                
                <!-- Центральная область -->
                <div class="editor-area">
                    <div class="tabs-bar" id="tabsBar"></div>
                    <div class="editor-toolbar">
                        <select id="languageSelect" class="language-select">
                            <option value="python">Python</option>
                            <option value="javascript">JavaScript</option>
                            <option value="html">HTML</option>
                            <option value="css">CSS</option>
                        </select>
                        <button class="run-btn" onclick="runCode()">
                            <i class="fas fa-play"></i> Запустить
                        </button>
                    </div>
                    <div id="editorContainer"></div>
                    <div class="terminal">
                        <div class="terminal-header">
                            <span><i class="fas fa-terminal"></i> Терминал</span>
                            <button onclick="toggleTerminal()" style="background: none; border: none; color: #ccc; cursor: pointer;">▲</button>
                        </div>
                        <div id="terminalOutput" class="terminal-output">$ Готов к работе\n</div>
                        <div class="terminal-input-line">
                            <span class="terminal-prompt">$</span>
                            <input type="text" id="terminalInput" class="terminal-input" placeholder="Введите команду...">
                        </div>
                    </div>
                </div>
                
                <!-- Правая панель чата -->
                <div class="chat-panel">
                    <div class="chat-header">
                        <i class="fas fa-comments"></i> Чат
                    </div>
                    <div id="chatMessages" class="chat-messages"></div>
                    <div class="chat-input-area">
                        <input type="text" id="chatInput" class="chat-input" placeholder="Сообщение...">
                        <button class="send-btn" onclick="sendMessage()">
                            <i class="fas fa-paper-plane"></i>
                        </button>
                    </div>
                </div>
            </div>
            
            <!-- Нижняя панель -->
            <div class="bottom-panel">
                <div class="icon-btn" onclick="toggleUsers()">
                    <i class="fas fa-users"></i>
                </div>
                <div class="icon-btn" onclick="openExitModal()">
                    <i class="fas fa-sign-out-alt"></i>
                </div>
            </div>
        </div>
        
        <!-- Модальные окна -->
        <div id="usersPanel" class="floating-panel">
            <h4>Участники <span onclick="closeUsers()" style="cursor:pointer;">✖</span></h4>
            <div id="usersList"></div>
        </div>
        
        <div id="exitModal" class="modal">
            <div class="modal-content">
                <h3>Выйти из комнаты?</h3>
                <div class="modal-buttons">
                    <button class="modal-btn cancel" onclick="closeExitModal()">Отмена</button>
                    <button class="modal-btn confirm" onclick="exitRoom()">Выйти</button>
                </div>
            </div>
        </div>

        <script src="https://cdnjs.cloudflare.com/ajax/libs/monaco-editor/0.34.1/min/vs/loader.js"></script>
        <script>
            // Данные комнаты
            const roomId = @roomId;
            const userId = @(userId ?? 0);
            const userName = "@(currentUser?.Name ?? "Гость")";
            
            // Глобальные переменные
            let editor = null;
            let currentFileId = null;
            let openTabs = [];
            let saveTimeout = null;
            
            // WebSocket (опционально)
            let ws = null;
            
            // ========== Утилиты ==========
            function showNotification(msg, isError = false) {
                const notif = document.createElement('div');
                notif.className = 'notification';
                notif.style.background = isError ? '#c62828' : '#2e7d32';
                notif.textContent = msg;
                document.body.appendChild(notif);
                setTimeout(() => notif.remove(), 3000);
            }
            
            function copyInviteLink() {
                const input = document.getElementById('inviteLink');
                if (input) {
                    input.select();
                    document.execCommand('copy');
                    showNotification('Ссылка скопирована');
                }
            }
            
            function getFileIcon(filename) {
                const ext = filename.split('.').pop().toLowerCase();
                const icons = {
                    'py': '<i class="fab fa-python"></i>',
                    'js': '<i class="fab fa-js"></i>',
                    'html': '<i class="fab fa-html5"></i>',
                    'css': '<i class="fab fa-css3-alt"></i>',
                    'json': '<i class="fas fa-brackets-curly"></i>',
                    'md': '<i class="fas fa-markdown"></i>',
                    'txt': '<i class="fas fa-file-alt"></i>'
                };
                return icons[ext] || '<i class="fas fa-file-code"></i>';
            }
            
            function getLanguage(filename) {
                const ext = filename.split('.').pop().toLowerCase();
                const map = {
                    'py': 'python',
                    'js': 'javascript',
                    'html': 'html',
                    'css': 'css',
                    'json': 'json',
                    'md': 'markdown',
                    'txt': 'text'
                };
                return map[ext] || 'text';
            }
            
            // ========== Работа с файлами ==========
            async function loadFiles() {
                try {
                    const res = await fetch(`/api/room/${roomId}/file`);
                    const files = await res.json();
                    const container = document.getElementById('fileList');
                    if (!container) return;
                    
                    container.innerHTML = '';
                    for (const file of files) {
                        const div = document.createElement('div');
                        div.className = 'file-item' + (currentFileId === file.id ? ' active' : '');
                        div.innerHTML = `${getFileIcon(file.name)} <span style="flex:1;">${escapeHtml(file.name)}</span>`;
                        div.onclick = () => openFile(file.id, file.name);
                        container.appendChild(div);
                    }
                } catch(e) {
                    console.error('Error loading files:', e);
                }
            }
            
            async function openFile(id, name) {
                try {
                    const res = await fetch(`/api/room/${roomId}/file/${id}`);
                    const file = await res.json();
                    
                    if (!openTabs.some(t => t.id === id)) {
                        openTabs.push({ id, name });
                    }
                    
                    currentFileId = id;
                    renderTabs();
                    loadFiles();
                    
                    if (editor) {
                        editor.setValue(file.content || '');
                        monaco.editor.setModelLanguage(editor.getModel(), getLanguage(name));
                    }
                    
                    localStorage.setItem(`lastFile_${roomId}`, id);
                } catch(e) {
                    showNotification('Ошибка открытия файла', true);
                }
            }
            
            async function saveCurrentFile() {
                if (!currentFileId || !editor) return;
                
                try {
                    const content = editor.getValue();
                    await fetch(`/api/room/${roomId}/file/${currentFileId}`, {
                        method: 'PUT',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ content })
                    });
                    console.log('File saved');
                } catch(e) {
                    console.error('Save error:', e);
                }
            }
            
            async function createNewFile() {
                let name = prompt('Имя файла (например, script.py):');
                if (!name) return;
                if (!name.includes('.')) name += '.txt';
                
                try {
                    const res = await fetch(`/api/room/${roomId}/file`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ name })
                    });
                    
                    if (res.ok) {
                        const file = await res.json();
                        await loadFiles();
                        await openFile(file.id, file.name);
                        showNotification(`Файл ${name} создан`);
                    }
                } catch(e) {
                    showNotification('Ошибка создания файла', true);
                }
            }
            
            function renderTabs() {
                const container = document.getElementById('tabsBar');
                if (!container) return;
                
                container.innerHTML = '';
                for (const tab of openTabs) {
                    const tabDiv = document.createElement('div');
                    tabDiv.className = 'tab' + (currentFileId === tab.id ? ' active' : '');
                    tabDiv.innerHTML = `
                        ${getFileIcon(tab.name)}
                        <span>${escapeHtml(tab.name)}</span>
                        <span class="tab-close" onclick="event.stopPropagation(); closeTab(${tab.id})">✖</span>
                    `;
                    tabDiv.onclick = () => openFile(tab.id, tab.name);
                    container.appendChild(tabDiv);
                }
            }
            
            async function closeTab(fileId) {
                const index = openTabs.findIndex(t => t.id === fileId);
                if (index === -1) return;
                
                openTabs.splice(index, 1);
                
                if (currentFileId === fileId) {
                    if (openTabs.length > 0) {
                        await openFile(openTabs[0].id, openTabs[0].name);
                    } else {
                        currentFileId = null;
                        if (editor) editor.setValue('');
                        loadFiles();
                    }
                }
                renderTabs();
            }
            
            // ========== Чат ==========
            async function loadChat() {
                try {
                    const res = await fetch(`/api/chat/${roomId}`);
                    const messages = await res.json();
                    const container = document.getElementById('chatMessages');
                    if (!container) return;
                    
                    container.innerHTML = '';
                    for (const msg of messages) {
                        const div = document.createElement('div');
                        div.className = `message ${msg.userId === userId ? 'me' : 'other'}`;
                        div.innerHTML = msg.userId === userId ? msg.text : `<b>${escapeHtml(msg.userName)}:</b> ${escapeHtml(msg.text)}`;
                        container.appendChild(div);
                    }
                    container.scrollTop = container.scrollHeight;
                } catch(e) {}
            }
            
            function sendMessage() {
                const input = document.getElementById('chatInput');
                const text = input.value.trim();
                if (!text) return;
                
                fetch('/api/chat/send', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ roomId, userId, userName, text })
                }).then(() => {
                    input.value = '';
                    loadChat();
                });
            }
            
            // ========== Участники через REST API ==========
            async function loadUsers() {
                try {
                    const res = await fetch(`/api/room/${roomId}/users`);
                    const users = await res.json();
                    const container = document.getElementById('usersList');
                    if (!container) return;
                    
                    container.innerHTML = '';
                    for (const user of users) {
                        const div = document.createElement('div');
                        div.className = 'participant';
                        div.onclick = () => window.location.href = `/Profile?id=${user.user_id || user.id}`;
                        div.innerHTML = `
                            <div class="participant-avatar">${user.avatar || '👤'}</div>
                            <div class="participant-name">${escapeHtml(user.name)} ${user.user_id === userId ? '(Вы)' : ''}</div>
                            <div class="participant-status" style="background: ${user.online !== false ? '#4CAF50' : '#888'}"></div>
                        `;
                        container.appendChild(div);
                    }
                } catch(e) {
                    console.error('Error loading users:', e);
                }
            }
            
            function toggleUsers() {
                const panel = document.getElementById('usersPanel');
                if (panel.style.display === 'none' || !panel.style.display) {
                    panel.style.display = 'block';
                    loadUsers();
                } else {
                    panel.style.display = 'none';
                }
            }
            
            function closeUsers() {
                document.getElementById('usersPanel').style.display = 'none';
            }
            
            // ========== Терминал и запуск кода ==========
            function runCode() {
                if (!editor) return;
                
                const code = editor.getValue();
                const lang = document.getElementById('languageSelect').value;
                const output = document.getElementById('terminalOutput');
                
                output.innerHTML += `\n$ Запуск ${lang}...\n`;
                
                fetch('/api/terminal/run', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ command: JSON.stringify({ language: lang, code }) })
                })
                .then(r => r.json())
                .then(data => {
                    output.innerHTML += (data.output || data.error || 'Выполнено\n');
                    output.scrollTop = output.scrollHeight;
                });
            }
            
            function toggleTerminal() {
                const terminal = document.querySelector('.terminal');
                const btn = terminal.querySelector('.terminal-header button');
                if (terminal.style.height === '30px') {
                    terminal.style.height = '150px';
                    btn.innerHTML = '▲';
                } else {
                    terminal.style.height = '30px';
                    btn.innerHTML = '▼';
                }
            }
            
            // ========== Выход ==========
            function openExitModal() {
                document.getElementById('exitModal').style.display = 'flex';
            }
            
            function closeExitModal() {
                document.getElementById('exitModal').style.display = 'none';
            }
            
            async function exitRoom() {
                if (currentFileId && editor) {
                    await saveCurrentFile();
                }
                window.location.href = '/dashboard';
            }
            
            // ========== Инициализация редактора ==========
            function initEditor() {
                const container = document.getElementById('editorContainer');
                if (!container) return;
                
                require.config({ paths: { vs: 'https://cdnjs.cloudflare.com/ajax/libs/monaco-editor/0.34.1/min/vs' } });
                require(['vs/editor/editor.main'], function() {
                    editor = monaco.editor.create(container, {
                        value: '// Откройте или создайте файл\n',
                        language: 'javascript',
                        theme: 'vs-dark',
                        automaticLayout: true,
                        fontSize: 13,
                        minimap: { enabled: false }
                    });
                    
                    editor.onDidChangeModelContent(() => {
                        if (saveTimeout) clearTimeout(saveTimeout);
                        saveTimeout = setTimeout(saveCurrentFile, 1000);
                    });
                    
                    loadFiles();
                    
                    const lastFileId = localStorage.getItem(`lastFile_${roomId}`);
                    if (lastFileId) {
                        fetch(`/api/room/${roomId}/file/${lastFileId}`)
                            .then(res => res.json())
                            .then(file => {
                                if (file && file.name) openFile(lastFileId, file.name);
                            });
                    }
                });
            }
            
            function escapeHtml(text) {
                const div = document.createElement('div');
                div.textContent = text;
                return div.innerHTML;
            }
            
            // Обработчики событий
            document.getElementById('chatInput')?.addEventListener('keypress', e => {
                if (e.key === 'Enter') sendMessage();
            });
            
            document.getElementById('terminalInput')?.addEventListener('keypress', e => {
                if (e.key === 'Enter') {
                    const input = e.target;
                    const cmd = input.value;
                    input.value = '';
                    const output = document.getElementById('terminalOutput');
                    output.innerHTML += `\n$ ${cmd}\n`;
                    
                    fetch('/api/terminal/run', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ command: JSON.stringify({ language: 'bash', code: cmd }) })
                    })
                    .then(r => r.json())
                    .then(data => {
                        output.innerHTML += (data.output || data.error || '');
                        output.scrollTop = output.scrollHeight;
                    });
                }
            });
            
            // Запуск
            initEditor();
            loadChat();
            setInterval(loadChat, 5000);
            setInterval(loadUsers, 10000);
        </script>
    </body>
    </html>
}