@page "/room/{id}"
@model RoomModel
@{
    var roomId = (string)RouteData.Values["id"];
}
<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="utf-8" />
<title>Комната @roomId</title>
<style>
html, body { height: 100%; margin: 0; font-family: Arial, sans-serif; display: flex; flex-direction: column; background: #1e1e1e; color: #ccc; }
#header { background: #333; color: #fff; padding: 8px 12px; display: flex; justify-content: space-between; align-items: center; }
#main { flex: 1; display: flex; overflow: hidden; }
#sidebar { width: 220px; background: #252526; display: flex; flex-direction: column; border-right: 1px solid #3e3e42; }
#fileTree { flex: 1; padding: 8px; overflow-y: auto; }
#fileTree button { display: block; width: 100%; margin-bottom: 4px; background: #2d2d30; color: #ccc; border: none; padding: 6px; text-align: left; cursor: pointer; }
#fileTree button:hover { background: #3e3e42; }
#tabs { display: flex; background: #2d2d30; border-bottom: 1px solid #3e3e42; overflow-x: auto; }
.tab { padding: 6px 12px; cursor: pointer; background: #2d2d30; border-right: 1px solid #3e3e42; white-space: nowrap; }
.tab.active { background: #1e1e1e; border-bottom: 2px solid #007acc; }
.tab .close { margin-left: 8px; cursor: pointer; color: #ccc; }
#editorContainer { flex: 1; display: flex; flex-direction: column; }
#editor { flex: 1; }
#bottomPanel { display: flex; height: 200px; border-top: 1px solid #3e3e42; }
#chat { width: 30%; background: #252526; display: flex; flex-direction: column; border-right: 1px solid #3e3e42; }
#chatHistory { flex: 1; padding: 5px; overflow-y: auto; font-size: 12px; }
#chatInputPanel { display: flex; padding: 5px; gap: 5px; }
#chatInput { flex: 1; resize: none; background: #1e1e1e; color: #ccc; border: 1px solid #3e3e42; }
#terminal { flex: 1; display: flex; flex-direction: column; background: #1e1e1e; }
#terminalOutput { flex: 1; padding: 5px; overflow-y: auto; font-family: monospace; font-size: 12px; color: #0f0; }
.terminal-line { display: flex; align-items: center; padding: 2px 5px; }
.terminal-prompt { color: #0f0; margin-right: 8px; }
#terminalInput { background: none; border: none; color: #0f0; font-family: monospace; flex: 1; outline: none; }
#bottomButtons { display: flex; gap: 10px; margin-right: 10px; }
button { cursor: pointer; background: #3e3e42; color: #fff; border: none; padding: 4px 8px; border-radius: 4px; }
button:hover { background: #007acc; }
.modal { display: none; position: fixed; top: 20%; left: 50%; transform: translateX(-50%); background: #2d2d30; border: 1px solid #007acc; padding: 16px; z-index: 1000; width: 300px; }
.modal.show { display: block; }
.overlay { display: none; position: fixed; top:0; left:0; right:0; bottom:0; background: rgba(0,0,0,0.5); z-index: 999; }
.overlay.show { display: block; }
</style>
</head>
<body>
<div id="header">
    <span>Комната: @roomId</span>
    <div id="bottomButtons">
        <button id="btnParticipants">👥 Участники</button>
        <button id="btnSettings">⚙️ Настройки</button>
        <button id="btnExit">🚪 Выйти</button>
    </div>
</div>
<div id="main">
    <div id="sidebar">
        <div id="fileTree"></div>
        <button id="btnNewFile">+ Новый файл</button>
    </div>
    <div id="editorContainer">
        <div id="tabs"></div>
        <div id="editor"></div>
    </div>
</div>
<div id="bottomPanel">
    <div id="chat">
        <div id="chatHistory"></div>
        <div id="chatInputPanel">
            <textarea id="chatInput" rows="2" placeholder="Сообщение..."></textarea>
            <button id="btnSend">➤</button>
        </div>
    </div>
    <div id="terminal">
        <div id="terminalOutput"></div>
        <div class="terminal-line">
            <span class="terminal-prompt">$</span>
            <input type="text" id="terminalInput" placeholder="команда..." />
        </div>
    </div>
</div>

<div class="overlay" id="modalOverlay"></div>
<div id="participantsModal" class="modal">
    <h3 style="margin:0 0 10px 0">Участники</h3>
    <ul id="participantsList" style="max-height:200px; overflow:auto;"></ul>
    <button id="closeParticipants">Закрыть</button>
</div>

<script src="https://cdn.jsdelivr.net/npm/monaco-editor@0.40.0/min/vs/loader.js"></script>
<script>
    const roomId = "@roomId";
    let editor;
    let currentFile = null;
    let openFiles = {};

    require.config({ paths: { vs: 'https://cdn.jsdelivr.net/npm/monaco-editor@0.40.0/min/vs' } });
    require(['vs/editor/editor.main'], function() {
        editor = monaco.editor.create(document.getElementById('editor'), {
            value: '',
            language: 'javascript',
            theme: 'vs-dark',
            automaticLayout: true
        });
        editor.onDidChangeModelContent(() => {
            if (currentFile) saveCurrentFile();
        });
    });

    async function saveCurrentFile() {
        if (!currentFile) return;
        await fetch(`/api/room/${roomId}/file/save`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ filename: currentFile, content: editor.getValue() })
        });
    }

    async function loadFileList() {
        const res = await fetch(`/api/room/${roomId}/file/list`);
        if (!res.ok) return [];
        const data = await res.json();
        return data.files || [];
    }

    async function loadFileContent(filename) {
        const res = await fetch(`/api/room/${roomId}/file/get?name=${encodeURIComponent(filename)}`);
        if (!res.ok) return '';
        const data = await res.json();
        return data.content || '';
    }

    async function refreshFileTree() {
        const files = await loadFileList();
        const container = document.getElementById('fileTree');
        container.innerHTML = '';
        files.forEach(f => {
            const btn = document.createElement('button');
            btn.textContent = f;
            btn.onclick = () => openFile(f);
            container.appendChild(btn);
        });
    }

    async function openFile(filename) {
        addTab(filename);
        currentFile = filename;
        const content = await loadFileContent(filename);
        editor.setValue(content);
        highlightActiveTab(filename);
    }

    function addTab(filename) {
        if (document.querySelector(`.tab[data-file="${filename}"]`)) return;
        const tabsDiv = document.getElementById('tabs');
        const tab = document.createElement('div');
        tab.className = 'tab';
        tab.dataset.file = filename;
        tab.innerHTML = `${filename} <span class="close" data-file="${filename}">✖</span>`;
        tab.querySelector('.close').onclick = (e) => {
            e.stopPropagation();
            closeTab(filename);
        };
        tab.onclick = () => openFile(filename);
        tabsDiv.appendChild(tab);
    }

    function highlightActiveTab(filename) {
        document.querySelectorAll('.tab').forEach(tab => {
            tab.classList.remove('active');
            if (tab.dataset.file === filename) tab.classList.add('active');
        });
    }

    async function closeTab(filename) {
        const tab = document.querySelector(`.tab[data-file="${filename}"]`);
        if (tab) tab.remove();
        if (currentFile === filename) {
            const firstTab = document.querySelector('.tab');
            if (firstTab) {
                await openFile(firstTab.dataset.file);
            } else {
                currentFile = null;
                editor.setValue('');
            }
        }
        await fetch(`/api/room/${roomId}/file/delete`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ filename })
        });
        refreshFileTree();
    }

    document.getElementById('btnNewFile').onclick = async () => {
        const name = prompt('Имя файла:', 'newfile.js');
        if (!name) return;
        const res = await fetch(`/api/room/${roomId}/file/create`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ name })
        });
        if (res.ok) {
            await refreshFileTree();
            await openFile(name);
        } else alert('Ошибка создания');
    };

    async function sendMessage() {
        const text = document.getElementById('chatInput').value.trim();
        if (!text) return;
        await fetch(`/api/room/${roomId}/chat/send`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ message: text })
        });
        document.getElementById('chatInput').value = '';
        loadChatHistory();
    }

    async function loadChatHistory() {
        const res = await fetch(`/api/room/${roomId}/chat/messages`);
        if (!res.ok) return;
        const data = await res.json();
        const container = document.getElementById('chatHistory');
        container.innerHTML = '';
        (data.messages || []).forEach(msg => {
            const div = document.createElement('div');
            div.innerHTML = `<b>${msg.sender}:</b> ${msg.message}`;
            container.appendChild(div);
        });
        container.scrollTop = container.scrollHeight;
    }

    function executeCommand() {
        const cmd = document.getElementById('terminalInput').value.trim();
        if (!cmd) return;
        const out = document.getElementById('terminalOutput');
        out.innerHTML += `<div>$ ${cmd}</div>`;
        document.getElementById('terminalInput').value = '';
        fetch(`/api/room/${roomId}/terminal/exec`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ command: cmd })
        })
        .then(res => res.json())
        .then(data => {
            if (data.output) out.innerHTML += `<div>${data.output}</div>`;
            out.scrollTop = out.scrollHeight;
        });
    }

    async function loadParticipants() {
        const res = await fetch(`/api/room/${roomId}/participants`);
        if (!res.ok) return;
        const data = await res.json();
        const list = document.getElementById('participantsList');
        list.innerHTML = '';
        (data.participants || []).forEach(p => {
            const li = document.createElement('li');
            li.textContent = p.name;
            list.appendChild(li);
        });
    }

    document.getElementById('btnParticipants').onclick = async () => {
        await loadParticipants();
        document.getElementById('participantsModal').classList.add('show');
        document.getElementById('modalOverlay').classList.add('show');
    };
    document.getElementById('closeParticipants').onclick = () => {
        document.getElementById('participantsModal').classList.remove('show');
        document.getElementById('modalOverlay').classList.remove('show');
    };
    document.getElementById('modalOverlay').onclick = () => {
        document.getElementById('participantsModal').classList.remove('show');
        document.getElementById('modalOverlay').classList.remove('show');
    };
    document.getElementById('btnSend').onclick = sendMessage;
    document.getElementById('terminalInput').addEventListener('keypress', e => { if(e.key === 'Enter') executeCommand(); });
    document.getElementById('btnExit').onclick = () => { if(confirm('Выйти из комнаты?')) window.location.href = '/'; };
    document.getElementById('btnSettings').onclick = () => alert('Настройки пока не реализованы');

    refreshFileTree();
    loadChatHistory();
    setInterval(loadChatHistory, 3000);
</script>
</body>
</html>