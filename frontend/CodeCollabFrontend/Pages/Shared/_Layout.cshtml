@using Microsoft.AspNetCore.Http
@using CodeCollabFrontend.Models
@inject AppDbContext _context

@{
    var userId = Context.Session.GetInt32("UserId");
    var currentUser = userId != null ? _context.Users.Find(userId) : null;
    string globalCursor = currentUser?.Cursor ?? "default";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Coco Hub</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CodeCollabFrontend.styles.css" asp-append-version="true" />
    <style id="globalCursorStyle"></style>
</head>
<body>
    <header style="background-color: #05070f; padding: 10px 30px; display: flex; align-items: center; justify-content: space-between; z-index: 1003; position: relative;">
        <div style="font-size: 2rem; font-weight: bold; color: white;">Code Collab</div>
        <div style="display: flex; align-items: center; gap: 15px;">
            <span style="color: white;">@(currentUser?.Name ?? "Гость")</span>
            <div style="width: 40px; height: 40px; border-radius: 50%; background-color: #121628; display: flex; align-items: center; justify-content: center; overflow: hidden; border: 1px solid #00aaff;">
                @if (!string.IsNullOrEmpty(currentUser?.Avatar) && !currentUser.Avatar.StartsWith("👤") && currentUser.Avatar.Contains("/uploads/"))
                {
                    <img src="@currentUser.Avatar" style="width: 100%; height: 100%; object-fit: cover;" />
                }
                else
                {
                    <span style="color: white; font-size: 1.2rem;">@(currentUser?.Avatar ?? "👤")</span>
                }
            </div>
        </div>
    </header>
    <div style="height: 2px; background: linear-gradient(to bottom, #00aaff, transparent); width: 100vw; position: relative; left: 0; z-index: 1002;"></div>
    <div style="margin-top: 20px; width: 100%; padding-left: 30px; padding-right: 30px;">
        <main role="main" class="pb-3">@RenderBody()</main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

@{
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString();
    bool isAuthPage = currentPage?.StartsWith("/Login") == true || currentPage?.StartsWith("/Register") == true;
    bool isRoom = currentPage?.StartsWith("/room") == true;
}
@if (!isRoom && !isAuthPage)
{
    <!-- Правая панель -->
    <div id="rightPanel" style="position: fixed; top: 0; right: 0; width: 50px; height: 100vh; background-color: #05070f; border-left: 1px solid #1e1e3a; transition: 0.3s; overflow: hidden; z-index: 999; color: #a0a0a0; font-size: 1rem; display: flex; flex-direction: column; align-items: center;"
         onmouseover="this.style.width='180px'; this.querySelectorAll('.panel-item').forEach(el => el.style.opacity='1');"
         onmouseout="this.style.width='50px'; this.querySelectorAll('.panel-item').forEach(el => el.style.opacity='0');">

        <div style="display: flex; flex-direction: column; justify-content: center; flex-grow: 1;">
            <a href="/Profile" class="panel-item" style="white-space: nowrap; opacity: 0; transition: 0.2s; margin: 15px 0; width: 100%; text-align: center; cursor: pointer; text-decoration: none;"
               onmouseover="this.style.color='#00aaff'; this.style.transform='scale(1.1)'; this.style.fontWeight='bold';"
               onmouseout="this.style.color='#a0a0a0'; this.style.transform='scale(1)'; this.style.fontWeight='normal';">Профиль</a>
            <a href="/CreateRoomPage" class="panel-item" style="white-space: nowrap; opacity: 0; transition: 0.2s; margin: 15px 0; width: 100%; text-align: center; cursor: pointer; text-decoration: none;"
               onmouseover="this.style.color='#00aaff'; this.style.transform='scale(1.1)'; this.style.fontWeight='bold';"
               onmouseout="this.style.color='#a0a0a0'; this.style.transform='scale(1)'; this.style.fontWeight='normal';">Создать комнату</a>
            <a href="/Settings" class="panel-item" style="white-space: nowrap; opacity: 0; transition: 0.2s; margin: 15px 0; width: 100%; text-align: center; cursor: pointer; text-decoration: none;"
               onmouseover="this.style.color='#00aaff'; this.style.transform='scale(1.1)'; this.style.fontWeight='bold';"
               onmouseout="this.style.color='#a0a0a0'; this.style.transform='scale(1)'; this.style.fontWeight='normal';">Настройки</a>
        </div>
        <div style="margin-bottom: 30px;">
            <div class="panel-item" style="white-space: nowrap; opacity: 0; transition: 0.2s; margin: 15px 0; width: 100%; text-align: center; cursor: pointer;"
                 onmouseover="this.style.color='#00aaff'; this.style.transform='scale(1.1)'; this.style.fontWeight='bold';"
                 onmouseout="this.style.color='#a0a0a0'; this.style.transform='scale(1)'; this.style.fontWeight='normal';"
                 onclick="logout()">
                Выйти
            </div>
        </div>
    </div>
}

    <script>
        function getHotspotForCursor(name, size) {
            return { x: 0, y: 0 };
        }

        function applyGlobalCursor() {
            const cursorData = localStorage.getItem('globalCursor');
            if (!cursorData || !cursorData.startsWith('svg:')) return;
            
            const parts = cursorData.split(' ');
            const name = parts[0].split(':')[1];
            const targetSize = parseInt(parts[1]) || 32;
            
            fetch(`/cursors/${name}.svg`)
                .then(response => response.text())
                .then(svgText => {
                    let resizedSvg = svgText
                        .replace(/width="\d+"/, `width="${targetSize}"`)
                        .replace(/height="\d+"/, `height="${targetSize}"`);
                    if (!resizedSvg.includes('viewBox')) {
                        resizedSvg = resizedSvg.replace('<svg', `<svg viewBox="0 0 ${targetSize} ${targetSize}"`);
                    }
                    const blob = new Blob([resizedSvg], { type: 'image/svg+xml' });
                    const url = URL.createObjectURL(blob);
                    
                    const hotspot = getHotspotForCursor(name, targetSize);
                    
                    let style = document.getElementById('globalCursorStyle');
                    if (!style) {
                        style = document.createElement('style');
                        style.id = 'globalCursorStyle';
                        document.head.appendChild(style);
                    }
                    style.textContent = `* { cursor: url('${url}') ${hotspot.x} ${hotspot.y}, auto !important; }`;
                    
                    setTimeout(() => URL.revokeObjectURL(url), 10000);
                })
                .catch(err => console.error('Ошибка загрузки курсора:', err));
        }
        
        applyGlobalCursor();
        window.addEventListener('storage', () => applyGlobalCursor());

        function logout() {
            fetch('/Logout', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            })
            .then(() => {
                window.location.href = '/Login';
            })
            .catch(() => {
                window.location.href = '/Login';
            });
        }
    </script>

    <!-- Глобальная анимация загрузки -->
    <div id="globalLoader" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(1, 6, 13, 0.95); z-index: 99999; backdrop-filter: blur(4px);">
        <div style="display: flex; align-items: center; justify-content: center; width: 100%; height: 100%;">
            <div style="text-align: center;">
                <canvas id="loaderCanvas" width="200" height="200" style="display: block; margin: 0 auto;"></canvas>
                <div style="color: #60a5fa; font-family: monospace; letter-spacing: 3px; font-size: 0.8rem; margin-top: 20px;">INITIALIZING SYSTEM</div>
            </div>
        </div>
    </div>

    <script>
        (function() {
            let loader = document.getElementById('globalLoader');
            let canvas = document.getElementById('loaderCanvas');
            let ctx = canvas.getContext('2d');
            let time = 0;
            let animFrame = null;
            let isActive = false;
            let pendingTimeout = null;
            
            function draw() {
                if (!isActive) return;
                animFrame = requestAnimationFrame(draw);
                time += 0.016;
                ctx.clearRect(0, 0, 200, 200);
                const cx = 100, cy = 100;
                for (let i = 0; i < 4; i++) {
                    ctx.beginPath();
                    ctx.ellipse(cx, cy, 70 + i * 20, 50 + i * 15, time * 0.3 * (i + 1), 0, Math.PI * 2);
                    ctx.strokeStyle = `rgba(59, 130, 246, ${0.2 - i * 0.03})`;
                    ctx.lineWidth = 1.5;
                    ctx.stroke();
                }
                ctx.beginPath();
                ctx.arc(cx, cy, 15 + Math.sin(time * 4) * 4, 0, Math.PI * 2);
                ctx.fillStyle = `rgba(59, 130, 246, 0.4)`;
                ctx.fill();
                ctx.beginPath();
                ctx.arc(cx, cy, 8 + Math.sin(time * 5) * 3, 0, Math.PI * 2);
                ctx.fillStyle = `rgba(96, 165, 250, 0.9)`;
                ctx.fill();
                for (let i = 0; i < 50; i++) {
                    const angle = time * 1.2 + i * 0.5;
                    const r = 85 + Math.sin(time * 1.5 + i) * 15;
                    const x = cx + Math.cos(angle) * r;
                    const y = cy + Math.sin(angle * 0.8) * r * 0.7;
                    ctx.beginPath();
                    ctx.arc(x, y, 1.2, 0, Math.PI * 2);
                    ctx.fillStyle = `rgba(59, 130, 246, 0.7)`;
                    ctx.fill();
                }
            }
            
            function start() {
                if (isActive) return;
                isActive = true;
                loader.style.display = 'block';
                canvas.width = 200;
                canvas.height = 200;
                time = 0;
                draw();
            }
            
            function stop() {
                isActive = false;
                if (animFrame) cancelAnimationFrame(animFrame);
                animFrame = null;
                loader.style.display = 'none';
            }
            
            function showWithDelay() {
                if (pendingTimeout) clearTimeout(pendingTimeout);
                pendingTimeout = setTimeout(() => {
                    start();
                }, 300);
            }
            
            function hideNow() {
                if (pendingTimeout) {
                    clearTimeout(pendingTimeout);
                    pendingTimeout = null;
                }
                stop();
            }
            
            window.showLoader = showWithDelay;
            window.hideLoader = hideNow;
            
            start();
            
            window.addEventListener('load', () => {
                setTimeout(hideNow, 100);
            });
            
            document.addEventListener('click', (e) => {
                const link = e.target.closest('a');
                if (link && link.href && !link.href.startsWith('javascript:') && link.href.indexOf(window.location.origin) === 0) {
                    showWithDelay();
                }
            });
        })();
    </script>

    <!-- Система уведомлений -->
    <div id="notificationQueue" style="position: fixed; bottom: 20px; right: 20px; z-index: 9999; display: flex; flex-direction: column; gap: 10px; max-width: 350px;"></div>

    <script>
        let notificationQueue = [];
        let isProcessing = false;

        function showNotification(message, type = 'info', duration = 5000) {
            notificationQueue.push({ message, type, duration });
            processQueue();
        }

        function processQueue() {
            if (isProcessing || notificationQueue.length === 0) return;
            isProcessing = true;
            
            const notification = notificationQueue.shift();
            displayNotification(notification.message, notification.type, notification.duration);
            
            setTimeout(() => {
                isProcessing = false;
                processQueue();
            }, notification.duration);
        }

        function displayNotification(message, type, duration) {
            const container = document.getElementById('notificationQueue');
            const toast = document.createElement('div');
            
            let bgColor, icon;
            switch (type) {
                case 'success':
                    bgColor = '#00ff88';
                    icon = '✅';
                    break;
                case 'error':
                    bgColor = '#ff4444';
                    icon = '❌';
                    break;
                case 'warning':
                    bgColor = '#ffaa00';
                    icon = '⚠️';
                    break;
                default:
                    bgColor = '#00aaff';
                    icon = 'ℹ️';
            }
            
            toast.style.background = '#121628';
            toast.style.borderLeft = `4px solid ${bgColor}`;
            toast.style.borderRadius = '12px';
            toast.style.padding = '12px 15px';
            toast.style.color = 'white';
            toast.style.fontFamily = 'monospace';
            toast.style.fontSize = '0.85rem';
            toast.style.boxShadow = '0 0 20px rgba(0,170,255,0.3)';
            toast.style.backdropFilter = 'blur(8px)';
            toast.style.marginBottom = '10px';
            toast.style.display = 'flex';
            toast.style.alignItems = 'center';
            toast.style.gap = '10px';
            toast.style.opacity = '0';
            toast.style.transform = 'translateX(100%)';
            toast.style.transition = 'all 0.3s ease';
            
            toast.innerHTML = `
                <span style="font-size: 1.2rem;">${icon}</span>
                <span style="flex: 1;">${message}</span>
                <span style="cursor: pointer; color: #a0a0a0; font-size: 1rem;" onclick="this.parentElement.remove()">✖</span>
            `;
            
            container.appendChild(toast);
            
            setTimeout(() => {
                toast.style.opacity = '1';
                toast.style.transform = 'translateX(0)';
            }, 10);
            
            setTimeout(() => {
                toast.style.opacity = '0';
                toast.style.transform = 'translateX(100%)';
                setTimeout(() => toast.remove(), 300);
            }, duration);
        }

        window.showNotification = showNotification;
    </script>

</body>
</html>