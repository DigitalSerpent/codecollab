@page
@using Microsoft.EntityFrameworkCore
@using CodeCollabFrontend.Models
@inject AppDbContext _context

@{
    ViewData["Title"] = "Dashboard";

    // Получаем все комнаты с участниками
    var rooms = _context.Rooms
        .Include(r => r.RoomParticipants)
        .ThenInclude(rp => rp.User)
        .ToList();
}

<h2 style="color: white; margin-bottom: 30px;">Доступные комнаты</h2>

<div style="display: flex; gap: 30px; flex-wrap: wrap; justify-content: center; max-width: 1300px; margin: 0 auto; position: relative; z-index: 2;">

    @if (!rooms.Any())
    {
        <div style="text-align: center; color: white; margin-top: 50px; width: 100%;">
            <p style="font-size: 1.5rem; margin-bottom: 20px;">Создайте первую комнату</p>
            <span style="display: inline-block; width: 10px; height: 20px; background-color: #00aaff; animation: blink 1s infinite;"></span>
            <div style="margin-top: 30px;">
                <button onclick="openCreateRoomModal()" style="background-color: #00aaff; color: #0a0e1c; border: none; border-radius: 8px; padding: 12px 30px; font-size: 1rem; cursor: pointer;">
                    ➕ Создать комнату
                </button>
            </div>
        </div>
    }
    else
    {
        @foreach (var room in rooms)
        {
            var participants = room.RoomParticipants?.Select(rp => new
            {
                Name = rp.User?.Name ?? "Unknown",
                Online = rp.IsOnline,
                Avatar = rp.User?.Avatar ?? "👤",
                Cursor = rp.User?.Cursor ?? "⬤"
            }).ToList();

            var usersJson = System.Text.Json.JsonSerializer.Serialize(participants);

            <!-- Карточка комнаты -->
            <div style="background-color: #121628; border-radius: 20px; width: 240px; overflow: hidden; box-shadow: 0 4px 15px rgba(0,0,0,0.5); border: 1px solid #00aaff; cursor: pointer;"
                 onclick='openRoomModal("@room.Name", "@room.CreatedAt.ToString("dd.MM.yyyy")", "@room.MaxParticipants", @Html.Raw(usersJson), @room.Id)'>
                
                <div style="background-color: #0d0d1a; padding: 15px; font-family: 'Courier New', monospace; font-size: 8px; line-height: 1.2; color: #88c0d0; height: 120px; overflow: hidden;">
                    @(string.IsNullOrEmpty(room.PreviewCode) ? "// код не загружен" : room.PreviewCode)
                </div>
                
                <div style="padding: 15px;">
                    <h4 style="color: white; margin: 0 0 10px 0; font-weight: bold; font-size: 1.1rem;">@room.Name</h4>
                    <button style="background-color: #00aaff; color: #0a0e1c; border: none; border-radius: 8px; padding: 8px 15px; width: 100%; transition: 0.3s;"
                            onmouseover="this.style.backgroundColor='#ffffff'; this.style.boxShadow='0 0 20px #00aaff';"
                            onmouseout="this.style.backgroundColor='#00aaff'; this.style.boxShadow='none';">
                        Подробнее
                    </button>
                </div>
            </div>
        }
    }
</div>

<!-- Модальное окно информации о комнате -->
<div id="roomInfoModal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background-color: rgba(0,0,0,0.8); z-index: 2000; align-items: center; justify-content: center;">
    <div style="background-color: #121628; border-radius: 20px; padding: 30px; width: 600px; border: 1px solid #00aaff; box-shadow: 0 0 30px #00aaff; display: flex; gap: 30px;">
        
        <!-- Левая часть: список участников (прокручиваемый) -->
        <div style="flex: 1; max-height: 300px; overflow-y: auto; padding-right: 10px;">
            <h4 style="color: white; margin-bottom: 15px;">Участники</h4>
            <div id="participantList" style="color: white;"></div>
        </div>

        <!-- Правая часть: информация о комнате -->
        <div style="flex: 1;">
            <h4 id="roomName" style="color: white; margin-bottom: 15px;"></h4>
            <p id="roomDate" style="color: #a0a0a0; font-size: 0.9rem;"></p>
            <p id="roomParticipants" style="color: #a0a0a0; font-size: 0.9rem;"></p>
            <button onclick="enterRoomFromModal()" style="background-color: #00aaff; color: #0a0e1c; border: none; border-radius: 8px; padding: 10px; width: 100%; margin-top: 20px;">Войти в комнату</button>
            <button onclick="closeRoomModal()" style="background-color: #1e1e3a; color: white; border: none; border-radius: 8px; padding: 10px; width: 100%; margin-top: 10px;">Закрыть</button>
        </div>
    </div>
</div>

<style>
    @@keyframes blink {
        0%, 50% { opacity: 1; }
        51%, 100% { opacity: 0; }
    }
</style>

<script>
    let currentRoomId = 0;

    function openRoomModal(name, date, participants, users, roomId) {
        currentRoomId = roomId;
        document.getElementById('roomName').innerText = name;
        document.getElementById('roomDate').innerText = 'Создана: ' + date;
        document.getElementById('roomParticipants').innerText = 'Участников: ' + participants;

        // Заполняем список участников
        let listHtml = '';
        users.forEach(user => {
            listHtml += '<div style="display: flex; align-items: center; margin-bottom: 12px; gap: 8px;">';
            listHtml += '<span style="font-size: 1.2rem;">' + user.avatar + '</span>';
            listHtml += '<span style="color: white; font-size: 0.9rem; cursor: pointer;" onclick="goToProfile(\'' + user.name + '\')">' + user.name + '</span>';
            listHtml += '<span style="margin-left: auto; font-size: 1rem;" title="Курсор пользователя">' + user.cursor + '</span>';
            listHtml += '<span style="width: 8px; height: 8px; border-radius: 50%; background-color: ' + (user.online ? '#00ff00' : '#888') + ';"></span>';
            listHtml += '</div>';
        });
        document.getElementById('participantList').innerHTML = listHtml;

        document.getElementById('roomInfoModal').style.display = 'flex';
    }

    function closeRoomModal() {
        document.getElementById('roomInfoModal').style.display = 'none';
    }

    function goToProfile(name) {
        alert('Переход к профилю пользователя ' + name + ' (заглушка)');
    }

    function enterRoom(roomId) {
        window.location.href = '/room/' + roomId;
    }

    function enterRoomFromModal() {
        if (currentRoomId) {
            window.location.href = '/room/' + currentRoomId;
        } else {
            alert('Ошибка: комната не выбрана');
        }
    }
</script>