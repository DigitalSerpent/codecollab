@page
@using Microsoft.EntityFrameworkCore
@using CodeCollabFrontend.Models
@inject AppDbContext _context
@using Microsoft.AspNetCore.Http

@{
    #nullable disable
    ViewData["Title"] = "Dashboard";

    var userId = HttpContext.Session.GetInt32("UserId");
    
    if (userId == null)
    {
        HttpContext.Response.Redirect("/Login");
        return;
    }

    var rooms = _context.Rooms
        .Where(r => r.OwnerId == userId)
        .Include(r => r.RoomParticipants)
        .ThenInclude(rp => rp.User)
        .ToList();
}

@if (Request.Query.ContainsKey("deleted"))
{
    <script>
        if (typeof window.showNotification === 'function') {
            window.showNotification('Комната удалена', 'success');
        }
    </script>
}

<style>
    body {
        background: linear-gradient(135deg, #0a0e1c 0%, #121628 100%);
        margin: 0;
        padding: 0;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        min-height: 100vh;
    }

    .dashboard-container {
        max-width: 1400px;
        margin: 0 auto;
        padding: 20px;
    }

    h2 {
        color: white;
        margin-bottom: 30px;
        font-size: 28px;
        font-weight: 500;
    }

    .rooms-grid {
        display: flex;
        gap: 30px;
        flex-wrap: wrap;
        justify-content: center;
    }

    .room-card {
        background: rgba(18, 22, 40, 0.7);
        backdrop-filter: blur(8px);
        border-radius: 20px;
        border: 1px solid rgba(0, 170, 255, 0.3);
        transition: all 0.3s ease;
        width: 240px;
        overflow: hidden;
        cursor: pointer;
    }

    .room-card:hover {
        border-color: #00aaff;
        box-shadow: 0 0 20px rgba(0, 170, 255, 0.4);
        transform: translateY(-2px);
    }

    .preview {
        background: rgba(0, 0, 0, 0.5);
        padding: 15px;
        font-family: 'Courier New', monospace;
        font-size: 8px;
        line-height: 1.2;
        color: #88c0d0;
        height: 120px;
        overflow: hidden;
    }

    .card-content {
        padding: 15px;
    }

    .card-content h4 {
        color: white;
        margin: 0 0 10px 0;
        font-weight: bold;
        font-size: 1.1rem;
        word-wrap: break-word;
        overflow-wrap: break-word;
        white-space: normal;
    }

    .enter-button {
        width: 100%;
        background-color: #00aaff;
        color: #0a0e1c;
        border: none;
        border-radius: 8px;
        padding: 8px;
        cursor: pointer;
        transition: 0.3s;
    }

    .enter-button:hover {
        background-color: #ffffff;
        box-shadow: 0 0 20px #00aaff;
    }

    .empty-state {
        text-align: center;
        margin-top: 80px;
        width: 100%;
    }

    .empty-state p {
        font-size: 1.5rem;
        margin-bottom: 20px;
        color: #a0a0a0;
    }

    .empty-button {
        background-color: #00aaff;
        color: #0a0e1c;
        border: none;
        border-radius: 12px;
        padding: 12px 32px;
        font-size: 1.2rem;
        font-weight: bold;
        cursor: pointer;
        transition: 0.3s;
        animation: pulse 2s infinite;
    }

    .empty-button:hover {
        background-color: #ffffff;
        box-shadow: 0 0 20px #00aaff;
        transform: scale(1.02);
    }

    @@keyframes pulse {
        0% { box-shadow: 0 0 0 0 rgba(0, 170, 255, 0.4); }
        70% { box-shadow: 0 0 0 20px rgba(0, 170, 255, 0); }
        100% { box-shadow: 0 0 0 0 rgba(0, 170, 255, 0); }
    }

    .marquee {
        display: inline-block;
        animation: marquee 40s linear infinite;
        white-space: nowrap;
        padding-left: 100%;
    }

    .marquee:hover {
        animation-play-state: paused;
    }

    @@keyframes marquee {
        0% { transform: translateX(0); }
        100% { transform: translateX(-100%); }
    }
</style>

<div class="dashboard-container">
    <h2>Доступные комнаты</h2>

    <div class="rooms-grid">
        @if (!rooms.Any())
        {
            <div class="empty-state">
                <p>Создайте первую комнату</p>
                <div>
                    <button class="empty-button" onclick="openCreateRoomModal()">Создать комнату</button>
                </div>
            </div>
        }
        else
        {
            @foreach (var room in rooms)
            {
                var participants = room.RoomParticipants?.Select(rp => new
                {
                    Name = rp.User?.Name ?? "Unknown",
                    Online = rp.IsOnline,
                    Avatar = rp.User?.Avatar ?? "👤",
                    Cursor = rp.User?.Cursor ?? "⬤"
                }).ToList();

                var usersJson = System.Text.Json.JsonSerializer.Serialize(participants);
                bool isLongName = room.Name.Length > 20;
                bool isOwner = userId == room.OwnerId;

                <div class="room-card" onclick='openRoomModal("@room.Name", "@room.CreatedAt.ToString("dd.MM.yyyy")", "@room.MaxParticipants", @Html.Raw(usersJson), @room.Id, @isOwner.ToString().ToLower())'>
                    <div class="preview">
                        @(string.IsNullOrEmpty(room.PreviewCode) ? "// код не загружен" : room.PreviewCode)
                    </div>
                    <div class="card-content">
                        @if (isLongName)
                        {
                            <h4><span class="marquee">@room.Name</span></h4>
                        }
                        else
                        {
                            <h4>@room.Name</h4>
                        }
                        <button class="enter-button" onclick='event.stopPropagation(); openRoomModal("@room.Name", "@room.CreatedAt.ToString("dd.MM.yyyy")", "@room.MaxParticipants", @Html.Raw(usersJson), @room.Id, @isOwner.ToString().ToLower())'>Подробнее</button>
                    </div>
                </div>
            }
        }
    </div>
</div>

<style>
    @@keyframes blink {
        0%, 50% { opacity: 1; }
        51%, 100% { opacity: 0; }
    }

    .modal-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 10px;
        width: 100%;
        margin-bottom: 15px;
    }

    #roomName {
        word-wrap: break-word;
        overflow-wrap: break-word;
        white-space: normal;
        word-break: break-word;
        max-width: calc(100% - 40px);
        font-size: 1.2rem;
        line-height: 1.3;
        margin: 0;
    }

    .delete-icon {
        color: #a0a0a0;
        font-size: 1.2rem;
        cursor: pointer;
        transition: 0.2s;
        background: none;
        border: none;
        padding: 0;
        flex-shrink: 0;
    }

    .delete-icon:hover {
        color: #ff8888;
        transform: scale(1.1);
    }

    .modal-actions {
        display: flex;
        flex-direction: column;
        gap: 10px;
        margin-top: 20px;
        width: 100%;
    }

    .modal-actions button {
        width: 100%;
        padding: 10px;
        border-radius: 8px;
        cursor: pointer;
    }
</style>

<div id="roomInfoModal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background-color: rgba(0,0,0,0.8); z-index: 2000; align-items: center; justify-content: center;">
    <div style="background-color: #121628; border-radius: 20px; padding: 30px; width: 600px; border: 1px solid #00aaff; box-shadow: 0 0 30px #00aaff; display: flex; gap: 30px;">
        <div style="flex: 1;">
            <h4 style="color: white;">Участники</h4>
            <div id="participantList" style="color: white;"></div>
        </div>
        <div style="flex: 1; display: flex; flex-direction: column;">
            <div class="modal-header">
                <h4 id="roomName" style="color: white; margin: 0;"></h4>
                <button id="deleteIconBtn" class="delete-icon" style="display: none;" onclick="confirmDelete()">🗑</button>
            </div>
            <p id="roomDate" style="color: #a0a0a0;"></p>
            <p id="roomParticipants" style="color: #a0a0a0;"></p>
            <div class="modal-actions">
                <button onclick="enterRoomFromModal()" style="background-color: #00aaff; color: #0a0e1c; border: none;">Войти в комнату</button>
                <button onclick="closeRoomModal()" style="background-color: #1e1e3a; color: white; border: none;">Закрыть</button>
            </div>
        </div>
    </div>
</div>

<script>
    let currentRoomId = 0;
    let currentIsOwner = false;

    function openRoomModal(name, date, participants, users, roomId, isOwner) {
    currentRoomId = roomId;
    currentIsOwner = isOwner;
    document.getElementById('roomName').innerText = name;
    document.getElementById('roomDate').innerText = 'Создана: ' + date;
    document.getElementById('roomParticipants').innerText = 'Участников: ' + participants;

    const deleteIcon = document.getElementById('deleteIconBtn');
    deleteIcon.style.display = isOwner ? 'block' : 'none';

    let listHtml = '';
    if (users && users.length) {
        users.forEach(user => {
            let userName = user.name || user.userName || 'Unknown';
            let userAvatar = user.avatar || '👤';
            
            let avatarHtml = '';
            if (userAvatar && userAvatar.startsWith('/uploads/')) {
                avatarHtml = `<img src="${userAvatar}" style="width:24px;height:24px;border-radius:50%;object-fit:cover;margin-right:8px;">`;
            } else {
                avatarHtml = `<span style="margin-right:8px;">${userAvatar}</span>`;
            }

            listHtml += `<div style="display: flex; align-items: center; gap: 8px; margin-bottom: 8px;">
                ${avatarHtml}
                <span>${userName}</span>
                <span style="margin-left: auto;">${user.cursor || '⬤'}</span>
                <span style="width: 8px; height: 8px; border-radius: 50%; background-color: ${user.online ? '#00ff00' : '#888'};"></span>
            </div>`;
        });
    } else {
        listHtml = '<div style="color: #a0a0a0;">Нет участников</div>';
    }
    document.getElementById('participantList').innerHTML = listHtml;

    document.getElementById('roomInfoModal').style.display = 'flex';
}

    function closeRoomModal() {
        document.getElementById('roomInfoModal').style.display = 'none';
    }

    function enterRoomFromModal() {
        if (currentRoomId) {
            window.location.href = '/room/' + currentRoomId;
        }
    }

    function confirmDelete() {
        showConfirmModal(
            'Удаление комнаты',
            'Вы уверены, что хотите удалить эту комнату? Это действие необратимо.',
            () => {
                showConfirmModal(
                    'Последнее подтверждение',
                    'Удалить комнату навсегда?',
                    () => deleteRoom(currentRoomId),
                    'Да, удалить',
                    'Отмена'
                );
            },
            'Удалить',
            'Отмена'
        );
    }

    function showConfirmModal(title, message, onConfirm, confirmText = 'Удалить', cancelText = 'Отмена') {
        const modalHtml = `
            <div id="customConfirmModal" style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(1, 6, 13, 0.9); backdrop-filter: blur(8px); z-index: 10000; display: flex; align-items: center; justify-content: center;">
                <div style="background: rgba(18, 22, 40, 0.9); border-radius: 24px; border: 1px solid #00aaff; box-shadow: 0 0 30px #00aaff; padding: 30px; width: 400px; text-align: center; backdrop-filter: blur(12px);">
                    <h3 style="color: #00aaff; margin-bottom: 15px;">${title}</h3>
                    <p style="color: #e0e0e0; margin-bottom: 25px;">${message}</p>
                    <div style="display: flex; gap: 15px; justify-content: center;">
                        <button id="confirmCancelBtn" style="background: #1e1e3a; color: white; border: none; border-radius: 30px; padding: 10px 20px; cursor: pointer; transition: 0.2s;">${cancelText}</button>
                        <button id="confirmOkBtn" style="background: #00aaff; color: #0a0e1c; border: none; border-radius: 30px; padding: 10px 20px; cursor: pointer; transition: 0.2s;">${confirmText}</button>
                    </div>
                </div>
            </div>
        `;
        document.body.insertAdjacentHTML('beforeend', modalHtml);
        const modal = document.getElementById('customConfirmModal');
        const okBtn = document.getElementById('confirmOkBtn');
        const cancelBtn = document.getElementById('confirmCancelBtn');
        okBtn.onclick = () => { modal.remove(); onConfirm(); };
        cancelBtn.onclick = () => modal.remove();
    }

    function deleteRoom(roomId) {
        if (confirm('Удалить комнату?')) {
            window.location.href = '/DeleteRoom?id=' + roomId;
        }
    }

    // ========== СОЗДАНИЕ КОМНАТЫ ==========
    function openCreateRoomModal() {
        window.location.href = '/CreateRoomPage';
    }
</script>